@inherits LayoutComponentBase

@using LimsUtils.Utility;
@using LimsFrontEnd.Utils;
@inject AuthenticationStateProvider AuthProvider
@using System.Security.Claims
@inject NavigationManager NavigationManager
@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<style>
    .dropdown-menu {
        position: absolute;
        top: 100%; /* Position below the trigger */
        right: 0;
        background: white;
        border: 1px solid #ccc;
        padding: 8px;
        z-index: 1000;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }
</style>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 navbar">
            
            @* <a class="profile" @onclick="ToggleDropdown">
                <center><img src="./profile.png" alt="Profile"></center>
                <figcaption>@identifiant</figcaption>
            </a>

            @if (isOpen)
            {
                <div class="dropdown-menu">
                    <MudButton Color="Color.Error" OnClick="Logout">Logout</MudButton>
                </div>
            } *@
            <div>
                <a class="profile" @onclick="ToggleDropdown">
                    <center><img src="./profile.png" alt="Profile" /></center>
                    <center><figcaption>@identifiant</figcaption></center>
                </a>

                <MudPopover Open="@isOpen"
                            AnchorOrigin="Origin.BottomCenter"
                            TransformOrigin="Origin.TopCenter"
                            CloseOnOutsideClick="true"
                            Class="px-4 py-2">
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="Logout">
                        Logout
                    </MudButton>
                </MudPopover>
            </div>

        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private string? identifiant;
    private bool isOpen = false;

    private void ToggleDropdown()
    {
        Console.WriteLine("ToggleDropdown called");
        isOpen = !isOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if(authState.User.Identity.IsAuthenticated)
        {
            identifiant = authState.User.FindFirst("identifiant")?.Value;
        } else
        {
            identifiant = "Non connecté";
        }
    }

    private async Task Logout()
    {
        if (AuthProvider is AuthStateProvider customProvider)
        {
            await customProvider.MarkUserAsLoggedOut();
            Console.WriteLine("User marked as logged out");
        }
        Console.WriteLine("User logged out");
        NavigationManager.NavigateTo($"/login");
    }
}

<script>
    var marginTop = false;
    function marginTopNav(){
        var element = document.querySelector(".top-row");
        var setMarginTopValue = marginTop ? "6rem" : "0"
        element.style.marginTop arguments = setMarginTopValue;
        marginTop = !marginTop;
    }
</script>


