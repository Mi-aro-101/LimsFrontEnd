<nav class="top-row ps-3 top-vertical navbar">
    <div class="container-fluid">
        <div class="homelogo">  
            <a class="navbar-brand" href="#">
                <MudImage Src="logo omnis.png" Width="70" Alt="Logo OMNIS"/>
            </a>
        </div>

        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu" type="button">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</nav>

<MudThemeProvider Theme="MyCustomTheme" />
