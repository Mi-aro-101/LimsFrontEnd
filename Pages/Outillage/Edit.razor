@page "/outillage/edit/{Id:int}"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models.Outillage
@using LimsUtils.Api
@using System.Text.Json

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-dark mb-3">
                <div class="card-header text-center">Modifier l'outillage</div>
                <div class="card-body text-dark">
                    @if (outillage == null)
                    {
                        <p>Chargement...</p>
                    }
                    else
                    {
                        <EditForm Model="@outillage" OnValidSubmit="@HandleOnSubmit">
                            <DataAnnotationsValidator />
                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Désignation</label>
                                <div class="col-sm-9">
                                    <InputText class="form-control" @bind-Value="outillage.Designation" />
                                </div>
                            </div>
                            <br />
                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Marque</label>
                                <div class="col-sm-9">
                                    <InputSelect class="form-control" @bind-Value="outillage.IdMarque">
                                        <option value="">-- Sélectionner --</option>
                                        @foreach (var marque in Marques)
                                        {
                                            <option value="@marque.IdMarque">@marque.Designation</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                            <br />
                            <center>
                                <button type="submit" class="btn btn-primary">Enregistrer</button>
                            </center>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }
    private OutillageDto outillage;
    private ICollection<MarqueDto> Marques = new List<MarqueDto>();
    private string url = "http://localhost:5077/api/outillages";

    protected override async Task OnInitializedAsync()
    {
        Marques = await LoadMarques();
        await LoadOutillage();
    }

    private async Task<ICollection<MarqueDto>> LoadMarques()
    {
        try
        {
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>("http://localhost:5077/api/marque-outillage");
            if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Data != null)
            {
                var jsonData = apiResponse.Data.ToString();
                var marques = JsonSerializer.Deserialize<ICollection<MarqueDto>>(jsonData, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });
                return marques ?? new List<MarqueDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des marques : {ex.Message}");
        }
        return new List<MarqueDto>();
    }

    private async Task LoadOutillage()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse>($"{url}/{Id}");
            if (response != null && response.IsSuccess && response.Data != null)
            {
                outillage = JsonSerializer.Deserialize<OutillageDto>(
                    response.Data.ToString(),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                );
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement de l'outillage : {ex.Message}");
        }
    }

    private async Task HandleOnSubmit()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"{url}/{outillage.IdOutillage}", outillage);
            response.EnsureSuccessStatusCode();
            NavigationManager.NavigateTo("/outillage");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la mise à jour : {ex.Message}");
        }
    }
}