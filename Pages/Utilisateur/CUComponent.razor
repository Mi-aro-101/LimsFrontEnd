@using LimsFrontEnd.Components

@inherits CUUtilisateurBaseComponent

@using LimsFrontEnd.Models

@if(Roles == null  || Utilisateur == null)
    {
        <center><div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Veuillez patienter un moment</p><br/></center>
    }
    else
    {
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Identifiant</label>
            <div class="col-sm-8">
            <InputText class="form-control"  @bind-Value="Utilisateur.Identifiant" placeholder="front1" />
            </div>
        </div>
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Mot de passe</label>
            <div class="col-sm-8">
            <InputText class="form-control" @bind-Value="Utilisateur.Password" placeholder="front1@1234" />
            </div>
        </div>
        <br>
        
        <div class="form-group row">
            <label for="inputRoles" class="col-sm-2 col-form-label">Roles</label>
            <div class="col-sm-8">
                <MudSelect T="string" Label="Roles" MultiSelection="true" @bind-Value="_value" @bind-SelectedValues="Utilisateur.RoleDesignations">
                    @foreach (RoleDto role in Roles)
                    {
                        <MudSelectItem T="string" Value="@role.Designation">@role.Designation</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </div>
        <br>
    }

@code
{
    [Parameter]
    public UtilisateurDto? Utilisateur {get; set;}
    [Parameter]
    public ICollection<RoleDto>? Roles {get; set; }
    private ElementReference roleSelectElement;
    private string _value = "Nothing selected";

    private IEnumerable<string> Options = new HashSet<string> ();

}