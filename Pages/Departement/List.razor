@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsFrontEnd.Utils
@using System.Text.Json;
@inject NavigationManager NavigationManager

<style>
    .bordered-cell-one{
        border-right: none;
        text-align: center;
    }
    .bordered-cell-two{
        border-left: none;
        text-align: center;
    }
</style>

@if (departements == null)
    {
        <p><em>No data on the row</em></p>
    }
    else
    {
        @if (apiResponse.ViewBag.ContainsKey("position") && apiResponse.ViewBag.ContainsKey("TotalCount") && apiResponse.ViewBag.ContainsKey("nbrPerPage"))
        {
            <p>
                Page @apiResponse.ViewBag["position"] sur
                @apiResponse.ViewBag["nbrLinks"]
            </p>

            var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
            var pageSize = int.Parse(apiResponse.ViewBag["nbrPerPage"].ToString());
            var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());

            <table class="table table-bordered" border="1">
                <thead>
                    <tr>
                        <th scope="col">Code</th>
                        <th scope="col">Designation</th>
                        <th scope="col" colspan="2"><center>Actions</center></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var departement in departements)
                    {
                        <tr>
                            <td>@departement.Code</td>
                            <td>@departement.Designation</td>
                            <td class="bordered-cell-one"> 
                                <MudNavLink Icon="@Icons.Material.Filled.Edit" @onclick="@(() => HandleUpdate(@departement.IdDepartement))" IconColor=Color.Warning Title="Favorite"></MudNavLink>
                            </td>
                            <td class="bordered-cell-two">
                                <MudNavLink Icon="@Icons.Material.Filled.DeleteForever" @onclick="@(() => HandleDelete(@departement.IdDepartement))" IconColor=Color.Error Title="Favorite" ></MudNavLink>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <nav aria-label="Page navigation">
                <ul class="pagination">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="/departement" @onclick="@(() => LoadDepartements(currentPage - 1))">Précédent</a>
                    </li>

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="/departement" @onclick="@(() => LoadDepartements(currentPage + 1))">Suivant</a>
                    </li>
                </ul>
            </nav>

        }
        else
        {
            <p>Information sur la pagination indisponible</p>
        }
    }

@code {
    private List<DepartementDto>? departements = new List<DepartementDto>();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 2;
    string url = "http://localhost:5077/api/departement";


    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadDepartements(currentPage);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error on Initializing : {ex.Message}");
        }
    }

    private async Task LoadDepartements(int? activePage)
    {
        if(activePage.HasValue) currentPage = activePage.Value;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+$"?position={currentPage}&pageSize={pageSize}", options);
            Console.WriteLine(url+$"?position={currentPage}&pageSize={pageSize}");
            if(apiResponse.Data != null){
                Console.WriteLine(apiResponse.ViewBag["position"]);
                Console.WriteLine(apiResponse.ViewBag["nbrPerPage"]);
                Console.WriteLine(apiResponse.ViewBag["TotalCount"]);
                apiResponse.HandleResponse<List<DepartementDto>>();
                departements = (List<DepartementDto>)apiResponse.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadDpt: {ex.Message}");
        }
    }

    private async Task HandleDelete(int id)
    {
        
    }

    private async Task HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/departement/{id}");
    }
}