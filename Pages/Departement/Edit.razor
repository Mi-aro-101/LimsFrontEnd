@page "/departement/{Id:int}"

@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json;
@inject NavigationManager NavigationManager

<div class="card border-dark mb-3" style="max-width: 39rem;">
  <div class="card-header">Mettre à jour ce departement</div>
  <div class="card-body text-dark">
    <EditForm Model="@departement" OnValidSubmit="@HandleOnSubmit">
        <div class="form-group row">
            <label for="staticEmail" class="col-sm-2 col-form-label">Code</label>
            <div class="col-sm-8">
            <InputText class="form-control" @bind-Value="departement.Code"/>
            </div>
        </div>
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Designation</label>
            <div class="col-sm-8">
            <InputText class="form-control" @bind-Value="departement.Designation"/>
            </div>
        </div>
        <br>
        <center>
            <button type="submit" class="btn btn-primary">Modifier</button>
        </center>
    </EditForm>
  </div>
</div>

@code
{
    private DepartementDto? departement;
    private string url = "http://localhost:5077/api/departement";
    string message;
    [Parameter]
    public int Id { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await FetchDetails(Id);
    }

    private async Task FetchDetails(int id)
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            ApiResponse? apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+$"/{Id}", options);
            Console.WriteLine(url+$"/{Id}");
            if(apiResponse.Data != null){
                apiResponse.HandleResponse<DepartementDto>();
                departement = (DepartementDto)apiResponse.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadDpt: {ex.Message}");
        }
    }
    private async Task HandleOnSubmit()
    {
        try
        {
            var response = await Http.PutAsJsonAsync(url+$"/{Id}", departement);
            // Optionally handle the response (e.g., show a success message)
            NavigationManager.NavigateTo("/departement"); // Redirect to product list
        }
        catch(Exception ex)
        {
            Console.WriteLine("Exception : " +ex.Message);
        }
    }
}