@page "/formulaireMobile/{id_etat_decompte:int}"

@using System.Text.Json
@using LimsFrontEnd.Models
@using LimsUtils.Api
@inject HttpClient http
@inject NavigationManager navigationManager

<MudItem Class="pa-4">
    <MudText Typo="Typo.h3" GutterBottom="true"> Formulaire de paiement par mobile</MudText>
    <MudForm Model="@mobile" @ref="reference">
        <MudGrid>
            <MudItem xs="12">
                <MudTextField T="string" label="Titre" @bind-Value="mobile.titre" Required="true" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Clients" @bind-Value="mobile.clients" Required="true" Variant="Variant.Text" Margin="Margin.Dense" HelperText="Particulier ou Entreprise" HelperTextOnFocus="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Identité" @bind-Value="mobile.identite" Required="true" Variant="Variant.Text" Margin="Margin.Dense" HelperText="CIN ou NIF/STAT ou Passeport" HelperTextOnFocus="true" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField T="string" Label="Adresse" @bind-Value="mobile.adresse" Required="true" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField T="string" Label="Contact" @bind-Value="mobile.contact" Required="true" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Email" @bind-Value="mobile.email" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Etat de décompte" @bind-Value="mobile.etatDecompte" Required="true" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudDatePicker Label="Date" Date="@SelectedDate" DateChange="OnDateChange" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField T="double" Label="Montant" Required="true" @bind-Value="mobile.montant" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudHidden T="int" @bind-Value="mobile.id_etat_decompte" />
            </MudItem>
            <MudItem xs="12" class="d-flex justify-center">
                <MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" Size="Size.Large" Class="mt-8" OnClick="SubmitPaiementMobile">Continue to Payment</MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudItem>

@code {
    [Parameter] public int id_etat_decompte { get; set; }
    private DateTime SelectedDate { get; set; } = DateTime.Now;
    MudForm? reference;
    private PaiementDto mobile = new PaiementDto();
    private List<PaiementDto>? mobiles;
    private ApiResponse? apiResponse;
    string url = "http://localhost:5077/api/paiementparmobile";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var option = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await http.GetFromJsonAsync<ApiResponse>($"{url}/{id_etat_decompte}", option);
            apiResponse.HandleResponse<List<PaiementDto>>();
            mobiles = apiResponse.Data as List<PaiementDto> ?? new List<PaiementDto>();

            // Initialisez demandeNote
            mobile = mobiles?.FirstOrDefault() ?? new PaiementDto
                {
                    id_etat_decompte = id_etat_decompte
                };
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception levé ici: " + ex.Message);
        }
    }

    private void OnDateChanged(DateTime newDate)
    {
        SelectedDate = newDate;
    }

    private async Task SubmitPaiementMobile()
    {
        try
        {
            if (mobile == null)
            {
                Console.WriteLine("demandeNote est null");
                return;
            }

            var nouvellePaiementMobile = new PaiementDto
            {
                DatePaiement = SelectedDate,
                ModePaiement = 2,
                EtatPaiement = 12,
                id_etat_decompte = mobile.id_etat_decompte
            };

            var response = await http.PostAsJsonAsync(url, nouvellePaiementMobile);

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine("Erreur de l'API: " + errorContent);
            }
            else
            {
                navigationManager.NavigateTo("/receptionMobile");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception: " + ex.Message);
        }
    }
}
