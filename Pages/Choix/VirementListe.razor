@page "/VirementBancaire/Liste"

@using LimsUtils.Api
@using System.Text.Json
@inject HttpClient http
@using LimsFrontEnd.Models
@inject NavigationManager navigationManager

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5" Class="mb-4">Liste des virements en attente</MudText>

    <MudTextField @bind-Value="searchText" Label="Recherche" Placeholder="Etat de décompte ou clients" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" />

    <MudTable Items="FilteredData" Dense="true" RowsPerPage="10" Hover="true" FixedHeader="true" Height="300px">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Virement à payer</MudText>
        </ToolBarContent>

        <HeaderContent>
            <MudTh> N°</MudTh>
            <MudTh> Nom du client </MudTh>
            <MudTh> Réference de l'état de décompte </MudTh>
            <MudTh> Date du paiement </MudTh>
            <MudTh> Montant (Ar) </MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd> @context.id_etat_decompte </MudTd>
            <MudTd> @context.clients </MudTd>
            <MudTd> @context.etatDecompte </MudTd>
            <MudTd> @(context.DatePaiement.ToString("dd MMM yyyy") ?? "N/A") </MudTd>
            <MudTd> @context.montant </MudTd>
            <MudTd>
                @if (virementListe == context)
                {
                    <MudButton Color="Color.Success" OnClick="@(() => SaveRow(context.id_etat_decompte))">
                        Payer maintenant
                    </MudButton>                
                    <MudButton Color="Color.Error" OnClick="CancelEdit">Annuler</MudButton>
                }
                else
                {
                    <MudButton Color="Color.Primary" OnClick="@(() => EditRow(context))">Action</MudButton>
                }
            </MudTd>            
        </RowTemplate>
    </MudTable>

    <MudPaper Class="pa-3 mt-4" Elevation="4">
        <MudText Typo="Typo.h6">Arrêté à la somme de : <b>@FilteredData.Sum(x => x.montant).ToString("F2") Ar</b></MudText>
    </MudPaper>
</MudPaper>

@code {
    private string searchText = "";

    private PaiementDto? virementListe;
    private List<PaiementDto> virementListes = new List<PaiementDto>();
    private ApiResponse? apiResponse;
    //string url = "http://localhost:5077/api/paiementparvirement";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var option = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await http.GetFromJsonAsync<ApiResponse>($"paiementparvirement/ListeVirement", option);
            if (apiResponse != null)
            {
                apiResponse.HandleResponse<List<PaiementDto>>();
            }
            virementListes = apiResponse?.Data as List<PaiementDto> ?? new List<PaiementDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception: " + ex.Message);
        }
    }

    private List<PaiementDto> FilteredData
    {
        get
        {
            var result = virementListes
            .Where(x => string.IsNullOrWhiteSpace(searchText)
                || x.etatDecompte.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || x.clients.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            ).ToList();
            return result;
        }
    }

    private void EditRow(PaiementDto virement)
    {
        virementListe = virement;
    }

    private async Task SaveRow(int id)
    {
        navigationManager.NavigateTo($"/receptionVirement/{id}");
    }

    private void CancelEdit()
    {
       virementListe = null; // Annuler l'édition
    }
}