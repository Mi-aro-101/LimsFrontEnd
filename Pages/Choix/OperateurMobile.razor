<MudItem Class="pa-6">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6 font-semibold text-primary">
        Choisissez votre opérateur de paiement
    </MudText>

    <MudGrid Gutter="true" Justify="Justify.Center">

        <!-- Carte opérateur MVola -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="hover:scale-105 transition-transform duration-300 cursor-pointer" Style="text-align: center;">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-2">MVola</MudText>
                    <MudLink href="@($"formulaireMobile/Yas/{id_etat_decompte}")" Style="text-decoration: none;">
                        <MudImage Src="img/Mvola.png" Alt="Logo MVola" Style="width: 120px; height: 120px; margin: auto;" />
                    </MudLink>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Carte opérateur Airtel -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="hover:scale-105 transition-transform duration-300 cursor-pointer" Style="text-align: center;">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-2">Airtel</MudText>
                    <MudLink href="@($"formulaireMobile/Airtel/{id_etat_decompte}")" Style="text-decoration: none;">
                        <MudImage Src="img/Airtel.png" Alt="Logo Airtel" Style="width: 120px; height: 120px; margin: auto;" />
                    </MudLink>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Carte opérateur Orange Money -->
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="hover:scale-105 transition-transform duration-300 cursor-pointer" Style="text-align: center;">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-2">Orange Money</MudText>
                    <MudLink href="@($"formulaireMobile/Orange/{id_etat_decompte}")" Style="text-decoration: none;">
                        <MudImage Src="img/Orange_money.png" Alt="Logo Orange Money" Style="width: 120px; height: 120px; margin: auto;" />
                    </MudLink>
                </MudCardContent>
            </MudCard>
        </MudItem>

    </MudGrid>
</MudItem>

@code {
    [Parameter]
    public int id_etat_decompte { get; set; }
}
