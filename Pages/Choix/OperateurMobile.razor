@page "/choixoperateur/{id_etat_decompte:int}"



<MudItem>
    <MudText Typo="Typo.h3" GutterBottom="true"> Choix de l'opérateur </MudText>
    <MudGrid Gutter="true">
        <!-- Opérateur Telma -->
        <MudItem xs="4" sm="4" md="4" lg="4" xl="4"  Style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
            <MudText Typo="Typo.subtitle1" Align="Align.Center">Mvola</MudText>
            <MudLink class="nav-link" href="@($"formulaireMobile/{id_etat_decompte}")" Style="text-decoration: none;">
                <MudImage Src="img/Mvola.png" Alt="logo Mvola" Style="width: 150px; height: 150px; margin-bottom: 8px; margin-left: 12px;" />
            </MudLink>
        </MudItem>

        <!-- Opérateur airtel 
        <MudItem xs="4" sm="4" md="4" lg="4" xl="4"  Style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
            <MudText Typo="Typo.subtitle1" Align="Align.Center">Airtel</MudText>
            <MudLink class="nav-link" href="#" Style="text-decoration: none;">
                <MudImage Src="img/airtel.png" Alt="logo Airtel" Style="width: 150px; height: 150px; margin-bottom: 8px; margin-left: 12px;" />
            </MudLink>
        </MudItem> -->

        <!-- Opérateur orange -->
        <MudItem xs="4" sm="4" md="4" lg="4" xl="4"  Style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
            <MudText Typo="Typo.subtitle1" Align="Align.Center">Orange money</MudText>
            <MudLink class="nav-link" href="@($"formulaireMobile/{id_etat_decompte}")" Style="text-decoration: none;">
