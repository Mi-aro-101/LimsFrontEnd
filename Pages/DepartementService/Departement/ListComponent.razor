@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json;
@using Microsoft.JSInterop;
@inject NavigationManager NavigationManager

<style>
    .bordered-cell-one{
        border-right: none;
        text-align: center;
    }
    .bordered-cell-two{
        border-left: none;
        text-align: center;
    }
</style>
<div class="col">
    <CreateComponent/>
</div>

 @if(!(string.IsNullOrEmpty(exception)))
    {
        <div class="error">
            @exception
        </div>
    }

<div class="col">
    @if (departements == null)
    {
        <p><em>No data on the row</em></p>
    }
    else
    {
        @if (apiResponse != null && apiResponse.ViewBag != null &&
            apiResponse.ViewBag.ContainsKey("position") &&
            apiResponse.ViewBag.ContainsKey("TotalCount") &&
            apiResponse.ViewBag.ContainsKey("nbrPerPage"))
        {

            var currentPage = int.Parse(apiResponse!.ViewBag["position"]!.ToString());
            var pageSize = int.Parse(apiResponse!.ViewBag["nbrPerPage"]!.ToString());
            var totalPages = int.Parse(apiResponse!.ViewBag["nbrLinks"]!.ToString());

            <table class="table table-bordered" border="1">
                <thead>
                    <tr>
                        <th scope="col">Code</th>
                        <th scope="col">Désignation</th>
                        <th scope="col" colspan="2"><center>Actions</center></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var departement in departements)
                    {
                        <tr>
                            <td>@departement.Code</td>
                            <td>@departement.Designation</td>
                            <td class="bordered-cell-one">
                                <MudButton Size="Size.Small" @onclick="@(() => HandleUpdate(@departement.IdDepartement))" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" Color="Color.Warning"></MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <nav aria-label="Page navigation">
                <ul class="pagination">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="/departement" @onclick="@(() => LoadDepartements(currentPage - 1))">Précédent</a>
                    </li>

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="/departement" @onclick="@(() => LoadDepartements(currentPage + 1))">Suivant</a>
                    </li>
                </ul>
            </nav>

            <center><p>
                Page @apiResponse.ViewBag["position"] sur
                @apiResponse.ViewBag["nbrLinks"]
            </p></center>
        }
        else
        {
            <p>Information sur la pagination indisponible</p>
        }
    }
</div>

@code {
    private List<DepartementDto>? departements = new List<DepartementDto>();
    private ApiResponse apiResponse;
    private int currentPage = 1;
    private int pageSize = 2;
    string url = "http://localhost:5077/api/departement";
    [Inject] IJSRuntime? JSRuntime { get; set; }
    private string? exception;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadDepartements(currentPage);
        }
        catch (Exception ex)
        {
            exception = ex.Message;
            StateHasChanged();
        }
    }

    private async Task LoadDepartements(int? activePage)
    {
        if(activePage.HasValue) currentPage = activePage.Value;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+$"?position={currentPage}&pageSize={pageSize}", options);
            if(currentPage <= int.Parse(apiResponse!.ViewBag["nbrLinks"]!.ToString())){
                apiResponse.HandleResponse<List<DepartementDto>>();
                departements = (List<DepartementDto>)apiResponse!.Data;
            }
            else{
                await LoadDepartements(int.Parse(apiResponse!.ViewBag["nbrLinks"]!.ToString()));
            }
        }
        catch (Exception ex)
        {
            throw ex;
        }
    }

    private void HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/departement/{id}");
    }
}