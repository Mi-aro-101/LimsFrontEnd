@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Reactif
@using LimsUtils.Api
@using System.Collections.Generic
@using System.Linq
@using MudBlazor


<div class="row">
    <!-- Colonne de création -->
    <div class="col">
        <Create OnTypeSortieCreated="HandleTypeSortieCreated" />
    </div>

    <!-- Colonne de la liste -->
    <div class="col">
        @if (typesSortie == null || !typesSortie.Any())
        {
            <p><em>Aucun type de sortie disponible</em></p>
        }
        else
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Désignation</th>
                        <th scope="col"><center>Actions</center></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ts in typesSortie.OrderBy(t => t.IdTypeSortie))
                    {
                        <tr>
                            <td>@ts.IdTypeSortie</td>
                            <td>@ts.Designation</td>
                            <td>
                                <center>

                                    <button class="btn btn-warning btn-sm" @onclick="() => HandleUpdate(ts.IdTypeSortie)">
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" />
                                    </button>

                                </center>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<TypeSortieDto> typesSortie = new();
    private string url = "http://localhost:5077/api/typesSortie";

    protected override async Task OnInitializedAsync()
    {
        await LoadTypesSortie();
    }

    private async Task LoadTypesSortie()
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url, options);
            if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Data != null)
            {
                typesSortie = JsonSerializer.Deserialize<List<TypeSortieDto>>(
                    apiResponse.Data.ToString(),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new List<TypeSortieDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement : {ex.Message}");
        }
    }

    private async Task HandleTypeSortieCreated()
    {
        await LoadTypesSortie();
    }

    private void HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/typesSortie/edit/{id}");
    }
}