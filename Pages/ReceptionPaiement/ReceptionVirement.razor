@page "/receptionVirement/{id_etat_decompte:int}"


@using LimsUtils.Api
@using System.Text.Json
@inject HttpClient http
@using LimsFrontEnd.Models
@inject NavigationManager navigationManager


<MudItem xs="7">
    <MudText Typo="Typo.h5" GutterBottom="true">Réception de l'argent par virement</MudText>
    <MudForm Model="@recue" @ref="form">
        <MudGrid>
            <MudItem xs="12">
                <MudTextField T="string" Label="Etat de décompte" @bind-Value="recue.referenceEtatDecompte" Variant="Variant.Text" Margin="Margin.Dense" Disabled="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="double" Label="Montant à payer" @bind-Value="recue.montantApayer" Variant="Variant.Text" Margin="Margin.Dense" Disabled="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Réference de l'ordre de virement" @bind-Value="recue.referenceOV" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                @* <MudTextField T="string" Label="La banque" @bind-Value="recue.banque" Variant="Variant.Text" Margin="Margin.Dense" /> *@
                <MudSelect T="int" Label="Banque" @bind-Value="banque.id_banque" Required="true">
                    <MudSelectItem T="int">Sélectionner un destinataire</MudSelectItem>
                    @if (banques != null)
                    {
                        @foreach (var b in banques)
                        {
                            <MudSelectItem Value="b.id_banque">@b.designation</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudHidden T="int" @bind-Value="recue.id_paiement" />
            </MudItem>
            <MudItem xs="12" Class="d-flex justify-center">
                <MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" Size="Size.Large" Class="mt-8" OnClick="RecepetionParVirement">Payé</MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudItem>


@code {
    private MudForm? form;
    private RecuDto recue = new RecuDto();
    [Parameter] public int id_etat_decompte { get; set; }
    private BanqueDto banque = new ();

    private ApiResponse? apiResponse;
    private ApiResponse? apiResponse2;
    //string url = "http://localhost:5077/api/receptionpaiementvirement";
    private List<BanqueDto> banques = new ();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var option = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            string uri = $"receptionpaiementvirement/Confirmer/{id_etat_decompte}";
            string uri2 = $"receptionpaiementvirement/listeBanque";

            apiResponse = await http.GetFromJsonAsync<ApiResponse>(uri, option);
            apiResponse.HandleResponse<RecuDto>();
            recue = apiResponse.Data as RecuDto ?? new RecuDto();

            apiResponse2 = await http.GetFromJsonAsync<ApiResponse>(uri2, option);
            apiResponse2.HandleResponse<List<BanqueDto>>();
            banques = apiResponse2.Data as List<BanqueDto> ?? new List<BanqueDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception levé ici: " + ex.Message);
        }
    }

    private async Task RecepetionParVirement()
    {
        try
        {
            if (recue == null)
            {
                Console.WriteLine("la réception mobile est null");
                return;
            }

            var recuPaiementVirement = new RecuDto
            {
                referenceOV = recue.referenceOV,
                id_banque = banque.id_banque,
                id_paiement = recue.id_paiement
            };

            var response = await http.PostAsJsonAsync("receptionpaiementvirement", recuPaiementVirement);

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine("Erreur de l'API: " + errorContent);
            }
            else
            {
                navigationManager.NavigateTo("/demandenotedebit/demande");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception: " + ex.Message);
        }
    }
}