@page "/employe/{Id:int}"

@inherits CUComponent

@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsFrontEnd.Utils
@using System.Text.Json;
@inject NavigationManager NavigationManager

<div class="card border-dark mb-3" style="max-width: 45rem;">
  <div class="card-header">Mettre à jour ce(tte) employé(e)</div>
  <div class="card-body text-dark">
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-success">@message</div>
        }
        @* //TODO IdDepartement and IdPoste do not change in database but change on submit *@
    <EditForm Model="@employe" OnValidSubmit="@HandleOnSubmit">
        <CUComponent Employe="@employe" />
        <center>
            <button type="submit" class="btn btn-primary">Mettre à jour</button>
        </center>
    </EditForm>
  </div>
</div>

@code
{
    private EmployeDto? employe;
    private string url = "http://localhost:5077/api/employe";
    string? message;
    [Parameter]
    public int Id { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await FetchDetails(Id);
    }

    private async Task FetchDetails(int id)
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            Console.WriteLine("Coucou la comp");
            ApiResponse? apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+$"/{Id}", options);
            Console.WriteLine(url+$"/{Id}");
            if(apiResponse.Data != null){
                apiResponse.HandleResponse<EmployeDto>();
                employe = (EmployeDto)apiResponse.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while fetching details of the emp: {ex.Message}");
        }
    }
    private async Task HandleOnSubmit()
    {
        try
        {
            employe.Departement = null;
            employe.Poste = null;
            var response = await Http.PutAsJsonAsync(url+$"/{Id}", employe);
            Console.WriteLine(JsonSerializer.Serialize(employe));
            // Optionally handle the response (e.g., show a success message)
            NavigationManager.NavigateTo("/employe"); // Redirect to product list
        }
        catch(Exception ex)
        {
            Console.WriteLine("Exception : " +ex.Message);
        }
    }
}