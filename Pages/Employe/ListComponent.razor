@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsFrontEnd.Utils
@using System.Text.Json;
@inject NavigationManager NavigationManager
@using Microsoft.JSInterop




<style>
    .bordered-cell-one{
        border-right: none;
        text-align: center;
    }
    .bordered-cell-two{
        border-left: none;
        text-align: center;
    }
    tr:hover{
        cursor: pointer;
    }
</style>
    @if(employes.Count == 0)
    {
        <center><div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Veuillez patienter un moment</p><br/></center>
    }
    else
    {
        @if (apiResponse.ViewBag.ContainsKey("position") && apiResponse.ViewBag.ContainsKey("TotalCount") && apiResponse.ViewBag.ContainsKey("nbrPerPage"))
        {

            var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
            var pageSize = int.Parse(apiResponse.ViewBag["nbrPerPage"].ToString());
            var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());

            <table class="table table-bordered table-hover" border="1">
                <thead>
                    <tr>
                        <th scope="col">Matricule</th>
                        <th scope="col">Nom</th>
                        <th scope="col">Genre</th>
                        <th scope="col">Departement</th>
                        <th scope="col">Poste</th>
                        <th scope="col">CIN</th>
                        <th scope="col">Contact</th>
                        <th scope="col">Adresse</th>
                        <th scope="col"><center>Action</center></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employe in employes)
                    {
                            <tr @onclick="@(() => NavigateToEmploye(@employe.IdEmploye))">
                                <td>@employe.Matricule</td>
                                <td>@employe.Nom @employe.Prenom</td>
                                <td>@employe.GetGenre()</td>
                                <td>@employe.GetDepartementDesignation()</td>
                                <td>@employe.Poste.Designation</td>
                                <td>@employe.Cin</td>
                                <td>@employe.Contact</td>
                                <td>@employe.Adresse</td>
                                <td class="bordered-cell-one">
                                    <MudButton Size="Size.Small" @onclick="@(() => HandleUpdate(@employe.IdEmploye))" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" Color="Color.Warning"></MudButton>
                                </td>
                            </tr>
                    }
                </tbody>
            </table>

            <nav aria-label="Page navigation">
                <ul class="pagination">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="/employe" @onclick="@(() => LoadEmployes(currentPage - 1))">Précédent</a>
                    </li>

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="/employe" @onclick="@(() => LoadEmployes(currentPage + 1))">Suivant</a>
                    </li>
                </ul>
            </nav>

            <center><p>
                Page @apiResponse.ViewBag["position"] sur
                @apiResponse.ViewBag["nbrLinks"]
            </p></center>
        }
        else
        {
            <p>Information sur la pagination indisponible</p>
        }
    }

@code {
    private List<EmployeDto>? employes = new List<EmployeDto>();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 5;
    string url = "http://localhost:5077/api/employe";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadEmployes(currentPage);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error on Initializing : {ex.Message}");
        }
    }

    private async Task LoadEmployes(int? activePage)
    {
        if(activePage.HasValue) currentPage = activePage.Value;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+$"?position={currentPage}&pageSize={this.pageSize}", options);
            if(currentPage <= int.Parse(apiResponse.ViewBag["nbrLinks"].ToString())){
                apiResponse.HandleResponse<List<EmployeDto>>();
                employes = (List<EmployeDto>)apiResponse.Data;
            }
            else{
                await LoadEmployes(int.Parse(apiResponse.ViewBag["nbrLinks"].ToString()));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadEmploye {ex.Message}");
        }
    }

    private async Task HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/employe/{id}");
    }

    private async Task NavigateToEmploye(int id)
    {
        NavigationManager.NavigateTo($"/employe/details/{id}");
    }
}