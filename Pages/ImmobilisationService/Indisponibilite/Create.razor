@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models.Immobilisation
@using LimsUtils.Api
@using System.Text.Json
@using System.ComponentModel.DataAnnotations
@using System.Linq

<style>
    .form-group {
        margin-bottom: 1.5rem;
    }
    .form-group label {
        display: block;
        font-weight: bold;
        margin-bottom: 0.5rem;
    }
    .form-control {
        width: 100%;
        max-width: 500px; /* Limite la largeur des champs pour une meilleure lisibilité */
    }
    .validation-message {
        color: red;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }
</style>

<div class="card border-dark mb-3" style="max-width: 39rem;">
    <div class="card-header">Créer une Indisponibilité</div>
    <div class="card-body text-dark">
        <EditForm Model="@indisponibilite" OnValidSubmit="@HandleOnSubmit">
            <DataAnnotationsValidator />
            <div class="form-group">
                <label>Date Début</label>
                <input class="form-control" type="date" value="@indisponibilite.DateDebut.ToString("yyyy-MM-dd")" readonly />
                <ValidationMessage For="@(() => indisponibilite.DateDebut)" class="validation-message" />
            </div>
            <div class="form-group">
                <label>Date Fin</label>
                <InputDate class="form-control" @bind-Value="indisponibilite.DateFin" />
                <ValidationMessage For="@(() => indisponibilite.DateFin)" class="validation-message" />
            </div>
            <div class="form-group">
                <label>Immobilisation Immatriculée</label>
                <InputSelect class="form-control" @bind-Value="indisponibilite.IdImmobilisationPropre">
                    <option value="">-- Sélectionner --</option>
                    @foreach (var imm in immobilisationsImmatriculees)
                    {
                        <option value="@imm.IdImmobilisationPropre">@imm.EntreeImmobilisation?.Immobilisation?.Designation - @imm.Matricule</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => indisponibilite.IdImmobilisationPropre)" class="validation-message" />
            </div>
            <div class="form-group">
                <label>Objet d'Indisponibilité</label>
                <InputSelect class="form-control" @bind-Value="indisponibilite.IdObjetIndisponibilite">
                    <option value="">-- Sélectionner --</option>
                    @foreach (var obj in objetsIndisponibilite)
                    {
                        <option value="@obj.IdObjetIndisponibilite">@obj.Designation</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => indisponibilite.IdObjetIndisponibilite)" class="validation-message" />
            </div>
            <center>
                <button type="submit" class="btn btn-primary">Créer</button>
            </center>
        </EditForm>
    </div>
</div>

@code {
    private IndisponibiliteDto indisponibilite = new();
    private ICollection<ImmobilisationImmatriculationDto> immobilisationsImmatriculees = new List<ImmobilisationImmatriculationDto>();
    private ICollection<ObjetIndisponibiliteDto> objetsIndisponibilite = new List<ObjetIndisponibiliteDto>();
    private string url = "http://localhost:5077/api/indisponibilites";

    [Parameter]
    public EventCallback OnIndisponibiliteCreated { get; set; }

    protected override async Task OnInitializedAsync()
    {
        indisponibilite.DateDebut = DateTime.Today; // DateDebut fixée à aujourd'hui
        indisponibilite.DateFin = DateTime.Today; // DateFin fixée à aujourd'hui par défaut
        immobilisationsImmatriculees = await LoadImmobilisationsImmatriculees();
        objetsIndisponibilite = await LoadObjetsIndisponibilite();
    }

    private async Task<ICollection<ImmobilisationImmatriculationDto>> LoadImmobilisationsImmatriculees()
    {
        try
        {
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>("http://localhost:5077/api/indisponibilites/available-immobilisations");
            if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Data != null)
            {
                var jsonData = apiResponse.Data.ToString();
                var immobilisations = JsonSerializer.Deserialize<ICollection<ImmobilisationImmatriculationDto>>(jsonData, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new List<ImmobilisationImmatriculationDto>();

                // Tri alphabétique par Designation, puis par Matricule
                return immobilisations
                    .OrderBy(imm => imm.EntreeImmobilisation?.Immobilisation?.Designation ?? string.Empty)
                    .ThenBy(imm => imm.Matricule ?? string.Empty)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des immobilisations immatriculées disponibles : {ex.Message}");
        }
        return new List<ImmobilisationImmatriculationDto>();
    }

    private async Task<ICollection<ObjetIndisponibiliteDto>> LoadObjetsIndisponibilite()
    {
        try
        {
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>("http://localhost:5077/api/objets-indisponibilite");
            if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Data != null)
            {
                var jsonData = apiResponse.Data.ToString();
                return JsonSerializer.Deserialize<ICollection<ObjetIndisponibiliteDto>>(jsonData, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new List<ObjetIndisponibiliteDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des objets d'indisponibilité : {ex.Message}");
        }
        return new List<ObjetIndisponibiliteDto>();
    }

    private async Task HandleOnSubmit()
    {
        // Validation : tous les champs doivent être remplis (DateDebut est toujours aujourd'hui, donc pas besoin de vérifier default)
        if (indisponibilite.DateFin == default || 
            indisponibilite.IdImmobilisationPropre == 0 || indisponibilite.IdObjetIndisponibilite == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Tous les champs doivent être remplis.");
            return;
        }

        // Validation : DateFin > DateDebut
        if (indisponibilite.DateFin <= indisponibilite.DateDebut)
        {
            await JSRuntime.InvokeVoidAsync("alert", "La date de fin doit être supérieure à la date de début.");
            return;
        }

        // Pop-up de confirmation
        var confirmation = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"Voulez-vous vraiment créer cette indisponibilité ?\n" +
            $"Date Début: {indisponibilite.DateDebut.ToShortDateString()}\n" +
            $"Date Fin: {indisponibilite.DateFin.ToShortDateString()}\n" +
            $"Immobilisation: {immobilisationsImmatriculees.FirstOrDefault(i => i.IdImmobilisationPropre == indisponibilite.IdImmobilisationPropre)?.EntreeImmobilisation?.Immobilisation?.Designation} - " +
            $"{immobilisationsImmatriculees.FirstOrDefault(i => i.IdImmobilisationPropre == indisponibilite.IdImmobilisationPropre)?.Matricule}\n" +
            $"Objet: {objetsIndisponibilite.FirstOrDefault(o => o.IdObjetIndisponibilite == indisponibilite.IdObjetIndisponibilite)?.Designation}\n" +
            "Les informations ne pourront plus être modifiées ni supprimées après création."
        );

        if (!confirmation)
        {
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync(url, indisponibilite);
            response.EnsureSuccessStatusCode();
            if (OnIndisponibiliteCreated.HasDelegate)
                await OnIndisponibiliteCreated.InvokeAsync();
            else
                Console.WriteLine("Aucun delegate assigné à l'événement OnIndisponibiliteCreated");

            // Recharger la liste des immobilisations disponibles
            immobilisationsImmatriculees = await LoadImmobilisationsImmatriculees();

            // Réinitialiser le formulaire
            indisponibilite = new IndisponibiliteDto { DateDebut = DateTime.Today, DateFin = DateTime.Today };
            StateHasChanged(); // Notifier Blazor de mettre à jour l'UI
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception : " + ex.Message);
        }
    }
}