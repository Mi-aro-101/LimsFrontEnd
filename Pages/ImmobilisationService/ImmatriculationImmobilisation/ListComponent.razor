
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Immobilisation
@using LimsUtils.Api
@using System.Linq

<div class="container">
    <!-- Formulaire de création intégré -->
    <Create OnImmatriculationCreated="HandleImmatriculationCreated" />

    <!-- Liste des immatriculations en dessous -->
    <div class="mt-4">
        <h3>Liste des Immatriculations</h3>
        @if (immobilisationImmatriculations == null)
        {
            <p><em>Chargement...</em></p>
        }
        else if (!immobilisationImmatriculations.Any())
        {
            <p><em>Aucune immatriculation d'immobilisation disponible</em></p>
        }
        else
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th scope="col">Matricule</th>
                        <th scope="col">Immobilisation (Désignation)</th>
                        <th scope="col">Code (Immobilisation)</th>
                        <th scope="col">Bon Réception (Entrée)</th>
                        <th scope="col">État Initial</th>
                        <th scope="col">Remarque</th>
                        
                    </tr>
                </thead>
                <tbody>
                    @foreach (var immatriculation in immobilisationImmatriculations)
                    {
                        <tr>
                            <td>@immatriculation.Matricule</td>
                            <td>@(immatriculation.EntreeImmobilisation?.Immobilisation?.Designation ?? "N/A")</td>
                            <td>@(immatriculation.EntreeImmobilisation?.Immobilisation?.Reference ?? "N/A")</td>
                            <td>@(immatriculation.EntreeImmobilisation?.BonReception ?? "N/A")</td>
                            <td>@immatriculation.EtatInitiale</td>
                            <td>@(immatriculation.Remarque ?? "Aucune remarque")</td>
                            
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination Corrigée: Utilise les champs de classe currentPage et totalPages -->
            @if (totalPages > 1) // On affiche la pagination seulement si plus d'une page
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            @* Utilise le champ de classe currentPage *@
                            <button class="page-link" @onclick="@(() => LoadImmobilisationImmatriculations(currentPage - 1))" disabled="@(currentPage == 1)">Précédent</button>
                        </li>

                        @* Affichage "Page X sur Y" au milieu pour la clarté *@
                        <li class="page-item disabled">
                            @* Utilise les champs de classe currentPage et totalPages *@
                            <span class="page-link">Page @currentPage sur @totalPages</span>
                        </li>

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            @* Utilise les champs de classe currentPage et totalPages *@
                            <button class="page-link" @onclick="@(() => LoadImmobilisationImmatriculations(currentPage + 1))" disabled="@(currentPage == totalPages)">Suivant</button>
                        </li>
                    </ul>
                </nav>
                @* Optionnel : Afficher le texte sous la pagination si souhaité, même pour une seule page *@
                @* <center> *@
                @*    <p>Page @currentPage sur @totalPages</p> *@
                @* </center> *@
            }
            else if (totalPages == 1 && immobilisationImmatriculations.Any()) // Cas où il y a des données mais une seule page
            {
                <center>
                    <p>Page 1 sur 1</p>
                </center>
            }
            @* Pas besoin de 'else' ici pour "Informations de pagination indisponibles" car *@
            @* si totalPages est 0, le message "Aucune immatriculation..." est déjà affiché, *@
            @* ou si le chargement a échoué, le message "Chargement..." ou une erreur console existe. *@
        }
    </div>
</div>

@code {
    private List<ImmobilisationImmatriculationDto>? immobilisationImmatriculations; // Nullable pour l'état de chargement
    private ApiResponse? apiResponse;

    // Champs de classe pour l'état de la pagination
    private int currentPage = 1;
    private int pageSize = 5; // Ou la valeur par défaut de votre API
    private int totalPages = 0; // Initialisé à 0

    private string immobilisationImmatriculationUrl = "http://localhost:5077/api/immobilisation-immatriculations";

    protected override async Task OnInitializedAsync()
    {
        await LoadImmobilisationImmatriculations(currentPage);
    }

    private async Task LoadImmobilisationImmatriculations(int page)
    {
        // Assurer que la page demandée est valide
        currentPage = Math.Max(1, page);
        totalPages = 0; // Réinitialiser au cas où l'appel échoue
        immobilisationImmatriculations = null; // Indiquer le chargement
        StateHasChanged(); // Mettre à jour l'UI pour montrer "Chargement..."

        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{immobilisationImmatriculationUrl}?position={currentPage}&pageSize={pageSize}", options);

            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                var jsonData = apiResponse.Data.ToString();
                immobilisationImmatriculations = JsonSerializer.Deserialize<List<ImmobilisationImmatriculationDto>>(jsonData, options) ?? new List<ImmobilisationImmatriculationDto>();

                // Mise à jour des champs de classe totalPages et currentPage (si l'API retourne la page réelle)
                if (apiResponse.ViewBag != null)
                {
                    if (apiResponse.ViewBag.TryGetValue("nbrLinks", out var linksObj) &&
                        int.TryParse(linksObj?.ToString(), out int parsedTotalPages))
                    {
                        totalPages = parsedTotalPages; // Mise à jour du champ de classe
                    }
                    else if (apiResponse.ViewBag.TryGetValue("TotalCount", out var countObj) &&
                             int.TryParse(countObj?.ToString(), out int totalCount))
                    {
                        totalPages = (int)Math.Ceiling((double)totalCount / pageSize); // Calcul et mise à jour
                    }

                    // Optionnel: Mettre à jour currentPage si l'API le retourne explicitement (ViewBag["position"])
                    // et qu'il pourrait être différent de celui demandé (par ex. si on demande une page trop grande)
                    if (apiResponse.ViewBag.TryGetValue("position", out var posObj) &&
                        int.TryParse(posObj?.ToString(), out int actualPage))
                    {
                        currentPage = actualPage; // Mise à jour du champ de classe
                    }
                }

                // Si aucune info de pagination n'est reçue mais qu'on a des données
                if (totalPages == 0 && immobilisationImmatriculations.Any())
                {
                    // On ne peut qu'estimer, on suppose qu'il n'y a qu'une page si on n'a pas d'info contraire
                    totalPages = 1;
                }

            }
            else
            {
                immobilisationImmatriculations = new List<ImmobilisationImmatriculationDto>(); // Liste vide en cas d'échec ou pas de données
                Console.WriteLine($"API non réussie ou données nulles: {apiResponse?.StatusCode} - {apiResponse?.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des immatriculations : {ex.Message}");
            immobilisationImmatriculations = new List<ImmobilisationImmatriculationDto>(); // Assurer une liste vide en cas d'erreur
        }

        // S'assurer que currentPage ne dépasse pas totalPages après le chargement
        if (totalPages > 0 && currentPage > totalPages)
        {
            currentPage = totalPages;
            // Optionnel: Recharger les données pour la dernière page valide si la page actuelle était invalide
            // await LoadImmobilisationImmatriculations(currentPage); // Attention aux boucles infinies ici
        }

        StateHasChanged(); // Mettre à jour l'UI avec les données chargées et la pagination
    }

    // Gestionnaire pour le callback de création
    private async Task HandleImmatriculationCreated()
    {
        // Recharger la liste (potentiellement la première page ou la page actuelle)
        // Si on veut aller à la dernière page après création :
        // await LoadImmobilisationImmatriculations(totalPages); // Il faudrait recalculer totalPages avant...
        // Le plus simple est de rester sur la page actuelle ou recharger la première page.
        await LoadImmobilisationImmatriculations(currentPage);
    }

    private async Task DeleteImmobilisationImmatriculation(int id)
    {
        // Ajouter une confirmation JS serait une bonne pratique
        // bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Êtes-vous sûr de vouloir supprimer cette immatriculation ?");
        // if (!confirmed) return;

        try
        {
            var response = await Http.DeleteAsync($"{immobilisationImmatriculationUrl}/{id}");
            if (response.IsSuccessStatusCode)
            {
                // Si la suppression réussit, recharger les données
                // Si c'était le dernier élément de la page actuelle (et pas la première page),
                // on pourrait vouloir naviguer vers la page précédente.
                if (immobilisationImmatriculations?.Count == 1 && currentPage > 1)
                {
                    // Décrémenter avant de charger pour aller à la page précédente
                    currentPage--;
                }
                await LoadImmobilisationImmatriculations(currentPage); // Recharge la page (potentiellement la précédente)
            }
            else
            {
                Console.WriteLine($"Erreur lors de la suppression: {response.StatusCode}");
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Détails: {errorContent}");
                // Afficher un message d'erreur à l'utilisateur
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la suppression : {ex.Message}");
            // Afficher un message d'erreur à l'utilisateur
        }
        // StateHasChanged est appelé implicitement par LoadImmobilisationImmatriculations
    }

    private void EditImmatriculation(int id)
    {
        // Naviguer vers la page d'édition
        NavigationManager.NavigateTo($"/immobilisation-immatriculations/edit/{id}");
    }
}