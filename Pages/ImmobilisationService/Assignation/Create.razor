@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Immobilisation
@using LimsUtils.Api

<div class="d-flex justify-content-center">
    <div class="card border-dark mb-3" style="max-width: 60rem;">
        <div class="card-header">Créer une Assignation</div>
        <div class="card-body text-dark">
            <EditForm Model="@assignation" OnValidSubmit="@HandleOnSubmit" FormName="assignationForm">
                <DataAnnotationsValidator />
                <div class="row">
                    <!-- Première colonne -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Rechercher Employé par Matricule</label>
                            <InputText class="form-control" @bind-Value="searchMatricule" @oninput="@OnSearchMatriculeChanged" placeholder="Matricule" />
                            @if (!string.IsNullOrEmpty(searchMatricule))
                            {
                                <ul class="list-group">
                                    @foreach (var employe in filteredEmployes)
                                    {
                                        <li class="list-group-item" @onclick="() => SelectEmploye(employe)">
                                            @employe.Matricule - @employe.Nom @employe.Prenom
                                        </li>
                                    }
                                </ul>
                            }
                            @if (isEmployeInvalid)
                            {
                                <div class="text-danger">Veuillez sélectionner un employé.</div>
                            }
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Nom et Prénom de l'Employé</label>
                            <InputText class="form-control" @bind-Value="employeNomPrenom" disabled />
                            <button type="button" class="btn btn-secondary mt-2" @onclick="HandleFilter">Filtrer</button>
                            <button type="button" class="btn btn-secondary mt-2" @onclick="HandleResetFilter">Réafficher</button>
                            @if (isFilterInvalid)
                            {
                                <div class="text-danger">Veuillez entrer un nom pour filtrer.</div>
                            }
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Immatriculation (non assignée)</label>
                            <InputSelect class="form-control" @bind-Value="assignation.IdImmobilisationPropre">
                                <option value="0">-- Sélectionner --</option>
                                @foreach (var immatriculation in availableImmatriculations)
                                {
                                    <option value="@immatriculation.IdImmobilisationPropre">
                                        @immatriculation.EntreeImmobilisation?.Immobilisation?.Designation - @immatriculation.Matricule
                                    </option>
                                }
                            </InputSelect>
                            @if (isImmatriculationInvalid)
                            {
                                <div class="text-danger">Veuillez sélectionner une immatriculation.</div>
                            }
                        </div>
                    </div>
                    <!-- Deuxième colonne -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Localisation</label>
                            <InputSelect class="form-control" @bind-Value="assignation.IdLocalisation">
                                <option value="0">-- Sélectionner --</option>
                                @foreach (var localisation in localisations)
                                {
                                    <option value="@localisation.IdLocalisation">@localisation.Designation</option>
                                }
                            </InputSelect>
                            @if (isLocalisationInvalid)
                            {
                                <div class="text-danger">Veuillez sélectionner une localisation.</div>
                            }
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Date Assignation</label>
                            <InputDate class="form-control" @bind-Value="assignation.DateAssignation" disabled />
                        </div>
                    </div>
                </div>
                <br />
                <center>
                    <button type="submit" class="btn btn-primary">Créer</button>
                </center>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private AssignationDto assignation = new() { DateAssignation = DateTime.Today };
    private List<EmployeImmobilisationDto> employes = new();
    private List<ImmobilisationImmatriculationDto> availableImmatriculations = new();
    private List<LocalisationDto> localisations = new();
    private string searchMatricule = string.Empty;
    private string employeNomPrenom = string.Empty;
    private string assignationUrl = "http://localhost:5077/api/assignation";

    // Flags de validation
    private bool isEmployeInvalid = false;
    private bool isImmatriculationInvalid = false;
    private bool isLocalisationInvalid = false;
    private bool isFilterInvalid = false;

    [Parameter]
    public EventCallback OnAssignationCreated { get; set; }

    [Parameter]
    public EventCallback<string> FilterRequested { get; set; }

    private List<EmployeImmobilisationDto> filteredEmployes => employes
        .Where(e => e.Matricule.StartsWith(searchMatricule, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        employes = await LoadEmployes();
        availableImmatriculations = await LoadAvailableImmatriculations();
        localisations = await LoadLocalisations();
    }

    private async Task<List<EmployeImmobilisationDto>> LoadEmployes()
    {
        try
        {
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>("http://localhost:5077/api/employes");
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                var jsonData = JsonSerializer.Serialize(apiResponse.Data);
                return JsonSerializer.Deserialize<List<EmployeImmobilisationDto>>(jsonData,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<EmployeImmobilisationDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des employés : {ex.Message}");
        }
        return new List<EmployeImmobilisationDto>();
    }

    private async Task<List<ImmobilisationImmatriculationDto>> LoadAvailableImmatriculations()
    {
        try
        {
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>("http://localhost:5077/api/assignation/available-immobilisations");
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                var jsonData = JsonSerializer.Serialize(apiResponse.Data);
                return JsonSerializer.Deserialize<List<ImmobilisationImmatriculationDto>>(jsonData,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<ImmobilisationImmatriculationDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des immatriculations disponibles : {ex.Message}");
        }
        return new List<ImmobilisationImmatriculationDto>();
    }

    private async Task<List<LocalisationDto>> LoadLocalisations()
    {
        try 
        {
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>("http://localhost:5077/api/assignation/localisations");
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                var jsonData = JsonSerializer.Serialize(apiResponse.Data);
                return JsonSerializer.Deserialize<List<LocalisationDto>>(jsonData,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<LocalisationDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des localisations : {ex.Message}");
        }
        return new List<LocalisationDto>();
    }

    private void SelectEmploye(EmployeImmobilisationDto employe)
    {
        assignation.IdEmploye = employe.IdEmploye;
        employeNomPrenom = $"{employe.Nom} {employe.Prenom}";
        searchMatricule = employe.Matricule;
    }

    private async Task OnSearchMatriculeChanged(ChangeEventArgs e)
    {
        searchMatricule = e.Value?.ToString() ?? string.Empty;
    }

    private async Task HandleFilter()
    {
        isFilterInvalid = string.IsNullOrWhiteSpace(employeNomPrenom);
        if (!isFilterInvalid)
        {
            await FilterRequested.InvokeAsync(employeNomPrenom);
        }
        StateHasChanged();
    }

    private async Task HandleResetFilter()
    {
        await FilterRequested.InvokeAsync(string.Empty);
    }

    private async Task HandleOnSubmit()
    {
        ResetValidationFlags();

        isEmployeInvalid = assignation.IdEmploye == 0;
        isImmatriculationInvalid = assignation.IdImmobilisationPropre == 0;
        isLocalisationInvalid = assignation.IdLocalisation == null || assignation.IdLocalisation == 0;

        if (!isEmployeInvalid && !isImmatriculationInvalid && !isLocalisationInvalid)
        {
            string employeInfo = employeNomPrenom;
            var immat = availableImmatriculations.FirstOrDefault(i => i.IdImmobilisationPropre == assignation.IdImmobilisationPropre);
            string immatriculationInfo = (immat?.EntreeImmobilisation?.Immobilisation?.Designation + " - " + immat?.Matricule) ?? "Non sélectionné";
            string localisationInfo = localisations.FirstOrDefault(l => l.IdLocalisation == assignation.IdLocalisation)?.Designation ?? "Non sélectionné";
            string dateAssignation = assignation.DateAssignation.ToShortDateString();

            string message = $"Veuillez vérifier les informations suivantes avant de créer l'assignation :\n\n" +
                             $"Employé : {employeInfo}\n" +
                             $"Immatriculation : {immatriculationInfo}\n" +
                             $"Localisation : {localisationInfo}\n" +
                             $"Date Assignation : {dateAssignation}\n\n" +
                             "Êtes-vous sûr de vouloir créer cette assignation ? Une fois créée, aucune modification ou suppression ne sera possible.";

            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", message);
            if (confirmed)
            {
                try
                {
                    var response = await Http.PostAsJsonAsync(assignationUrl, assignation);
                    response.EnsureSuccessStatusCode();
                    if (OnAssignationCreated.HasDelegate)
                        await OnAssignationCreated.InvokeAsync();
                    assignation = new AssignationDto { DateAssignation = DateTime.Today };
                    searchMatricule = string.Empty;
                    employeNomPrenom = string.Empty;
                    availableImmatriculations = await LoadAvailableImmatriculations();
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Erreur lors de la création de l'assignation : {ex.Message}");
                }
            }
        }
        else
        {
            StateHasChanged();
        }
    }

    private void ResetValidationFlags()
    {
        isEmployeInvalid = false;
        isImmatriculationInvalid = false;
        isLocalisationInvalid = false;
        isFilterInvalid = false;
    }
}