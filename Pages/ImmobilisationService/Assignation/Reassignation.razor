@page "/assignations/reassign"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Immobilisation
@using LimsUtils.Api
@using System.Text.Json.Serialization

<div class="d-flex justify-content-center">
    <div class="card border-dark mb-3" style="max-width: 60rem;">
        <div class="card-header">Réaffecter une Immobilisation</div>
        <div class="card-body text-dark">
            <EditForm Model="@reassignation" OnValidSubmit="@HandleOnSubmit" FormName="reassignationForm">
                <DataAnnotationsValidator />
                <div class="row">
                    <!-- Première colonne -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Immatriculation à réassigner</label>
                            @* <InputSelect class="form-control" @bind-Value="selectedImmatriculationId" @onchange="LoadCurrentAssignationData"> *@
                            <InputSelect class="form-control"   Value="@selectedImmatriculationId"
                                    ValueChanged="@( (int value) => LoadCurrentAssignationData(value) )"
                                    ValueExpression="@(() => selectedImmatriculationId)">
                                <option value="0">-- Sélectionner --</option>
                                @foreach (var immatriculation in assignedImmatriculations)
                                {
                                    <option value="@immatriculation.IdImmobilisationPropre">
                                        @immatriculation.EntreeImmobilisation?.Immobilisation?.Designation - @immatriculation.Matricule
                                    </option>
                                }
                            </InputSelect>
                            @if (isImmatriculationInvalid)
                            {
                                <div class="text-danger">Veuillez sélectionner une immatriculation.</div>
                            }
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Employé actuel de l'assignation</label>
                            <input class="form-control" value="@currentEmployeNomPrenom" readonly />
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Employé pour réassignation</label>
                            <InputSelect class="form-control" @bind-Value="reassignation.IdEmploye">
                                <option value="0">-- Sélectionner --</option>
                                @foreach (var employe in employes)
                                {
                                    <option value="@employe.IdEmploye">@employe.Nom @employe.Prenom</option>
                                }
                            </InputSelect>
                            @if (isEmployeInvalid)
                            {
                                <div class="text-danger">Veuillez sélectionner un employé.</div>
                            }
                        </div>
                    </div>
                    <!-- Deuxième colonne -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Localisation</label>
                            <InputSelect class="form-control" @bind-Value="reassignation.IdLocalisation">
                                <option value="0">-- Sélectionner --</option>
                                @foreach (var localisation in localisations)
                                {
                                    <option value="@localisation.IdLocalisation">@localisation.Designation</option>
                                }
                            </InputSelect>
                            @if (isLocalisationInvalid)
                            {
                                <div class="text-danger">Veuillez sélectionner une localisation.</div>
                            }
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Date de Réassignation</label>
                            <InputDate class="form-control" @bind-Value="reassignation.DateAssignation" disabled />
                        </div>
                    </div>
                </div>
                <br />
                <center>
                    <button type="submit" class="btn btn-primary">Réassigner</button>
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">Annuler</button>
                </center>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private AssignationDto reassignation = new() { DateAssignation = DateTime.Today };
    private List<EmployeImmobilisationDto> employes = new();
    private List<ImmobilisationImmatriculationDto> assignedImmatriculations = new();
    private List<LocalisationDto> localisations = new();
    private string currentEmployeNomPrenom = string.Empty;
    private int selectedImmatriculationId = 0;
    private string assignationUrl = "http://localhost:5077/api/assignation";

    // Flags de validation
    private bool isImmatriculationInvalid = false;
    private bool isEmployeInvalid = false;
    private bool isLocalisationInvalid = false;

    protected override async Task OnInitializedAsync()
    {
        employes = await LoadEmployes();
        assignedImmatriculations = await LoadAssignedImmatriculations();
        localisations = await LoadLocalisations();
    }

    private async Task<List<EmployeImmobilisationDto>> LoadEmployes()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse>("http://localhost:5077/api/employes");
            return response?.IsSuccess == true 
                ? JsonSerializer.Deserialize<List<EmployeImmobilisationDto>>(
                    JsonSerializer.Serialize(response.Data),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) 
                : new List<EmployeImmobilisationDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement employés: {ex.Message}");
            return new List<EmployeImmobilisationDto>();
        }
    }

    private async Task<List<ImmobilisationImmatriculationDto>> LoadAssignedImmatriculations()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse>($"{assignationUrl}/assigned-immobilisations");
            return response?.IsSuccess == true
                ? JsonSerializer.Deserialize<List<ImmobilisationImmatriculationDto>>(
                    JsonSerializer.Serialize(response.Data),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                : new List<ImmobilisationImmatriculationDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement immatriculations: {ex.Message}");
            return new List<ImmobilisationImmatriculationDto>();
        }
    }

    private async Task<List<LocalisationDto>> LoadLocalisations()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse>($"{assignationUrl}/localisations");
            return response?.IsSuccess == true
                ? JsonSerializer.Deserialize<List<LocalisationDto>>(
                    JsonSerializer.Serialize(response.Data),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                : new List<LocalisationDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement localisations: {ex.Message}");
            return new List<LocalisationDto>();
        }
    }

    private async Task LoadCurrentAssignationData(int val)
    {   
        selectedImmatriculationId = val;
        var currentAssignation = await GetCurrentAssignation(selectedImmatriculationId);

        if (currentAssignation != null && currentAssignation.Employe != null)
        {
            currentEmployeNomPrenom = $"{currentAssignation.Employe.Nom} {currentAssignation.Employe.Prenom}";
            reassignation.IdImmobilisationPropre = selectedImmatriculationId;
        }
        else
        {
            currentEmployeNomPrenom = "Aucun employé assigné";
        }
        StateHasChanged();
    }

    private async Task<AssignationDto> GetCurrentAssignation(int idImmobilisationPropre)
{
    try
    {
        var response = await Http.GetFromJsonAsync<ApiResponse>($"{assignationUrl}/current/{idImmobilisationPropre}");
        if (response?.IsSuccess == true && response.Data != null)
        {
            return JsonSerializer.Deserialize<AssignationDto>(
                JsonSerializer.Serialize(response.Data),
                new JsonSerializerOptions 
                { 
                    PropertyNameCaseInsensitive = true,
                    // Retirer ReferenceHandler si non nécessaire
                });
        }
        return null;
    }
    catch (Exception ex)
    {
        await JSRuntime.InvokeVoidAsync("console.error", $"Erreur récupération assignation: {ex.Message}");
        return null;
    }
}

    private async Task HandleOnSubmit()
    {
        ResetValidationFlags();

        isImmatriculationInvalid = selectedImmatriculationId == 0;
        isEmployeInvalid = reassignation.IdEmploye == 0;
        isLocalisationInvalid = reassignation.IdLocalisation == 0;

        if (!isImmatriculationInvalid && !isEmployeInvalid && !isLocalisationInvalid)
        {
            try
            {
                var response = await Http.PostAsJsonAsync(assignationUrl, reassignation);
                if (response.IsSuccessStatusCode)
                {
                    NavigationManager.NavigateTo("/assignations");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erreur réassignation: {ex.Message}");
            }
        }
        else
        {
            StateHasChanged();
        }
    }

    private void ResetValidationFlags()
    {
        isImmatriculationInvalid = false;
        isEmployeInvalid = false;
        isLocalisationInvalid = false;
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/assignations");
    }
}