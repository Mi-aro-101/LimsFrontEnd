@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Immobilisation
@using LimsUtils.Api

<div class="container">
    <!-- Formulaire centré au-dessus -->
    <Create OnAssignationCreated="HandleAssignationCreated" FilterRequested="ApplyFilter" />

    <!-- Liste des assignations en dessous -->
    <div class="mt-4">
        @if (assignations == null || assignations.Count == 0)
        {
            <p><em>Aucune assignation disponible</em></p>
        }
        else
        {
            if (apiResponse != null && apiResponse.ViewBag != null &&
                apiResponse.ViewBag.ContainsKey("position") &&
                apiResponse.ViewBag.ContainsKey("nbrPerPage") &&
                apiResponse.ViewBag.ContainsKey("nbrLinks"))
            {
                var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
                var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">Employé Responsable</th>
                            <th scope="col">Immatriculation</th>
                            <th scope="col">Localisation</th>
                            <th scope="col">Date Assignation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignation in assignations.OrderByDescending(a => a.DateAssignation))
                        {
                            <tr>
                                <td>@(assignation.Employe?.Nom) @(assignation.Employe?.Prenom)</td>
                                <td>@(assignation.ImmobilisationImmatriculation?.EntreeImmobilisation?.Immobilisation?.Designation) - @(assignation.ImmobilisationImmatriculation?.Matricule)</td>
                                <td>@(assignation.Localisation?.Designation ?? "N/A")</td>
                                <td>@assignation.DateAssignation.ToShortDateString()</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadAssignations(currentPage - 1))">Précédent</a>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadAssignations(currentPage + 1))">Suivant</a>
                        </li>
                    </ul>
                </nav>

                <center>
                    <p>Page @apiResponse.ViewBag["position"] sur @apiResponse.ViewBag["nbrLinks"]</p>
                </center>
            }
            else
            {
                <p>Informations de pagination indisponibles.</p>
            }
        }
    </div>
</div>

@code {
    private List<AssignationDto> assignations = new();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 5;
    private string assignationUrl = "http://localhost:5077/api/assignation";
    private string filterEmploye = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAssignations(currentPage);
    }

    private async Task LoadAssignations(int page)
    {
        if (page < 1) page = 1;
        currentPage = page;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            string url = string.IsNullOrEmpty(filterEmploye)
                ? $"{assignationUrl}?position={currentPage}&pageSize={pageSize}"
                : $"{assignationUrl}/search?searchTerm={Uri.EscapeDataString(filterEmploye)}&position={currentPage}&pageSize={pageSize}";
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url, options);
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                string jsonData = JsonSerializer.Serialize(apiResponse.Data);
                assignations = JsonSerializer.Deserialize<List<AssignationDto>>(jsonData, options) ?? new List<AssignationDto>();
                // Fallback sorting in case the backend does not sort correctly
                assignations = assignations.OrderByDescending(a => a.DateAssignation).ToList();
            }
            else
            {
                assignations = new List<AssignationDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des assignations : {ex.Message}");
            assignations = new List<AssignationDto>();
        }
        StateHasChanged();
    }

    private async Task ApplyFilter(string filterValue)
    {
        filterEmploye = filterValue;
        await LoadAssignations(1);
    }

    private async Task HandleAssignationCreated()
    {
        await LoadAssignations(currentPage);
    }
}