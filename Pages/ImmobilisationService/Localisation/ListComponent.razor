@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Immobilisation
@using LimsUtils.Api
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using LimsFrontEnd.Components

<div class="row">
    <!-- Colonne de création -->
    <div class="col">
        <Create OnLocalisationCreated="HandleLocalisationCreated" />
    </div>

    <!-- Colonne de la liste -->
    <div class="col">
        @if (localisations == null || localisations.Count == 0)
        {
            <p><em>Aucune localisation disponible</em></p>
        }
        else
        {
            @if (apiResponse != null && apiResponse.ViewBag != null &&
                apiResponse.ViewBag.ContainsKey("position") &&
                apiResponse.ViewBag.ContainsKey("nbrPerPage") &&
                apiResponse.ViewBag.ContainsKey("nbrLinks"))
            {
                var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
                var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
                
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            @* <th scope="col">ID</th> *@
                            <th scope="col">Désignation</th>
                            <th scope="col"><center>Actions</center></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var localisation in localisations.OrderByDescending(l => l.IdLocalisation)) 
                        {
                            <tr>
                                @* <td>@localisation.IdLocalisation</td> *@
                                <td>@localisation.Designation</td>
                                <td>
                                    <center>
                                        <MudButton Size="Size.Small"
                                                   @onclick="@(() => HandleUpdate(localisation.IdLocalisation))"
                                                   Variant="Variant.Filled"
                                                   StartIcon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Warning">
                                        </MudButton>
                                    </center>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadLocalisations(currentPage - 1))">Précédent</a>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadLocalisations(currentPage + 1))">Suivant</a>
                        </li>
                    </ul>
                </nav>

                <center>
                    <p>Page @apiResponse.ViewBag["position"] sur @apiResponse.ViewBag["nbrLinks"]</p>
                </center>
            }
            else
            {
                <p>Informations de pagination indisponibles.</p>
            }
        }
    </div>
</div>

@code {
    private List<LocalisationDto> localisations = new List<LocalisationDto>();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 10;
    private string url = "http://localhost:5077/api/localisations";

    protected override async Task OnInitializedAsync()
    {
        await LoadLocalisations(currentPage);
    }

    private async Task LoadLocalisations(int page)
    {
        currentPage = page;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{url}?position={currentPage}&pageSize={pageSize}", options);
            
            if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Data != null)
            {
                localisations = apiResponse.Data != null
                    ? JsonSerializer.Deserialize<List<LocalisationDto>>(
                        apiResponse.Data?.ToString() ?? string.Empty,
                        new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                    ) ?? new List<LocalisationDto>()
                    : new List<LocalisationDto>();

                // Tri par ID décroissant pour avoir les plus récents en premier
                localisations = localisations.OrderByDescending(l => l.IdLocalisation).ToList();

                Console.WriteLine($"Chargement de la page {currentPage}. Enregistrements reçus: {localisations.Count}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des localisations : {ex.Message}");
        }
    }

    private async Task HandleLocalisationCreated()
    {
        // Recharger la première page pour voir la nouvelle localisation
        await LoadLocalisations(1);
    }

    private void HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/localisation/edit/{id}");
    }
}