@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models.Immobilisation
@using LimsUtils.Api
@using System.Text.Json

<!-- Centrer le formulaire principal -->
<div class="d-flex justify-content-center">
    <div class="card border-dark mb-3" style="max-width: 60rem;">
        <div class="card-header">Créer une Entrée Immobilisation</div>
        <div class="card-body text-dark">
            <EditForm Model="@entreeImmobilisation" OnValidSubmit="@HandleOnSubmit" FormName="entreeImmobilisationForm">
                <DataAnnotationsValidator />
                <div class="row">
                    <!-- Première colonne -->
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Quantité</label>
                            <InputNumber class="form-control" @bind-Value="entreeImmobilisation.Quantite" />
                            @if (isQuantiteInvalid)
                            {
                                <div class="text-danger">La quantité doit être supérieure à zéro.</div>
                            }
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Prix d'achat</label>
                            <InputText id="prixAchatInput" class="form-control" @bind-Value="prixAchatFormatted" @oninput="@(async (ChangeEventArgs e) => await HandlePrixAchatInput(e))" placeholder="0" />
                            @if (isPrixAchatInvalid)
                            {
                                <div class="text-danger">Le prix d'achat doit être supérieur à zéro.</div>
                            }
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Bordereau mouvement comptable immobilisation</label>
                            <InputText class="form-control" @bind-Value="entreeImmobilisation.BonReception" placeholder="BMCI" />
                        </div>
                    </div>
                    <!-- Deuxième colonne -->
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Bon de Commande</label>
                            <InputText class="form-control" @bind-Value="entreeImmobilisation.BonDeCommande" placeholder="Bon de commande" />
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Numéro de Facture</label>
                            <InputText class="form-control" @bind-Value="entreeImmobilisation.NumeroFacture" placeholder="Numéro de facture" />
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Date d'Entrée</label>
                            <InputDate class="form-control" @bind-Value="entreeImmobilisation.DateEntree" disabled />
                        </div>
                    </div>
                    <!-- Troisième colonne -->
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Immobilisation</label>
                            <InputText class="form-control"
                                       Value="@searchTerm"
                                       ValueChanged="@((string val) => OnSearchChanged(val))"
                                       ValueExpression="@(() => searchTerm)"
                                       placeholder="Rechercher une immobilisation"
                                       @oninput="@(async (ChangeEventArgs e) => await OnSearchChanged(e.Value.ToString()))" />
                            @if (!string.IsNullOrEmpty(searchTerm))
                            {
                                <ul class="list-group">
                                    @if (filteredImmobilisations.Any())
                                    {
                                        @foreach (var immobilisation in filteredImmobilisations)
                                        {
                                            <li class="list-group-item" @onclick="() => SelectImmobilisation(immobilisation)">
                                                @immobilisation.Designation
                                            </li>
                                        }
                                    }
                                    <li class="list-group-item">
                                        <button type="button" class="btn btn-secondary" @onclick="() => ShowAddImmobilisationForm(searchTerm)">Ajouter</button>
                                    </li>
                                </ul>
                            }
                            @if (isImmobilisationSelectionInvalid)
                            {
                                <div class="text-danger">Veuillez sélectionner une immobilisation.</div>
                            }
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Fournisseur</label>
                            <InputSelect class="form-control" @bind-Value="entreeImmobilisation.IdFournisseur">
                                <option value="">-- Sélectionner --</option>
                                @foreach (var fournisseur in fournisseurs)
                                {
                                    <option value="@fournisseur.IdFournisseur">@fournisseur.Designation</option>
                                }
                            </InputSelect>
                            @if (isFournisseurInvalid)
                            {
                                <div class="text-danger">Veuillez sélectionner un fournisseur.</div>
                            }
                        </div>
                    </div>
                </div>
                <br />
                <center>
                    <button type="submit" class="btn btn-primary">Créer</button>
                </center>
            </EditForm>
        </div>
    </div>
</div>

<!-- Formulaire d'ajout d'immobilisation dans une modal Bootstrap -->
@if (showAddImmobilisationForm)
{
    <div class="modal show" tabindex="-1" style="display:block; background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Créer une Immobilisation</h5>
                    <button type="button" class="btn-close" @onclick="() => showAddImmobilisationForm = false"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@newImmobilisation" OnValidSubmit="@HandleAddImmobilisation">
                        <DataAnnotationsValidator />
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Référence</label>
                            <div class="col-sm-9">
                                <InputText class="form-control" @bind-Value="newImmobilisation.Reference" placeholder="Référence" />
                            </div>
                        </div>
                        <br />
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Désignation</label>
                            <div class="col-sm-9">
                                <InputText class="form-control" @bind-Value="newImmobilisation.Designation" placeholder="Désignation" />
                            </div>
                        </div>
                        <br />
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Marque</label>
                            <div class="col-sm-9">
                                <InputSelect class="form-control" @bind-Value="newImmobilisation.IdMarque">
                                    <option value="">-- Sélectionner --</option>
                                    @foreach (var marque in Marques)
                                    {
                                        <option value="@marque.IdMarque">@marque.Designation</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <br />
                        <center>
                            <button type="submit" class="btn btn-primary">Créer</button>
                            <button type="button" class="btn btn-secondary" @onclick="() => showAddImmobilisationForm = false">Annuler</button>
                        </center>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function formatNumberWithSeparators(value) {
        if (!value) return '';
        // Supprimer tous les caractères non numériques sauf le point décimal
        let cleanValue = value.replace(/[^0-9.]/g, '');
        if (!cleanValue) return '';
        // Séparer la partie entière et décimale
        let parts = cleanValue.split('.');
        let integerPart = parts[0];
        let decimalPart = parts.length > 1 ? '.' + parts[1].slice(0, 2) : '.00'; // Toujours inclure 2 décimales
        // Ajouter des virgules comme séparateurs de milliers
        integerPart = integerPart.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        return integerPart + decimalPart;
    }

    function applyNumberFormat(elementId) {
        let element = document.getElementById(elementId);
        if (element) {
            // Formater la valeur initiale
            element.value = formatNumberWithSeparators(element.value);
            // Positionner le curseur avant le point décimal
            let decimalIndex = element.value.indexOf('.');
            if (decimalIndex !== -1) {
                element.selectionStart = element.selectionEnd = decimalIndex;
            }
            element.addEventListener('input', function () {
                let cursorPosition = element.selectionStart;
                let originalValue = element.value;
                let formattedValue = formatNumberWithSeparators(element.value);
                element.value = formattedValue;
                // Calculer la position du point décimal dans la nouvelle valeur
                let newDecimalIndex = formattedValue.indexOf('.');
                if (newDecimalIndex !== -1) {
                    // Positionner le curseur avant le point décimal
                    let offset = formattedValue.length - originalValue.length;
                    element.selectionStart = element.selectionEnd = Math.min(cursorPosition + offset, newDecimalIndex);
                }
            });
            // Positionner le curseur au focus
            element.addEventListener('focus', function () {
                let decimalIndex = element.value.indexOf('.');
                if (decimalIndex !== -1) {
                    element.selectionStart = element.selectionEnd = decimalIndex;
                }
            });
        }
    }
</script>

@code {
    private EntreeImmobilisationDto entreeImmobilisation = new()
    {
        DateEntree = DateTime.Today,
        Quantite = 0,
        PrixAchat = 0m
    };
    private List<ImmobilisationDto> immobilisations = new();
    private List<FournisseurDto> fournisseurs = new();
    private string searchTerm = string.Empty;
    private bool showAddImmobilisationForm = false;
    private ImmobilisationDto newImmobilisation = new();
    private ICollection<MarqueDto> Marques = new List<MarqueDto>();
    private string prixAchatFormatted = "0"; // Chaîne formatée pour l'affichage

    private string entreeImmobilisationUrl = "http://localhost:5077/api/entree-immobilisations";
    private string immobilisationUrl = "http://localhost:5077/api/immobilisation";
    private string fournisseurUrl = "http://localhost:5077/api/fournisseurs";
    private string marqueUrl = "http://localhost:5077/api/marque";

    [Parameter]
    public EventCallback OnEntreeImmobilisationCreated { get; set; }

    // Flags de validation
    private bool isQuantiteInvalid = false;
    private bool isPrixAchatInvalid = false;
    private bool isFournisseurInvalid = false;
    private bool isImmobilisationSelectionInvalid = false;

    // Filtrer les immobilisations chargées (basé sur la désignation)
    private List<ImmobilisationDto> filteredImmobilisations => immobilisations
        .Where(i => !string.IsNullOrEmpty(i.Designation) &&
                    i.Designation.StartsWith(searchTerm ?? string.Empty, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        entreeImmobilisation.DateEntree = DateTime.Today;
        immobilisations = await LoadImmobilisations();
        fournisseurs = await LoadFournisseurs();
        Marques = await LoadMarques();
        // Initialiser la valeur formatée
        prixAchatFormatted = FormatNumber(entreeImmobilisation.PrixAchat);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Appliquer le formatage JavaScript et positionner le curseur
            await JSRuntime.InvokeVoidAsync("applyNumberFormat", "prixAchatInput");
        }
    }

    private async Task<List<ImmobilisationDto>> LoadImmobilisations()
    {
        try
        {
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{immobilisationUrl}/search?searchTerm={searchTerm}");
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                var jsonData = apiResponse.Data.ToString();
                return JsonSerializer.Deserialize<List<ImmobilisationDto>>(jsonData,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                    ?? new List<ImmobilisationDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des immobilisations : {ex.Message}");
        }
        return new List<ImmobilisationDto>();
    }

    private async Task<List<FournisseurDto>> LoadFournisseurs()
    {
        try
        {
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>(fournisseurUrl);
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                var jsonData = apiResponse.Data.ToString();
                return JsonSerializer.Deserialize<List<FournisseurDto>>(jsonData,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                    ?? new List<FournisseurDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des fournisseurs : {ex.Message}");
        }
        return new List<FournisseurDto>();
    }

    private async Task<ICollection<MarqueDto>> LoadMarques()
    {
        try
        {
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>(marqueUrl);
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                var jsonData = apiResponse.Data.ToString();
                return JsonSerializer.Deserialize<ICollection<MarqueDto>>(jsonData,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                    ?? new List<MarqueDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des marques : {ex.Message}");
        }
        return new List<MarqueDto>();
    }

    private void SelectImmobilisation(ImmobilisationDto immobilisation)
    {
        entreeImmobilisation.IdImmobilisation = immobilisation.IdImmobilisation;
        searchTerm = immobilisation.Designation;
        isImmobilisationSelectionInvalid = false; // Réinitialiser le flag
    }

    private void ShowAddImmobilisationForm(string immobilisationName)
    {
        newImmobilisation = new ImmobilisationDto { Designation = immobilisationName };
        showAddImmobilisationForm = true;
    }

    private async Task HandleAddImmobilisation()
    {
        try
        {
            var response = await Http.PostAsJsonAsync(immobilisationUrl, newImmobilisation);
            response.EnsureSuccessStatusCode();
            immobilisations = await LoadImmobilisations();
            entreeImmobilisation.IdImmobilisation = immobilisations.FirstOrDefault(i => i.Designation == newImmobilisation.Designation)?.IdImmobilisation;
            searchTerm = newImmobilisation.Designation;
            showAddImmobilisationForm = false;
            newImmobilisation = new ImmobilisationDto();
            isImmobilisationSelectionInvalid = false; // Réinitialiser le flag
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la création de l'immobilisation : {ex.Message}");
        }
    }

    private string FormatNumber(decimal? value)
    {
        if (!value.HasValue || value == 0) return "0.00";
        string[] parts = value.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture).Split('.');
        string integerPart = long.Parse(parts[0]).ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture);
        string decimalPart = parts.Length > 1 ? "." + parts[1] : ".00";
        return integerPart + decimalPart;
    }

    private async Task HandlePrixAchatInput(ChangeEventArgs e)
    {
        prixAchatFormatted = e.Value?.ToString() ?? "";
        // Supprimer les virgules pour convertir en decimal
        if (string.IsNullOrWhiteSpace(prixAchatFormatted))
        {
            entreeImmobilisation.PrixAchat = 0m;
            prixAchatFormatted = "0.00";
        }
        else if (decimal.TryParse(prixAchatFormatted.Replace(",", ""), System.Globalization.CultureInfo.InvariantCulture, out decimal parsedValue))
        {
            entreeImmobilisation.PrixAchat = parsedValue;
            prixAchatFormatted = FormatNumber(parsedValue); // Reformater après conversion
        }
        else
        {
            entreeImmobilisation.PrixAchat = 0m;
            prixAchatFormatted = "0.00";
        }
        // Repositionner le curseur via JavaScript
        await JSRuntime.InvokeVoidAsync("applyNumberFormat", "prixAchatInput");
        StateHasChanged();
    }

    private async Task HandleOnSubmit()
    {
        ResetValidationFlags();

        isQuantiteInvalid = entreeImmobilisation.Quantite <= 0;
        isPrixAchatInvalid = entreeImmobilisation.PrixAchat <= 0;
        isFournisseurInvalid = entreeImmobilisation.IdFournisseur == 0;
        isImmobilisationSelectionInvalid = entreeImmobilisation.IdImmobilisation == 0;

        if (!isQuantiteInvalid && !isPrixAchatInvalid && !isFournisseurInvalid && !isImmobilisationSelectionInvalid)
        {
            // Assigner des valeurs par défaut si les champs sont vides
            entreeImmobilisation.BonReception = string.IsNullOrWhiteSpace(entreeImmobilisation.BonReception) ? "Aucun BMCI" : entreeImmobilisation.BonReception;
            entreeImmobilisation.BonDeCommande = string.IsNullOrWhiteSpace(entreeImmobilisation.BonDeCommande) ? "Aucun bon de commande" : entreeImmobilisation.BonDeCommande;
            entreeImmobilisation.NumeroFacture = string.IsNullOrWhiteSpace(entreeImmobilisation.NumeroFacture) ? "Aucun numéro de facture" : entreeImmobilisation.NumeroFacture;

            string immobilisationDesignation = immobilisations.FirstOrDefault(i => i.IdImmobilisation == entreeImmobilisation.IdImmobilisation)?.Designation ?? "Non sélectionné";
            string quantite = entreeImmobilisation.Quantite.ToString();
            string prixAchat = prixAchatFormatted; // Utiliser la version formatée pour l'affichage
            string bonReception = entreeImmobilisation.BonReception;
            string bonDeCommande = entreeImmobilisation.BonDeCommande;
            string numeroFacture = entreeImmobilisation.NumeroFacture;
            string fournisseurDesignation = fournisseurs.FirstOrDefault(f => f.IdFournisseur == entreeImmobilisation.IdFournisseur)?.Designation ?? "Non sélectionné";

            string message = $"Veuillez vérifier les informations suivantes avant de créer l'entrée d'immobilisation :\n\n" +
                             $"Immobilisation : {immobilisationDesignation}\n" +
                             $"Quantité : {quantite}\n" +
                             $"Prix d'achat : {prixAchat}\n" +
                             $"Bordereau mouvement comptable immobilisation : {bonReception}\n" +
                             $"Bon de commande : {bonDeCommande}\n" +
                             $"Numéro de facture : {numeroFacture}\n" +
                             $"Fournisseur : {fournisseurDesignation}\n\n" +
                             "Êtes-vous vraiment sûr de la véracité de ces informations ? Une fois créée, l'entrée ne pourra plus être modifiée ou supprimée.";

            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", message);
            if (!confirmed)
            {
                return;
            }

            try
            {
                var response = await Http.PostAsJsonAsync(entreeImmobilisationUrl, entreeImmobilisation);
                response.EnsureSuccessStatusCode();
                if (OnEntreeImmobilisationCreated.HasDelegate)
                    await OnEntreeImmobilisationCreated.InvokeAsync();
                entreeImmobilisation = new EntreeImmobilisationDto() { DateEntree = DateTime.Today, Quantite = 0, PrixAchat = 0m };
                prixAchatFormatted = "0.00";
                searchTerm = string.Empty;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erreur lors de la création de l'entrée d'immobilisation : {ex.Message}");
            }
        }
        else
        {
            StateHasChanged();
        }
    }

    private void ResetValidationFlags()
    {
        isQuantiteInvalid = false;
        isPrixAchatInvalid = false;
        isFournisseurInvalid = false;
        isImmobilisationSelectionInvalid = false;
    }

    private async Task OnSearchChanged(string val)
    {
        searchTerm = val;
        immobilisations = await LoadImmobilisations();
        StateHasChanged();
    }
}