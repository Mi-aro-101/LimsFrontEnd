@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Immobilisation
@using LimsUtils.Api
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using LimsFrontEnd.Components

<div class="row">
    <!-- Colonne de création -->
    <div class="col">
        <Create OnObjetIndisponibiliteCreated="HandleObjetIndisponibiliteCreated" />
    </div>

    <!-- Colonne de la liste -->
    <div class="col">
        @if (objetsIndisponibilite == null || objetsIndisponibilite.Count == 0)
        {
            <p><em>Aucun objet d'indisponibilité disponible</em></p>
        }
        else
        {
            @if (apiResponse != null && apiResponse.ViewBag != null &&
                apiResponse.ViewBag.ContainsKey("position") &&
                apiResponse.ViewBag.ContainsKey("nbrPerPage") &&
                apiResponse.ViewBag.ContainsKey("nbrLinks"))
            {
                var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
                var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
                
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            @* <th scope="col">ID</th> *@
                            <th scope="col">Désignation</th>
                            <th scope="col"><center>Actions</center></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var objet in objetsIndisponibilite.OrderByDescending(o => o.IdObjetIndisponibilite))
                        {
                            <tr>
                                @* <td>@objet.IdObjetIndisponibilite</td> *@
                                <td>@objet.Designation</td>
                                <td>
                                    <center>
                                        <MudButton Size="Size.Small"
                                                   @onclick="@(() => HandleUpdate(objet.IdObjetIndisponibilite))"
                                                   Variant="Variant.Filled"
                                                   StartIcon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Warning">
                                        </MudButton>
                                    </center>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadObjetsIndisponibilite(currentPage - 1))">Précédent</a>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadObjetsIndisponibilite(currentPage + 1))">Suivant</a>
                        </li>
                    </ul>
                </nav>

                <center>
                    <p>Page @apiResponse.ViewBag["position"] sur @apiResponse.ViewBag["nbrLinks"]</p>
                </center>
            }
            else
            {
                <p>Informations de pagination indisponibles.</p>
            }
        }
    </div>
</div>

@code {
    private List<ObjetIndisponibiliteDto> objetsIndisponibilite = new List<ObjetIndisponibiliteDto>();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 10;
    private string url = "http://localhost:5077/api/objets-indisponibilite";

    protected override async Task OnInitializedAsync()
    {
        await LoadObjetsIndisponibilite(currentPage);
    }

    private async Task LoadObjetsIndisponibilite(int page)
    {
        currentPage = page;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{url}?position={currentPage}&pageSize={pageSize}", options);
            
            if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Data != null)
            {
                objetsIndisponibilite = apiResponse.Data != null
                    ? JsonSerializer.Deserialize<List<ObjetIndisponibiliteDto>>(
                        apiResponse.Data?.ToString() ?? string.Empty,
                        new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                    ) ?? new List<ObjetIndisponibiliteDto>()
                    : new List<ObjetIndisponibiliteDto>();

                // Tri par ID décroissant pour avoir les plus récents en premier
                objetsIndisponibilite = objetsIndisponibilite.OrderByDescending(o => o.IdObjetIndisponibilite).ToList();

                Console.WriteLine($"Chargement de la page {currentPage}. Enregistrements reçus: {objetsIndisponibilite.Count}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des objets d'indisponibilité : {ex.Message}");
        }
    }

    private async Task HandleObjetIndisponibiliteCreated()
    {
        // Recharger la première page pour voir le nouvel objet
        await LoadObjetsIndisponibilite(1);
    }

    private void HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/objets-indisponibilite/edit/{id}");
    }
}