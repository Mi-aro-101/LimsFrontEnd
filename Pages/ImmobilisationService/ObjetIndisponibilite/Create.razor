@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Immobilisation
@using LimsUtils.Api

<div class="card border-dark mb-3" style="max-width: 39rem;">
  <div class="card-header">Créer un Objet d'Indisponibilité</div>
  <div class="card-body text-dark">
    <EditForm Model="@objetIndisponibilite" OnValidSubmit="@HandleOnSubmit">
      <DataAnnotationsValidator />
      <div class="form-group row">
          <label class="col-sm-3 col-form-label">Désignation</label>
          <div class="col-sm-9">
              <InputText class="form-control" @bind-Value="objetIndisponibilite.Designation" placeholder="Désignation" />
              @if (!string.IsNullOrEmpty(designationError))
              {
                  <div class="text-danger">@designationError</div>
              }
          </div>
      </div>
      <br />
      <center>
          <button type="submit" class="btn btn-primary">Créer</button>
      </center>
    </EditForm>
  </div>
</div>

@code {
    private ObjetIndisponibiliteDto objetIndisponibilite = new();
    private string url = "http://localhost:5077/api/objets-indisponibilite";
    private string? designationError;

    [Parameter]
    public EventCallback OnObjetIndisponibiliteCreated { get; set; }

    private async Task HandleOnSubmit()
    {
        designationError = null;

        if (string.IsNullOrWhiteSpace(objetIndisponibilite.Designation))
        {
            designationError = "Veuillez saisir une désignation.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync(url, objetIndisponibilite);
            response.EnsureSuccessStatusCode();
            
            if (OnObjetIndisponibiliteCreated.HasDelegate)
                await OnObjetIndisponibiliteCreated.InvokeAsync();
            else
                Console.WriteLine("Aucun delegate assigné à l'événement OnObjetIndisponibiliteCreated");
            
            objetIndisponibilite = new ObjetIndisponibiliteDto(); // Réinitialiser le formulaire
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception : " + ex.Message);
        }
    }
}