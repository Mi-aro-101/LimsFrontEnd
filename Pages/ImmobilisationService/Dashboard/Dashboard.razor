@page "/dashboard"
@inject HttpClient Http
@inject IJSRuntime JS
@using MudBlazor
@using System.Text.Json
@using LimsUtils.Api

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">Dashboard des Dépenses</MudText>
    
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudTextField Label="Entrez l'année" @bind-Value="anneeInput" Variant="Variant.Outlined" Immediate="true" 
                         Validation="@(new Func<string, IEnumerable<string>>(ValidateYear))"/>
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ChargerDonnees" Disabled="@(!isYearValid)">Afficher</MudButton>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 ma-4" Elevation="5">
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField Label="Dépenses Total Année" Variant="Variant.Outlined" ReadOnly="true" 
                             Value="@($"{totalGeneral:N2} Ar")" Class="text-bold"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField Label="Dépenses Outillages" Variant="Variant.Outlined" ReadOnly="true" 
                             Value="@($"{totalOutillages:N2} Ar")" Color="Color.Secondary"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField Label="Dépenses Immobilisations" Variant="Variant.Outlined" ReadOnly="true" 
                             Value="@($"{totalImmobilisations:N2} Ar")" Color="Color.Tertiary"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField Label="Dépenses Réactifs" Variant="Variant.Outlined" ReadOnly="true" 
                             Value="@($"{totalReactifs:N2} Ar")" Color="Color.Info"/>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <div id="dashboardDiv" style="width:100%;height:500px;">
        @if (isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" 
                               Style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);" />
        }
    </div>
</MudContainer>

@code {
    private string anneeInput = DateTime.Now.Year.ToString();
    private int annee = DateTime.Now.Year;
    private bool isLoading = false;
    private bool isYearValid = true;
    
    // Totaux
    private decimal totalGeneral;
    private decimal totalOutillages;
    private decimal totalImmobilisations;
    private decimal totalReactifs;

    private IEnumerable<string> ValidateYear(string value)
    {
        if (int.TryParse(value, out int year) && year >= 2000 && year <= DateTime.Now.Year)
        {
            isYearValid = true;
            return Array.Empty<string>();
        }
        isYearValid = false;
        return new[] { "Année invalide (2000-" + DateTime.Now.Year + ")" };
    }

    protected override async Task OnInitializedAsync()
    {
        await ChargerDonnees();
    }

    private async Task ChargerDonnees()
    {
        if (!int.TryParse(anneeInput, out annee) || annee < 2000 || annee > DateTime.Now.Year)
        {
            await JS.InvokeVoidAsync("alert", "Veuillez entrer une année valide");
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            // Attendre que la fonction afficherDashboard soit disponible
            bool isFunctionAvailable = false;
            for (int i = 0; i < 10; i++)
            {
                isFunctionAvailable = await JS.InvokeAsync<bool>("eval", "typeof window.afficherDashboard === 'function'");
                if (isFunctionAvailable)
                    break;
                await Task.Delay(500);
            }

            if (!isFunctionAvailable)
            {
                throw new Exception("La fonction afficherDashboard n'est pas disponible après plusieurs tentatives.");
            }

            // Récupérer les données
            var responseImmobilisations = await Http.GetFromJsonAsync<ApiResponse>($"/api/entree-immobilisations/depenses/mois/{annee}");
            var responseReactifs = await Http.GetFromJsonAsync<ApiResponse>($"/api/entree-reactifs/depenses/mois/{annee}");
            var responseOutillages = await Http.GetFromJsonAsync<ApiResponse>($"/api/entree-outillages/depenses/mois/{annee}");

            // Log des réponses brutes
            await JS.InvokeVoidAsync("console.log", "Response Immobilisations:", JsonSerializer.Serialize(responseImmobilisations));
            await JS.InvokeVoidAsync("console.log", "Response Réactifs:", JsonSerializer.Serialize(responseReactifs));
            await JS.InvokeVoidAsync("console.log", "Response Outillages:", JsonSerializer.Serialize(responseOutillages));

            // Convertir manuellement les données en Dictionary<string, decimal>
            var depensesImmobilisations = ConvertToDictionary(responseImmobilisations?.Data);
            var depensesReactifs = ConvertToDictionary(responseReactifs?.Data);
            var depensesOutillages = ConvertToDictionary(responseOutillages?.Data);

            // Log des dictionnaires extraits
            await JS.InvokeVoidAsync("console.log", "Dépenses Immobilisations:", depensesImmobilisations);
            await JS.InvokeVoidAsync("console.log", "Dépenses Réactifs:", depensesReactifs);
            await JS.InvokeVoidAsync("console.log", "Dépenses Outillages:", depensesOutillages);

            var mois = new List<string>();
            var depImm = new List<decimal>();
            var depRea = new List<decimal>();
            var depOut = new List<decimal>();

            for (int m = 1; m <= 12; m++)
            {
                string periode = $"{annee}-{m:D2}";
                mois.Add(System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(m));
                depImm.Add(depensesImmobilisations?.ContainsKey(periode) == true ? depensesImmobilisations[periode] : 0);
                depRea.Add(depensesReactifs?.ContainsKey(periode) == true ? depensesReactifs[periode] : 0);
                depOut.Add(depensesOutillages?.ContainsKey(periode) == true ? depensesOutillages[periode] : 0);
            }

            // Calcul des totaux annuels
            totalOutillages = depensesOutillages?.Values.Sum() ?? 0;
            totalImmobilisations = depensesImmobilisations?.Values.Sum() ?? 0;
            totalReactifs = depensesReactifs?.Values.Sum() ?? 0;
            totalGeneral = totalOutillages + totalImmobilisations + totalReactifs;

            await JS.InvokeVoidAsync("afficherDashboard", mois, depImm, depRea, depOut, $"Dépenses pour l'année {annee}");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erreur lors du chargement des données : {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await Task.Delay(100);
            StateHasChanged();
        }
    }

    private Dictionary<string, decimal> ConvertToDictionary(object data)
    {
        if (data == null)
            return new Dictionary<string, decimal>();

        if (data is Dictionary<string, decimal> dict)
            return dict;

        if (data is Dictionary<string, object> objDict)
        {
            return objDict.ToDictionary(
                kvp => kvp.Key,
                kvp => Convert.ToDecimal(kvp.Value)
            );
        }

        if (data is JsonElement jsonElement && jsonElement.ValueKind == JsonValueKind.Object)
        {
            var resultDict = new Dictionary<string, decimal>();
            foreach (var property in jsonElement.EnumerateObject())
            {
                resultDict[property.Name] = property.Value.GetDecimal();
            }
            return resultDict;
        }

        return new Dictionary<string, decimal>();
    }

    public class ApiResponse
    {
        public object Data { get; set; }
        public bool IsSuccess { get; set; }
        public string Message { get; set; }
        public int StatusCode { get; set; }
    }
}