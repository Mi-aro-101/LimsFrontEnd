@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using System.Text.Json
@using LimsFrontEnd.Models.Immobilisation
@using LimsUtils.Api
@using System.Linq

<div class="container">
    <div class="row">
        <!-- Colonne pour le formulaire -->
        <div class="col-md-6">
            <Create OnReportImmobilisationCreated="HandleReportImmobilisationCreated" />
        </div>
        <!-- Colonne pour la liste -->
        <div class="col-md-6">
            @if (reportImmobilisations == null || reportImmobilisations.Count == 0)
            {
                <p><em>Aucun inventaire d'immobilisation disponible</em></p>
            }
            else
            {
                if (apiResponse != null && apiResponse.ViewBag != null &&
                    apiResponse.ViewBag.ContainsKey("position") &&
                    apiResponse.ViewBag.ContainsKey("nbrPerPage") &&
                    apiResponse.ViewBag.ContainsKey("nbrLinks"))
                {
                    var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
                    var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th scope="col">Date d'inventaire</th>
                                <th scope="col">Quantité</th>
                                <th scope="col">Immobilisation</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in reportImmobilisations)
                            {
                                <tr>
                                    <td>@report.DateReport.ToShortDateString()</td>
                                    <td>@report.Quantite</td>
                                    <td>@(report.Immobilisation != null ? report.Immobilisation.Designation : "N/A")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadReportImmobilisations(currentPage - 1))">Précédent</a>
                            </li>
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadReportImmobilisations(currentPage + 1))">Suivant</a>
                            </li>
                        </ul>
                    </nav>

                    <center>
                        <p>Page @apiResponse.ViewBag["position"] sur @apiResponse.ViewBag["nbrLinks"]</p>
                    </center>
                }
                else
                {
                    <p>Informations de pagination indisponibles.</p>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<ReportImmobilisationDto> reportImmobilisations = new();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 5;
    private string reportImmobilisationUrl = "http://localhost:5077/api/report-immobilisation";

    protected override async Task OnInitializedAsync()
    {
        await LoadReportImmobilisations(currentPage);
    }

    private async Task LoadReportImmobilisations(int page)
    {
        if (page < 1) page = 1;
        currentPage = page;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{reportImmobilisationUrl}?position={currentPage}&pageSize={pageSize}", options);
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                reportImmobilisations = JsonSerializer.Deserialize<List<ReportImmobilisationDto>>(
                    apiResponse.Data.ToString(),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new List<ReportImmobilisationDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des rapports d'immobilisation : {ex.Message}");
        }
        StateHasChanged();
    }

    private async Task HandleReportImmobilisationCreated()
    {
        await LoadReportImmobilisations(currentPage);
    }
}