@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using System.Text.Json
@using LimsFrontEnd.Models.Immobilisation
@using LimsUtils.Api
@using System.Linq

<style>
    .bordered-cell-one {
        border-right: none;
        text-align: center;
    }

    .bordered-cell-two {
        border-left: none;
        text-align: center;
    }
</style>

<div class="row">
    <!-- Colonne de création -->
    <div class="col">
        <Create OnImmobilisationCreated="HandleImmobilisationCreated" />
    </div>

    <!-- Colonne de la liste -->
    <div class="col">
        @if (immobilisations == null || immobilisations.Count == 0)
        {
            <p><em>Aucune immobilisation disponible</em></p>
        }
        else
        {
            if (apiResponse != null && apiResponse.ViewBag != null &&
            apiResponse.ViewBag.ContainsKey("position") &&
            apiResponse.ViewBag.ContainsKey("nbrPerPage") &&
            apiResponse.ViewBag.ContainsKey("nbrLinks"))
            {
                var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
                var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">Code</th>
                            <th scope="col">Désignation</th>
                            <th scope="col">Marque</th>
                            <th scope="col"><center>Actions</center></th>
                        </tr>
                    </thead>
<tbody>
    @foreach (var imm in immobilisations)
    {
        <tr>
            <td>@imm.Reference</td>
            <td>@imm.Designation</td>
            <td>
                @{
                    // Recherche du nom de la marque dans la liste allMarques
                    var marque = allMarques.FirstOrDefault(m => m.IdMarque == imm.IdMarque);
                }
                @((marque != null) ? marque.Designation : "N/A")
            </td>
            <td>
                <center>
                    <MudButton Size="Size.Small" 
                               @onclick="@(() => HandleUpdate(imm.IdImmobilisation))" 
                               Variant="Variant.Filled" 
                               StartIcon="@Icons.Material.Filled.Edit" 
                               Color="Color.Warning">
                    </MudButton>
                </center>
            </td>
        </tr>
    }
</tbody>
                </table>

                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadImmobilisations(currentPage - 1))">Précédent</a>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadImmobilisations(currentPage + 1))">Suivant</a>
                        </li>
                    </ul>
                </nav>

                <center>
                    <p>Page @apiResponse.ViewBag["position"] sur @apiResponse.ViewBag["nbrLinks"]</p>
                </center>
            }
            else
            {
                <p>Informations de pagination indisponibles.</p>
            }
        }
    </div>
</div>

@code {
    private List<ImmobilisationDto> immobilisations = new List<ImmobilisationDto>();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 10;
    string url = "http://localhost:5077/api/immobilisation";

    // Nouvelle liste pour stocker toutes les marques
    private List<MarqueDto> allMarques = new List<MarqueDto>();

    protected override async Task OnInitializedAsync()
    {
        await LoadImmobilisations(currentPage);
        await LoadAllMarques();
    } 

    
    private async Task LoadImmobilisations(int page)
{
    currentPage = page;
    try
    {
        var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
        apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{url}?position={currentPage}&pageSize={pageSize}", options);
        if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Data != null)
        {
            // Désérialisation explicite de Data en List<ImmobilisationDto>
            immobilisations = JsonSerializer.Deserialize<List<ImmobilisationDto>>(
                apiResponse.Data?.ToString() ?? string.Empty,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
            ) ?? new List<ImmobilisationDto>();

            Console.WriteLine($"Chargement de la page {currentPage}. Enregistrements reçus: {immobilisations.Count}");
        }
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Erreur lors du chargement des immobilisations : {ex.Message}");
    }
}


    private async Task LoadAllMarques()
    {
        try
        {
            var apiResponseMarques = await Http.GetFromJsonAsync<ApiResponse>("http://localhost:5077/api/marque");
            if (apiResponseMarques != null && apiResponseMarques.IsSuccess && apiResponseMarques.Data != null)
            {
                var jsonData = apiResponseMarques.Data.ToString();
                allMarques = !string.IsNullOrEmpty(jsonData) 
                    ? JsonSerializer.Deserialize<List<MarqueDto>>(jsonData, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) 
                    ?? new List<MarqueDto>() 
                    : new List<MarqueDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des marques : {ex.Message}");
        }
    }

    private async Task HandleImmobilisationCreated()
    {
        // Recharge la liste après création d'une nouvelle immobilisation
        await LoadImmobilisations(currentPage);
    }

    private void HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/immobilisation/edit/{id}");
    }
}
