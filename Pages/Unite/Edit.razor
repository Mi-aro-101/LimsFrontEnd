@page "/unites/edit/{Id:int}"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Reactif
@using LimsUtils.Api

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-dark mb-3">
                <div class="card-header text-center">Modifier l'Unité</div>
                <div class="card-body text-dark">
                    @if (unite == null)
                    {
                        <p>Chargement...</p>
                    }
                    else
                    {
                        <EditForm Model="@unite" OnValidSubmit="@HandleOnSubmit">
                            <DataAnnotationsValidator />
                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Désignation</label>
                                <div class="col-sm-9">
                                    <InputText class="form-control" @bind-Value="unite.Designation" />
                                </div>
                            </div>
                            <br />
                            <center>
                                <button type="submit" class="btn btn-primary">Enregistrer</button>
                            </center>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }
    private UniteDto unite;
    // URL du BFF pour les unités
    private string url = "http://localhost:5077/api/unites";

    protected override async Task OnInitializedAsync()
    {
        await LoadUnite();
    }

    private async Task LoadUnite()
    {
        try
        {
            var response = await Http.GetAsync($"{url}/{Id}");
            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var apiResponse = JsonSerializer.Deserialize<ApiResponse>(jsonString,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Data != null)
                {
                    if (apiResponse.Data is JsonElement element)
                    {
                        unite = JsonSerializer.Deserialize<UniteDto>(element.GetRawText(),
                            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    }
                    else
                    {
                        unite = JsonSerializer.Deserialize<UniteDto>(apiResponse.Data.ToString(),
                            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement de l'unité : {ex.Message}");
        }
    }

    private async Task HandleOnSubmit()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"{url}/{unite.IdUnite}", unite);
            response.EnsureSuccessStatusCode();
            NavigationManager.NavigateTo("/unites");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la mise à jour : {ex.Message}");
        }
    }
}
