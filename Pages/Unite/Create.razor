@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Reactif
@using LimsUtils.Api

<div class="card border-dark mb-3" style="max-width: 39rem;">
    <div class="card-header">Créer une Unité</div>
    <div class="card-body text-dark">
        <EditForm Model="@unite" OnValidSubmit="@HandleOnSubmit">
            <DataAnnotationsValidator />
            <div class="form-group row">
                <label class="col-sm-3 col-form-label">Désignation</label>
                <div class="col-sm-9">
                    <InputText class="form-control" @bind-Value="unite.Designation" placeholder="Désignation" />
                </div>
            </div>
            <br />
            <center>
                <button type="submit" class="btn btn-primary">Créer</button>
            </center>
        </EditForm>
    </div>
</div>

@code {
    private UniteDto unite = new();
    // URL du BFF pour les unités
    private string url = "http://localhost:5077/api/unites";

    [Parameter]
    public EventCallback OnUniteCreated { get; set; }

    private async Task HandleOnSubmit()
    {
        try
        {
            var response = await Http.PostAsJsonAsync(url, unite);
            response.EnsureSuccessStatusCode();
            if (OnUniteCreated.HasDelegate)
                await OnUniteCreated.InvokeAsync();
            else
                Console.WriteLine("Aucun delegate assigné à l'événement OnUniteCreated");
            // Réinitialiser le formulaire
            unite = new UniteDto();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception : " + ex.Message);
        }
    }
}
