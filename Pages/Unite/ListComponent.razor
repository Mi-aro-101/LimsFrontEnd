@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Reactif
@using LimsUtils.Api
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using MudBlazor


<div class="row">
    <!-- Colonne de création (6 colonnes sur 12) -->
    <div class="col-md-6">
        <Create OnUniteCreated="HandleUniteCreated" />
    </div>

    <!-- Colonne de la liste (6 colonnes sur 12) -->
    <div class="col-md-6">
        @if (unites == null)
        {
            <p>Chargement...</p>
        }
        else if (unites.Count == 0)
        {
            <p><em>Aucune unité disponible</em></p>
        }
        else
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Désignation</th>
                        <th><center>Actions</center></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in unites.OrderBy(u => u.IdUnite))
                    {
                        <tr>
                            <td>@u.IdUnite</td>
                            <td>@u.Designation</td>
                            <td>
                                <center>
                                    <button class="btn btn-warning btn-sm" @onclick="() => HandleUpdate(u.IdUnite)">
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" />
                                    </button>


                                </center>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<UniteDto> unites = new();
    // URL du BFF pour les unités
    private string url = "http://localhost:5077/api/unites";

    protected override async Task OnInitializedAsync()
    {
        await LoadUnites();
    }

    private async Task LoadUnites()
    {
        try
        {
            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var apiResponse = JsonSerializer.Deserialize<ApiResponse>(jsonString,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Data != null)
                {
                    if (apiResponse.Data is JsonElement element)
                    {
                        unites = JsonSerializer.Deserialize<List<UniteDto>>(element.GetRawText(),
                            new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<UniteDto>();
                    }
                    else
                    {
                        unites = JsonSerializer.Deserialize<List<UniteDto>>(apiResponse.Data.ToString(),
                            new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<UniteDto>();
                    }
                }
                else
                {
                    unites = new List<UniteDto>();
                }
            }
            else
            {
                Console.WriteLine("Erreur HTTP: " + response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erreur lors du chargement des unités : " + ex.Message);
        }
    }

    private async Task HandleUniteCreated()
    {
        await LoadUnites();
    }

    private void HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/unites/edit/{id}");
    }
}
