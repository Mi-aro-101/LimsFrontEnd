@page "/etat/decompte/pdf/{Id:int}"

@inject IJSRuntime JSRuntime
@inject HttpClient Http

<MudButton OnClick="DownloadPdf">Download PDF</MudButton>


<script>
    function openPdf(dataUri) {
        var newTab = window.open();
        newTab.document.write('<iframe src="' + dataUri + '" style="width:100%;height:100%;" frameborder="0"></iframe>');
    }
</script>

@code
{
    [Parameter]
    public int Id { get; set; }

    private async Task DownloadPdf()
    {
        var response = await Http.PostAsJsonAsync($"prestation/etat/decompte/{Id}", Id);

        if (response.IsSuccessStatusCode)
        {
            var pdfBytes = await response.Content.ReadAsByteArrayAsync();
            var base64Pdf = Convert.ToBase64String(pdfBytes);
            var dataUri = "data:application/pdf;base64," + base64Pdf;
            await JSRuntime.InvokeVoidAsync("openPdf", dataUri);
        }
    }
}