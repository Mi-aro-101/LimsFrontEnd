@inject IJSRuntime JSRuntime
@inject HttpClient Http

<MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="DownloadPdf">Générer</MudButton>


<script>
    function openPdf(dataUri) {
        var newTab = window.open();
        newTab.document.write('<iframe src="' + dataUri + '" style="width:100%;height:100%;" frameborder="0"></iframe>');
    }
    function confirmAction(message) {
        return confirm(message);
    }
</script>

@code
{
    [Parameter]
    public int Id { get; set; }

    private async Task DownloadPdf()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirmAction", "Êtes-vous sûr de vouloir générer un nouveau QR code pour l'échantillon ?");

        if (confirmed)
        {
            var response = await Http.PostAsJsonAsync($"echantillon/qr/{Id}", Id);

            if (response.IsSuccessStatusCode)
            {
                var pdfBytes = await response.Content.ReadAsByteArrayAsync();
                var base64Pdf = Convert.ToBase64String(pdfBytes);
                var dataUri = "data:application/pdf;base64," + base64Pdf;
                await JSRuntime.InvokeVoidAsync("openPdf", dataUri);
            }
        }
    }
}