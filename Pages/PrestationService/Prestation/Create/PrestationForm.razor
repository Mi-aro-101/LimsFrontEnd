@page "/prestation-form"

@using LimsFrontEnd.Models
@using System.Text.Json
@using LimsUtils.Api
@using LimsUtils.Utility
@inject HttpClient Http
@inject NavigationManager Navigation

<PrestationStepForm OnSubmit="@HandleSubmit" />

@code
{
    private CreatePrestationDto? prestation;

    private async void HandleSubmit(CreatePrestationDto? createPrestationDto)
    {

        prestation = createPrestationDto;
        prestation.IdClient = createPrestationDto.Client.IdClient;
        try
        {
            Console.WriteLine("ooooooo : " + JsonSerializer.Serialize(prestation));
            var response = await Http.PostAsJsonAsync("prestation", prestation);
            response.EnsureSuccessStatusCode(); // Throw if not successful
            using var responseStream = await response.Content.ReadAsStreamAsync();
            ApiResponse? apiResponse = await JsonSerializer.DeserializeAsync<ApiResponse>(responseStream);
            apiResponse.HandleResponse<PrestationDto>();
            PrestationDto? createdPrestation = (PrestationDto?)apiResponse.Data;
            Navigation.NavigateTo("/prestation/details/" + createdPrestation?.IdPrestation, true);
            // Optionally handle the response (e.g., show a success message)
        }
        catch(Exception ex)
        {
            Console.WriteLine("Exception : " +ex.Message);
        }
        Console.WriteLine(JsonSerializer.Serialize(prestation));
    }
}