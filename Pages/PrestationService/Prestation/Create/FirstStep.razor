@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager


@if(!string.IsNullOrEmpty(exception))
{
    <div class="alert alert-danger">
        @exception
    </div>
}
else
{
    <center><h4>Client</h4></center>
    <hr>
    <RowTemplate>
        <MudTd DataLabel="Description">
            <MudAutocomplete T="ClientDto"
                    @bind-Value="Prestation.Client"
                    SearchFunc="SearchClients"
                    ToStringFunc="client => client?.Nom ?? string.Empty"
                    Label="Client"
                    Variant="Variant.Filled"
                    Clearable="true"
                    Dense="true"
                    MaxItems="5"
                    DebounceInterval="200" />
        </MudTd>
        <MudTd DataLabel="Submit">
            <MudButton Color="Color.Dark" Size="Size.Small" Variant="Variant.Text" @onclick="NouveauClient" >Nouveau client</MudButton>
        </MudTd>
    </RowTemplate>
}


@code
{
    [Parameter]
    public CreatePrestationDto Prestation { get; set; } = new CreatePrestationDto();
    private ICollection<ClientDto> clients = new List<ClientDto>();
    string exception = "";
    ClientDto selectedClient;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine(JsonSerializer.Serialize(Prestation));
        await LoadClients();
        Prestation.IdClient = clients.First().IdClient;
        StateHasChanged();
    }

    private async Task<IEnumerable<ClientDto>> SearchClients(string value, CancellationToken cancellationToken)
    {
        List<ClientDto> result = new List<ClientDto>();

        ApiResponse? apiResponse;
        var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
        apiResponse = await Http.GetFromJsonAsync<ApiResponse>("client/search?searchTerm=" + value);
        if(apiResponse?.IsSuccess == true)
        {
            apiResponse.HandleResponse<List<ClientDto>>();
            if(apiResponse.Data is List<ClientDto>)
            {
                result = (List<ClientDto>)apiResponse.Data;
            }
            else
            {
                exception = "Pas de datas reçus";
            }
        }
        else{
            if(string.IsNullOrEmpty(apiResponse?.Message))
            {
                exception = "Une erreur est survenue";
            }
            else
            {
                exception = (string)apiResponse.Message;
            }
        }

        return result;
    }

    private async Task LoadClients()
    {
        ApiResponse? apiResponse;
        var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
        apiResponse = await Http.GetFromJsonAsync<ApiResponse>("client");
        if(apiResponse?.IsSuccess == true)
        {
            apiResponse.HandleResponse<List<ClientDto>>();
            if(apiResponse.Data is List<ClientDto>)
            {
                clients = (List<ClientDto>)apiResponse.Data;
            }
            else
            {
                exception = "Pas de datas reçus";
            }
        }
        else{
            if(string.IsNullOrEmpty(apiResponse?.Message))
            {
                exception = "Une erreur est survenue";
            }
            else
            {
                exception = (string)apiResponse.Message;
            }
        }
    }

    private void NouveauClient()
    {
        NavigationManager.NavigateTo("/client/nouveau");
    }

}