@page "/prestation"

@using System.Net.Http.Json
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using LimsUtils.Utility
@using System.Text.Json
@using System.Globalization;
@using Component.Prestation;
@inject NavigationManager NavigationManager
@inject HttpClient Http

@* <SortComponent /> *@
<style>
    .chiffre{
        text-align: right;
    }
    tr:hover{
        cursor: pointer;
    }
</style>

<center><h2>Liste des prestations</h2></center>
<hr>

<SortComponent Reload="@LoadPrestations"/>

<hr>

<div class="col">
    @if (!string.IsNullOrEmpty(exception))
    {
        <p><em>@exception</em></p>
    }
    else
    {
        <MudTable Items="@Elements" Dense="@dense" Hover="@hover" Bordered="@bordered" Striped="@striped" T="VPrestationEtatDecompteDto" OnRowClick="NavigateTo">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Prestations</MudText>
                <MudSpacer />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Réf</MudTh>
                <MudTh>Date</MudTh>
                <MudTh>Montant</MudTh>
                <MudTh>Remise (%)</MudTh>
                <MudTh>Montant total</MudTh>
                <MudTh>Etat</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Ref">@context.Reference</MudTd>
                <MudTd DataLabel="Date">@ViewUtils.RenderDateAsFrenchFormat(context.DatePrestation)</MudTd>
                <MudTd Class="chiffre" DataLabel="Montant">@ViewUtils.RenderMoney(context.Montant)</MudTd>
                <MudTd Class="chiffre" DataLabel="Remise (%)">@context.Remise</MudTd>
                <MudTd Class="chiffre" DataLabel="Montant total">@ViewUtils.RenderMoney(context.MontantTotal)</MudTd>
                @if(@context.DesignationEtat == "livrable")
                {
                    <MudTd DataLabel="Etat"> <Livraison Reload="LoadPrestations" IdPrestation="@context.IdPrestation" /> </MudTd>
                }else{
                    <MudTd DataLabel="Etat">@context.DesignationEtat</MudTd>
                }
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>

        <div class="d-flex flex-wrap mt-4">
            <MudSwitch @bind-Value="hover" Color="Color.Primary">Hover</MudSwitch>
            <MudSwitch @bind-Value="bordered" Color="Color.Warning">Bordures</MudSwitch>
            <MudSpacer />
        </div>
    }
</div>

@code
{

    private bool dense = false;
    private bool hover = true;
    private bool striped = false;
    private bool bordered = true;
    private string searchString1 = "";
    private VPrestationEtatDecompteDto selectedItem1 = null;
    private HashSet<VPrestationEtatDecompteDto> selectedItems = new HashSet<VPrestationEtatDecompteDto>();

    private IEnumerable<VPrestationEtatDecompteDto> Elements = new List<VPrestationEtatDecompteDto>();

    string exception = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadPrestations();
    }

    private async Task LoadPrestations(SortPrestationDto? sorter = null)
    {
        var response = await Http.PostAsJsonAsync("prestation/tri", sorter);
        using var responseStream = await response.Content.ReadAsStreamAsync();
        ApiResponse? apiResponse = await JsonSerializer.DeserializeAsync<ApiResponse>(responseStream);
        
        if(apiResponse?.IsSuccess == true || apiResponse != null)
        {
            apiResponse.HandleResponse<IEnumerable<VPrestationEtatDecompteDto>>();
            if(apiResponse.Data == null)
            {
                exception = "Il n'y a pas de données dans la base";
            }
            else
            {
                Elements = (IEnumerable<VPrestationEtatDecompteDto>)apiResponse.Data;
            }
        }
        else{
            exception = apiResponse?.Message ?? "Une erreur s'est produite lors de la récupération des prestations.";
        }
        StateHasChanged();
    }

    private void NavigateTo(TableRowClickEventArgs<VPrestationEtatDecompteDto> args)
    {
        var idPrestation = args.Item.IdPrestation;
        NavigationManager.NavigateTo($"/prestation/details/{idPrestation}");
    }
}
