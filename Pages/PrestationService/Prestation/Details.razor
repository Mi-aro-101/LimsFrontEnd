@page "/prestation/details/{Id:int}"

@inject HttpClient Http
@using LimsFrontEnd.Models
@using LimsUtils.Utility
@using LimsUtils.Api
@using System.Text.Json;
@using System.Net.Http.Json
@inject NavigationManager NavigationManager

@if(!(string.IsNullOrEmpty(exception)))
{
    <div class="alert alert-danger" role="alert">
        @exception
    </div>
}
@if(prestation == null || prestation.IdPrestation == 0)
{
    <center><div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <p>Veuillez patienter un moment</p><br/></center>
}
else
{

    <center><h2>Prestation n : @prestation.ReferenceFicheTravail</h2></center>
    <hr>
    <div class="row">
    <br>
        <div class="col">
            <div class="card" style="width: 45rem;">
                <div class="card-body">
                        <h3 class="card-title">Prestation</h3>
                        <p class="card-text"><strong> </strong></p>

                        <hr>
                        <p class="card-text">Ref : <strong> @prestation.ReferenceFicheTravail </strong></p>
                        <p class="card-text">Date : <strong> @ViewUtils.RenderDateAsFrenchFormat(prestation.DatePrestation) </strong></p>
                        <p class="card-text">Date de cloture : <strong> @ViewUtils.RenderDateAsFrenchFormat(prestation.DateCloture)</strong></p>
                        <p class="card-text">Statut : <strong> @prestation.EtatPrestation?.Designation </strong></p>
                </div>
            </div>
        </div>
    <br>
        <div class="col">
            <div class="card">
                <div class="card-body">
                        <h3 class="card-title">Documents</h3>
                        <p class="card-text"><strong> </strong></p>

                        <hr>
                        <table class="table">
                        <thead>
                            <th>Lien PDF</th>
                        </thead>
                        <tbody>
                            <tr>
                                <td><EtatDecompte Id="@prestation.IdPrestation"/></td>
                            </tr>
                            <tr>
                                <td><button type="button" class="btn btn-outline-dark">Fiche de travail</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* ----------------------------------------------------------------------------- *@
    <hr>

    <div class="row">
    <br>
        <div class="col">
            <div class="card" style="width: 45rem;">
                <div class="card-body">
                        <h3 class="card-title">Client</h3>
                        <p class="card-text"><strong> </strong></p>

                        <hr>
                        <p class="card-text">Nom : <strong> @prestation.Client?.Nom </strong></p>
                        <p class="card-text">Email : <strong> @prestation.Client?.Email </strong></p>
                        <p class="card-text">Contact : <strong> @prestation.Client?.Contact </strong></p>
                        <p class="card-text">Adresse : <strong> @prestation.Client?.Adresse </strong></p>
                        <p class="card-text">CIN : <strong> @prestation.Client?.Cin </strong></p>
                        <p class="card-text">NifStat : <strong> @prestation.Client?.NifStat </strong></p>
                </div>
            </div>
        </div>
    <br>
        <div class="col">
            <div class="card" style="width: 45rem;">
                <div class="card-body">
                        <h3 class="card-title">Echantillons et travaux</h3>
                        <p class="card-text"><strong> </strong></p>

                        <hr>
                        <table class="table">
                        <thead>
                            <th>Reference</th>
                            <th>Reference du client</th>
                            <th>Travail demandé</th>
                            <th>Tarif du travail</th>
                        </thead>
                        <tbody>
                            @foreach(var details in prestation.PrestationDetails)
                            {
                            <tr>
                                <td>@details.Reference</td>
                                <td>@details.ReferenceClient</td>
                                <td>@details.Designation</td>
                                <td>@details.Tarif</td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code 
{
    [Parameter]
    public int Id { get; set; }
    private readonly string url = "http://localhost:5077/api/";
    private string? exception;
    private PrestationDto prestation = new PrestationDto{
        DatePrestation = DateTime.Now,
        ReferenceFicheTravail = "NULL"
    };

    protected override async Task OnInitializedAsync()
    {
        try{
            await FetchDetails();
        }catch(Exception e)
        {
            Console.WriteLine(e);
            exception = e.Message;
        }
    }

    private async Task FetchDetails()
    {
        HttpResponseMessage response = await Http.GetAsync(url+$"prestation/{Id}");
        using var responseStream = await response.Content.ReadAsStreamAsync();
        ApiResponse? apiResponse = await JsonSerializer.DeserializeAsync<ApiResponse>(responseStream);
        if(apiResponse != null && apiResponse.IsSuccess){
            apiResponse.HandleResponse<PrestationDto>();
            if(apiResponse.Data is PrestationDto)
            {
                prestation = (PrestationDto)apiResponse.Data;
            }
        }
        else{
            exception = await response.Content.ReadAsStringAsync();
        }
    }

    private void DownloadPdf(int id)
    {
        NavigationManager.NavigateTo("/etat/decompte/pdf/"+$"{id}");
    }
}