@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json;
@inject NavigationManager NavigationManager
@using BlazorBootstrap

<div class="card border-dark mb-3" style="max-width: 39rem;">
  <div class="card-header">Nouveau Etat de prestation</div>
  <div class="card-body text-dark">
    <EditForm Model="@etatPrestation" OnValidSubmit="@HandleOnSubmit">
        
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Niveau</label>
            <div class="col-sm-8">
            <InputNumber class="form-control" @bind-Value="etatPrestation.Niveau" placeholder="" />
            </div>
        </div>
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Designation</label>
            <div class="col-sm-8">
            <InputText class="form-control" @bind-Value="etatPrestation.Designation" placeholder="" />
            </div>
        </div>
        <br>
        <center>
            <button type="submit" class="btn btn-primary">Creer</button>
        </center>
    </EditForm>
  </div>
</div>

@code
{
    private EtatPrestationDto etatPrestation = new EtatPrestationDto{
        Designation = ""
    };
    private string url = "http://localhost:5077/api/";
    [Parameter]
    public EventCallback RefreshList { get; set; }


    private async Task HandleOnSubmit()
    {
        try
        {
            var response = await Http.PostAsJsonAsync(url+$"etat/prestation", etatPrestation);
            if(RefreshList.HasDelegate)
            {
                await RefreshList.InvokeAsync();
            }
        }
        catch(Exception ex)
        {
            Console.WriteLine("Exception : " +ex.Message);
        }
    }
}