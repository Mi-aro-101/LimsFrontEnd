@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json;
@inject NavigationManager NavigationManager
@using BlazorBootstrap

<div class="card border-dark mb-3" style="max-width: 39rem;">
  <div class="card-header">Créer un travail</div>
  <div class="card-body text-dark">
    <EditForm Model="@typetravaux" OnValidSubmit="@HandleOnSubmit">
        <div class="form-group row">
            <label for="staticEmail" class="col-sm-2 col-form-label">Code</label>
            <div class="col-sm-8">
            <InputText class="form-control" @bind-Value="typetravaux.Code" placeholder="0000" />
            </div>
        </div>
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Désignation</label>
            <div class="col-sm-8">
            <InputText class="form-control" @bind-Value="typetravaux.Designation" placeholder="" />
            </div>
        </div>
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Tarif dynamique</label>
            <div class="col-sm-8">
            <InputSelect class="form-control" @bind-Value="typetravaux.HaveFormule">
                    <option value=0>Oui</option>
                    <option value=1>Non</option>
            </InputSelect>
            </div>
        </div>
        <br>
            @if (typetravaux.HaveFormule == 0)
            {
                <div class="form-group row">
                    <label class="col-sm-2 col-form-label">Fichier Formule</label>
                    <div class="col-sm-8">
                    <InputFile class="form-control"  OnChange="HandleFileSelected" />
                    </div>
                </div>
            }
            else if (typetravaux.HaveFormule == 1)
            {
                <div class="form-group row">
                    <label class="col-sm-2 col-form-label">Tarif</label>
                    <div class="col-sm-8">
                    <InputNumber class="form-control" @bind-Value="typetravaux.Tarif" />
                    </div>
                </div>
            }
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Date de création</label>
            <div class="col-sm-8">
            <InputDate class="form-control" @bind-Value="typetravaux.DateCreation" />
            </div>
        </div>
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Département</label>
            <div class="col-sm-8">
            <InputSelect class="form-control" @bind-Value="typetravaux.IdDepartement">
                @foreach(DepartementDto departement in Departements)
                {
                    <option value=@departement.IdDepartement>@departement.Designation</option>
                }
            </InputSelect>
            </div>
        </div>
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Résultat</label>
            <div class="col-sm-8">
            <InputSelect class="form-control" @bind-Value="typetravaux.HasResultat">
                    <option value=0>Oui</option>
                    <option value=1>Non</option>
            </InputSelect>
            </div>
        </div>
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Type Echantillon</label>
            <div class="col-sm-8">
                <MudSelect T="int" Label="Type Echantillon" MultiSelection="true" @bind-SelectedValues="typetravaux.IdTypeEchantillons">
                    @foreach (TypeEchantillonDto typeEchantillon in TypeEchantillons)
                    {
                        <MudSelectItem T="int" Value="@typeEchantillon.IdTypeEchantillon">@typeEchantillon.Designation</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </div>
        <br>
        <center>
            <button type="submit" class="btn btn-primary">Créer</button>
        </center>
    </EditForm>
  </div>
</div>

@code
{
    private TypeTravauxDto typetravaux = new TypeTravauxDto{
        Code = "2488",
        Designation ="Analyse des éléments"
    };
    private string url = "http://localhost:5077/api/";
    [Parameter]
    public ICollection<DepartementDto> Departements {  get; set; } = new List<DepartementDto>();
    [Parameter]
    public ICollection<TypeEchantillonDto> TypeEchantillons { get; set; } = new List<TypeEchantillonDto>();
    [Parameter]
    public EventCallback<int?> OnTypeTravauxCreated { get; set; }

    private async Task HandleOnSubmit()
    {
        try
        {
            if(typetravaux.HaveFormule == 0)
            {
                typetravaux.Tarif = null;
            }
            if(typetravaux.IdDepartement == 0) typetravaux.IdDepartement = Departements.ElementAt(4).IdDepartement;
            Console.WriteLine(JsonSerializer.Serialize(typetravaux));
            var response = await Http.PostAsJsonAsync(url+$"type/travaux", typetravaux);
            // Optionally handle the response (e.g., show a success message)
            if(OnTypeTravauxCreated.HasDelegate)
                await OnTypeTravauxCreated.InvokeAsync();

            else
                Console.WriteLine("No delegate for the event");
        }
        catch(Exception ex)
        {
            Console.WriteLine("Exception : " +ex.Message);
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        Console.WriteLine("File selected");
        var file = e.File;
        if (file != null)
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10 MB limit, adjust as needed
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            typetravaux.FormuleBytes = ms.ToArray();
        }
    }
}