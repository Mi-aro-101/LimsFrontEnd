@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json
@inject NavigationManager NavigationManager
@using Microsoft.JSInterop;

<style>
    .bordered-cell-one{
        border-right: none;
        text-align: center;
    }
    .bordered-cell-two{
        border-left: none;
        text-align: center;
    }
    tr:hover{
        cursor: pointer;
    }
    .suggestion-box {
        position: absolute;
        background: white;
        border: 1px solid #ccc;
        border-radius: 4px;
        z-index: 1000;
        width: 100%;
        max-height: 200px;
        overflow-y: auto;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-top: 2px;
    }
    .suggestion-item {
        padding: 8px 12px;
        cursor: pointer;
        transition: background 0.2s;
    }
    .suggestion-item:hover {
        background: #f0f0f0;
    }
</style>

<div style="position:relative;">
    <MudTextField @bind-Value="searchTerm"
                  Placeholder="🔍 Rechercher par code ou désignation..."
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Margin="Margin.Dense"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  OnKeyUp="@(e => OnSearchChanged(e))" />

    @if (searchResults?.Any() == true && !string.IsNullOrWhiteSpace(searchTerm))
    {
        <div class="suggestion-box">
            @foreach (var item in searchResults)
            {
                <div class="suggestion-item" @onclick="() => OnSuggestionClicked(item)">
                    <b>@item.Code</b> - @item.Designation
                </div>
            }
        </div>
    }
</div>

@code {
    private string searchText = "";
    private string searchTerm = string.Empty;
    private TypeTravauxDto[] searchResults = Array.Empty<TypeTravauxDto>();

    private async Task OnSearchChanged(KeyboardEventArgs e)
    {
        Console.WriteLine("SearchTerm: " + searchTerm);
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            try
            {
                var apiresponse = await Http.GetFromJsonAsync<ApiResponse>($"type/travaux/search?search={Uri.EscapeDataString(searchTerm)}");
                apiresponse.HandleResponse<TypeTravauxDto[]>();
                searchResults = (TypeTravauxDto[])apiresponse.Data;
            }
            catch (Exception ex)
            {
                Console.WriteLine("Search error: " + ex.Message);
                searchResults = Array.Empty<TypeTravauxDto>();
            }
        }
        else
        {
            searchResults = Array.Empty<TypeTravauxDto>();
        }
    }

    private void OnSuggestionClicked(TypeTravauxDto item)
    {
        searchTerm = item.Designation;
        searchResults = Array.Empty<TypeTravauxDto>();
        NavigateTo(item.IdTypeTravaux);
    }
}


<div class="col">
    <CreateComponent Departements="departements" TypeEchantillons="typeEchantillons" OnTypeTravauxCreated="@LoadTypeTravaux"/>
</div>

<div class="col">
    @if (typetravaux == null || !string.IsNullOrEmpty(exception))
    {
        <p><em>Pas données à afficher</em></p>
        <p><em>@exception</em></p>
    }
    else
    {
        @if (apiResponse.ViewBag.ContainsKey("position") && apiResponse.ViewBag.ContainsKey("TotalCount") && apiResponse.ViewBag.ContainsKey("nbrPerPage"))
        {

            var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
            var pageSize = int.Parse(apiResponse.ViewBag["nbrPerPage"].ToString());
            var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());

            <table class="table table-bordered table-hover" border="1">
                <thead>
                    <tr>
                        <th scope="col">Code</th>
                        <th scope="col">Designation</th>
                        <th scope="col">PU en Ar</th>
                        <th scope="col"><center>Actions</center></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var typetravail in typetravaux)
                    {
                        <tr @onclick="@(() => NavigateTo(@typetravail.IdTypeTravaux))">
                            <td>@typetravail.Code</td>
                            <td>@typetravail.Designation</td>
                            <td>@(typetravail.Tarif ?? 0)</td>
                            <td class="bordered-cell-one">
                                <MudButton Size="Size.Small" @onclick="@(() => HandleUpdate(@typetravail.IdTypeTravaux))" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" Color="Color.Warning"></MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <nav aria-label="Page navigation">
                <ul class="pagination">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="/type/travaux" @onclick="@(() => LoadTypeTravaux(currentPage - 1))">Précédent</a>
                    </li>

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="/type/travaux" @onclick="@(() => LoadTypeTravaux(currentPage + 1))">Suivant</a>
                    </li>
                </ul>
            </nav>

            <center><p>
                Page @apiResponse.ViewBag["position"] sur
                @apiResponse.ViewBag["nbrLinks"]
            </p></center>
        }
        else
        {
            <p>Information sur la pagination indisponible</p>
        }
    }
</div>

@code {
    private List<TypeTravauxDto>? typetravaux = new List<TypeTravauxDto>();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 3;

    ICollection<DepartementDto> departements = new List<DepartementDto>();
    ICollection<TypeEchantillonDto> typeEchantillons  = new List<TypeEchantillonDto>(); 

    string url = "http://localhost:5077/api/";
    [Inject] IJSRuntime? JSRuntime { get; set; }
    string exception = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadTypeTravaux(currentPage);
            await LoadDepartement();
            await LoadTypeEchantillon();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error on Initializing : {ex.Message}");
        }
    }

    private async Task LoadTypeTravaux(int? activePage)
    {
        if(activePage.HasValue) currentPage = activePage.Value;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+$"type/travaux?position={currentPage}&pageSize={pageSize}", options);
            if(currentPage <= int.Parse(apiResponse.ViewBag["nbrLinks"].ToString())){
                apiResponse.HandleResponse<List<TypeTravauxDto>>();
                typetravaux = (List<TypeTravauxDto>)apiResponse.Data;
            }
            else{
                await LoadTypeTravaux(int.Parse(apiResponse.ViewBag["nbrLinks"].ToString()));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadTypeTravaux: {ex.Message}");
        }
    }

    private async Task HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/type/travaux/{id}");
    }

    private async Task LoadDepartement()
    {
        try
        {
            ApiResponse? apiResponse;
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+"departement/all");
            apiResponse.HandleResponse<List<DepartementDto>>();
            departements = (List<DepartementDto>)apiResponse.Data;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadDepartement {ex.Message}");
        }

    }

    private async Task LoadTypeEchantillon()
    {
        try
        {
            ApiResponse? apiResponse;
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+"type/echantillon/all");
            if(apiResponse?.Data != null && apiResponse != null)
            {
                apiResponse.HandleResponse<List<TypeEchantillonDto>>();
                typeEchantillons = (List<TypeEchantillonDto>)apiResponse.Data;
            }
            else
            {
                exception = "Une erreur s'est produite";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadTypeEchantillon {ex.Message}");
        }

    }

    private void NavigateTo(int IdTypeTravaux)
    {
        NavigationManager.NavigateTo($"/type/travaux/details/{IdTypeTravaux}");
    }
}