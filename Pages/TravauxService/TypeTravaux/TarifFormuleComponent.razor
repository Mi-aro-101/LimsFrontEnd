@using LimsFrontEnd.Models
@using Microsoft.AspNetCore.Components
@using LimsFrontEnd.Utils
@using LimsUtils.Api
@using System.Text.Json
@inject HttpClient Http

    <EditForm Model="@FormuleDesigne" OnValidSubmit="@EvaluateTarif">
            <label for="inputPassword" class="col-sm-2 col-form-label">Tarif dynamique : </label>
            <div class="col-sm-8">
                <InputSelect class="form-control" @bind-Value="FormuleDesigne.FormuleChosed">
                    <option value="">Choisir option</option>
                    @foreach(var condition in FormuleDesigne.ConditionFormula)
                    {
                        <option value="@FormuleDesigne.ConditionFormula[condition.Key]">@condition.Key</option>
                    }
                </InputSelect>
            </div>
        @foreach( var key in FormuleDesigne.Variable.Keys )
        {
            <div key="@key">
            <label for="inputPassword" class="col-sm-2 col-form-label">Valeur de @key : </label>
                <div class="col-sm-8">
                    <InputNumber class="form-control" @bind-Value="FormuleDesigne.Variable[key]" />
                </div>
            </div>
            <br />
        }
        <button type="submit" class="btn btn-primary">Calculer</button>
    </EditForm>
    <br>
    <p>Valeur : <strong> @prix Euro</strong></p>

@code
{
    [Parameter]
    public TypeTravauxDto TypeTravauxDesigne { get; set; }
    [Parameter]
    public Formule FormuleDesigne { get; set;} 
    private string url = "http://localhost:5077/api/type/travaux/tarifier";
    private Formule reponse = new Formule();

    private double? prix;

    private async void EvaluateTarif()
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var response = await Http.PostAsJsonAsync(url+$"/{TypeTravauxDesigne.IdTypeTravaux}", FormuleDesigne);
            using var responseStream = await response.Content.ReadAsStreamAsync();
            ApiResponse? apiResponse = await JsonSerializer.DeserializeAsync<ApiResponse>(responseStream);
            Console.WriteLine(url+$"/{TypeTravauxDesigne.IdTypeTravaux}");
            if(apiResponse?.Data != null && apiResponse != null){
                apiResponse.HandleResponse<Formule>();
                reponse = (Formule)apiResponse.Data;
                Console.WriteLine(JsonSerializer.Serialize(apiResponse));
            }
            prix = reponse.Tarif;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadEmploye {ex.Message}");
        }
    }
}
