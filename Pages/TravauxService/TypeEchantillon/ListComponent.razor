@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json
@inject NavigationManager NavigationManager
@using Microsoft.JSInterop;

<style>
    .bordered-cell-one{
        border-right: none;
        text-align: center;
    }
    .bordered-cell-two{
        border-left: none;
        text-align: center;
    }
    tr:hover{
        cursor: pointer;
    }
</style>
<div class="col">
    <CreateComponent OnTypeEchantillonCreated="@HandleTypeEchantillonCreated" />
</div>

<div class="col">
    @if (typeechantillons == null)
    {
        <p><em>No data on the row</em></p>
    }
    else
    {
        @if (apiResponse.ViewBag.ContainsKey("position") && apiResponse.ViewBag.ContainsKey("TotalCount") && apiResponse.ViewBag.ContainsKey("nbrPerPage"))
        {

            var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
            var pageSize = int.Parse(apiResponse.ViewBag["nbrPerPage"].ToString());
            var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());

            <table class="table table-bordered table-hover" border="1">
                <thead>
                    <tr>
                        <th scope="col">Designation</th>
                        <th scope="col"><center>Actions</center></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var typetravail in typeechantillons)
                    {
                        <tr>
                            <td>@typetravail.Designation</td>
                            <td class="bordered-cell-one">
                                <MudButton Size="Size.Small" @onclick="@(() => HandleUpdate(@typetravail.IdTypeEchantillon))" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" Color="Color.Warning"></MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <nav aria-label="Page navigation">
                <ul class="pagination">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="/type/echantillon" @onclick="@(() => LoadTypeEchantillon(currentPage - 1))">Précédent</a>
                    </li>

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="/type/echantillon" @onclick="@(() => LoadTypeEchantillon(currentPage + 1))">Suivant</a>
                    </li>
                </ul>
            </nav>

            <center><p>
                Page @apiResponse.ViewBag["position"] sur
                @apiResponse.ViewBag["nbrLinks"]
            </p></center>
        }
        else
        {
            <p>Information sur la pagination indisponible</p>
        }
    }
</div>

@code {
    private List<TypeEchantillonDto>? typeechantillons = new List<TypeEchantillonDto>();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 3;


    string url = "http://localhost:5077/api/";
    [Inject] IJSRuntime? JSRuntime { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadTypeEchantillon(currentPage);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error on Initializing : {ex.Message}");
        }
    }
    private async Task HandleTypeEchantillonCreated() // The callback handler
    {
        int pageLoaded = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
        int elementNumberOnLastPage = typeechantillons.Count;
        if(elementNumberOnLastPage == pageSize)
            pageLoaded = pageLoaded + 1;
        await LoadTypeEchantillon(pageLoaded);
    }

    private async Task LoadTypeEchantillon(int? activePage)
    {
        if(activePage.HasValue) currentPage = activePage.Value;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+$"type/echantillon?position={currentPage}&pageSize={pageSize}", options);
            if(currentPage <= int.Parse(apiResponse.ViewBag["nbrLinks"].ToString())){
                apiResponse.HandleResponse<List<TypeEchantillonDto>>();
                typeechantillons = (List<TypeEchantillonDto>)apiResponse.Data;
            }
            else{
                await LoadTypeEchantillon(int.Parse(apiResponse.ViewBag["nbrLinks"].ToString()));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadTypeEchantillon: {ex.Message}");
        }
    }

    private void HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/type/echantillon/{id}");
    }

}