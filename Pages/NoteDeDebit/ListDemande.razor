@page "/demandenotedebit/liste"

@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json
@inject HttpClient http

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h2" Class="mb-4">Liste des demandes</MudText>

    <MudTextField @bind-Value="searchText" Label="Recherche" Placeholder="Référence de l'état de décompte ou objet" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" />

    <MudTable Items="FilteredData" Dense="true" Hover="true" FixedHeader="true" Height="300px">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Demande note de débit</MudText>
            </ToolBarContent>

            <HeaderContent>
                <MudTh> N° </MudTh>
                <MudTh> Réference </MudTh>
                <MudTh> Date de la demande </MudTh>
                <MudTh> Objet </MudTh>
                <MudTh> Montant (Ar) </MudTh>
                <MudTh> Réference de l'état de décompte </MudTh>
                <MudTh> Date de l'état de décompte </MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd> @context.idEtatDecompte </MudTd>
                <MudTd> @context.reference </MudTd>
                <MudTd> @(context.dateDemande?.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("fr-FR")) ?? "N/A") </MudTd>
                <MudTd> @context.objet </MudTd>
                <MudTd> @context.montant </MudTd>
                <MudTd> @context.referenceEtatDecompte </MudTd>
                <MudTd> @(context.dateEtatDecompte?.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("fr-FR")) ?? "N/A") </MudTd>
            </RowTemplate>
        </MudTable>

    <MudPaper Class="pa-3 mt-4" Elevation="4">
        <MudText Typo="Typo.h6">Somme Actuel : <b>@FilteredData.Sum(x => x.montant).ToString("F2") Ar</b></MudText>
    </MudPaper>
</MudPaper>

@code {
    private string searchText = "";

    private List<DemandeDto> demandeNotes = new List<DemandeDto>();
    private ApiResponse? apiResponse;
    string url = "http://localhost:5077/api/notedebit";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var option = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await http.GetFromJsonAsync<ApiResponse>($"{url}/allliste", option);
            apiResponse.HandleResponse<List<DemandeDto>>();
            demandeNotes = apiResponse.Data as List<DemandeDto> ?? new List<DemandeDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception: " + ex.Message);
        }
    }

    private List<DemandeDto> FilteredData
    {
        get
        {
            return demandeNotes
        .Where(x => string.IsNullOrWhiteSpace(searchText) ||
                x.objet.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                x.referenceEtatDecompte.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .ToList();
        }
    }    
}