<MudItem Class="pa-4">
    <MudForm Model="@demandeNote" @ref="reference">
        <MudGrid>
            <MudItem xs="12">
                <MudTextField T="string" Label="Clients" @bind-Value="demandeNote.clients" Required="true" Variant="Variant.Text" Margin="Margin.Dense" HelperText="Particulier ou Entreprise" HelperTextOnFocus="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Identité" @bind-Value="demandeNote.identite" Required="true" Variant="Variant.Text" Margin="Margin.Dense" HelperText="CIN ou NIF/STAT ou Passeport" HelperTextOnFocus="true" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField T="string" Label="Adresse" @bind-Value="demandeNote.adresse" Required="true" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField T="string" Label="Contact" @bind-Value="demandeNote.contact" Required="true" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Email" @bind-Value="demandeNote.email" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Etat de décompte" @bind-Value="demandeNote.etatDecompte" Required="true" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField T="string" Label="Nom de l'objet" @bind-Value="demandeNote.objet" Required="true" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField T="int" Label="Nombre d'échantillons" @bind-Value="demandeNote.nombreEchantillon" Required="true" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudDatePicker  @bind-Date="demandeNote.datePaiement" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="double" Label="Montant" @bind-Value="demandeNote.montant" Required="true" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Montant litéral" @bind-Value="demandeNote.montant_literal" Required="true" Variant="Variant.Text" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudHidden T="int" @bind-Value="demandeNote.idEtatDecompte" />
            </MudItem>
            <MudItem xs="12" class="d-flex justify-center">
                <MudButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" Size="Size.Large" Class="mt-8" OnClick="SubmitNoteDebit">add demande</MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudItem>



