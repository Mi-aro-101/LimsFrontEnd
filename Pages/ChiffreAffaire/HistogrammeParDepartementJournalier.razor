@page "/chiffre/affaire/departement/journalier"

@inject HttpClient Http
@inject IJSRuntime JSRuntime
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using LimsUtils.Utility
@using System.Text.Json
@using System.Globalization

@implements IAsyncDisposable

<h2>Chiffre d'affaire journalier par département</h2>
<hr>

@if(!(string.IsNullOrEmpty(exception)))
{
    <div class="alert alert-danger">
        <p>@exception</p>
    </div>
}

<center>
    <MudGrid>
        <MudItem xs="12" sm="7">
            <MudPaper Class="pa-4">
                <MudForm>
                    <MudTextField T="int?" Label="Annee" @bind-Value="sorter!.Annee" />
                    <MudSelect T="int" Label="Mois" @bind-Value="month">
                        @for (int i = 1; i <= 12; i++)
                        {
                            var volana = moisSet[i - 1]; // <-- Define inside the loop
                            <MudSelectItem Value="@i">@volana</MudSelectItem>
                        }
                    </MudSelect>
                    <br>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(()=>FetchCA())" Class="ml-auto">Valider</MudButton>
                    </MudCardActions>
                    <MudCardActions>
                        <MudLink Href="/chiffre/affaire/journalier">Hisogramme journalier</MudLink>
                    </MudCardActions>
                </MudForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
</center>

<br>

<div class="row">
    <div class="col">
        <div class="card">
            <div class="card-header">
                Diagramme en baton
            </div>
            <div class="card-body">
                <div id="myDiv"></div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card">
            <div class="card-header">
                Diagramme en camembert par département
            </div>
            <div class="card-body">
                <CamembertDepartementMensuelComponent Sorter="@sorter" ChiffreAffaires="@chiffreAffaires"/>
            </div>
        </div>
    </div>
</div>

@code
{
    private string[] moisSet = new string[12];
    private ChiffreAffaireDepartementDto[] chiffreAffaires = new ChiffreAffaireDepartementDto[12];
    private ChiffreAffaireDto sorter = new ChiffreAffaireDto{
        Annee = DateUtils.GetCurrentYear(),
        Mois = DateTime.Now.Month
    };
    private string exception = string.Empty;
    string[] xs = new string[1];
    private IJSObjectReference? jsModule;
    private string chartTitle = string.Empty;
    int month = 1;


    protected override async Task OnInitializedAsync()
    {
        string mois = new DateTime(2000, sorter!.Mois!.Value, 1).ToString("MMMM", new CultureInfo("fr-FR"));
        chartTitle = $"Chiffre d'affaire journalier {mois} {sorter!.Annee!.Value}";
        month = DateTime.Now.Month;
        moisSet = ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septempbre", "Octobre", "Novembre", "Décembre"];
        await FetchCA();
    }

    private async Task FetchCA()
    {
        // Get number of days based on the year and month
        int daysInMonth = DateTime.DaysInMonth(sorter!.Annee!.Value, sorter!.Mois!.Value);
        xs = Enumerable.Range(1, daysInMonth)
            .Select(y => y.ToString())
            .ToArray();
        sorter!.Mois = month;

        var response = await Http.PostAsJsonAsync("chiffre/affaire/departement/journalier", sorter);
        using var responseStream = await response.Content.ReadAsStreamAsync();
        ApiResponse? apiResponse = await JsonSerializer.DeserializeAsync<ApiResponse>(responseStream);
        
        if(apiResponse?.IsSuccess == true || apiResponse != null)
        {
            apiResponse.HandleResponse<ChiffreAffaireDepartementDto[]>();
            chiffreAffaires = (ChiffreAffaireDepartementDto[])apiResponse.Data;
        }
        else{
            exception = "Une erreur s'est produite";
        }
        
        string mois = new DateTime(2000, sorter!.Mois!.Value, 1).ToString("MMMM", new CultureInfo("fr-FR"));
        chartTitle = $"Chiffre d'affaire journalier {mois} {sorter!.Annee!.Value}";

        var datas = await MatchData(chiffreAffaires);
        Console.WriteLine(JsonSerializer.Serialize(datas));

        jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./js/chiffre-affaire.js");
        await jsModule.InvokeVoidAsync("chiffreAffaireDepartement", datas, chartTitle);
    }

    private async Task<ICollection<CADataDepartementRow>> MatchData(ChiffreAffaireDepartementDto[] chiffreAffaires)
    {
        ICollection<CADataDepartementRow> datas = new List<CADataDepartementRow>();
        decimal[] yValues = Enumerable.Repeat(0.0m, xs.Length).ToArray();
        foreach(var chiffreAffaire in chiffreAffaires)
        {
            CADataDepartementRow dataRow = new CADataDepartementRow();
            dataRow.x = xs;
            foreach(var chiffreAffaireParDpt in chiffreAffaire.ChiffreAffaires)
            {
                yValues[chiffreAffaireParDpt!.Jour!.Value - 1] = chiffreAffaireParDpt.Montant!.Value;
            }
            dataRow.y = yValues;
            // Reset Y for the next departement
            yValues = Enumerable.Repeat(0.0m, xs.Length).ToArray();
            dataRow.name = chiffreAffaire.Designation;
            datas.Add(dataRow);
        }
        return datas;
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModule != null)
        {
            await jsModule.DisposeAsync();
        }
    }

    class CADataDepartementRow
    {
        public string type { get; set; } = "bar";
        public string[] x { get; set; }
        public decimal[] y { get; set; }
        public string? name { get; set; }
        public ColorPalette marker { get; set; } = new ColorPalette();
    }

    class ColorPalette
    {
        public string[] colors { get; set; } = ["orange", "blue", "green", "red", "purple", "yellow", "brown"];
    }
}