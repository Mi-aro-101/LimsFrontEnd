@page "/type/travaux/details/{Id:int}"

@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using System.Text.Json;
@inject NavigationManager NavigationManager
@using System.Globalization
@using System
@using LimsUtils.Api
@using LimsFrontEnd.Utils

<style>
    .warning {
        color: rgb(179, 176, 42); /* Or any other warning color */
        font-size: smaller; /* Make the text smaller */
        margin-top: 5px; /* Add some spacing above the warning */
    }
</style>

<center><h2>Details concernant "@typetravaux.Designation"</h2></center>

<hr>
<div class="row">
    <div class="col">
        <div class="card" style="width: 40rem;">
            <div class="card-body">
                @if(typetravaux == null)
                {
                    <center><div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p>Veuillez patienter un moment</p><br/></center>
                }
                else
                {
                    <h3 class="card-title">Concernant le travail</h3>
                    <hr>
                    <p class="card-text">Designation : <strong> @typetravaux.Designation </strong></p>
                    <p class="card-text">Code : <strong> @typetravaux.Code </strong></p>
                    <p class="card-text">Date de creation : 
                        <strong> 
                            @string.Format(new CultureInfo("fr-FR"), "{0:dd MMMM yyyy}", typetravaux.DateCreation)
                        </strong>
                    </p>
                    <p class="card-text">Departement : <strong> @typetravaux.Departement.Designation </strong></p>
                    @if(typetravaux.HaveFormule == 1)
                    {
                        <p class="card-text">Tarif actuel : <strong> @string.Format(CultureInfo.InvariantCulture, "{0:#,##0.00}", typetravaux.Tarif).Replace(",", " ") Ar</strong></p>
                    }
                    else{
                        <TarifFormuleComponent TypeTravauxDesigne="@typetravaux" FormuleDesigne="@formule"/>
                    }
                }
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card" style="width: 40rem;">
            <div class="card-body">
                <h3 class="card-title" >Historique des tarifs</h3>
                <table class="table table-bordered" border="1">
                        <thead>
                            <th>Cout</th>
                            <th>Date de changement</th>
                        </thead>
                        <tbody>
                            @foreach(var historique in typetravaux.HistoriqueTarifs)
                            {
                            <tr>
                                <td style="text-align: right;">Ar @string.Format(CultureInfo.InvariantCulture, "{0:#,##0.00}", historique.Tarif).Replace(",", " ")</td>
                                <td>
                                    <p>@string.Format(new CultureInfo("fr-FR"), "{0:dd MMMM yyyy}", historique.DateChangement)</p>
                                </td>
                            </tr>
                            }
                        </tbody>
                    </table>
            </div>
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public int Id { get; set; }

    string url = "http://localhost:5077/api/";

    TypeTravauxDto? typetravaux;
    private bool showDateInput = false;
    Formule formule = new Formule();

    protected override async Task OnInitializedAsync()
    {
        await LoadTypeTravaux();
        if(typetravaux.HaveFormule == 0)
        {
            formule = Formule.FromString(typetravaux.FormuleString);
        }
    }

    private async Task LoadTypeTravaux()
    {
        var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            ApiResponse? apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+$"type/travaux/{Id}", options);
            if(apiResponse != null){
                apiResponse.HandleResponse<TypeTravauxDto>();
                typetravaux = (TypeTravauxDto)apiResponse.Data;
                Console.WriteLine(JsonSerializer.Serialize(typetravaux.HistoriqueTarifs));
            }
    }
}
