@page "/type/travaux/{Id:int}"

@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsFrontEnd.Utils
@using System.Text.Json;
@inject NavigationManager NavigationManager

<div class="card border-dark mb-3" style="max-width: 39rem;">
  <div class="card-header">Mettre à jour ce typetravaux</div>
  <div class="card-body text-dark">
    <EditForm Model="@typetravaux" OnValidSubmit="@HandleOnSubmit">
        <div class="form-group row">
            <label for="staticEmail" class="col-sm-2 col-form-label">Code</label>
            <div class="col-sm-8">
            <InputText class="form-control" @bind-Value="typetravaux.Code"/>
            </div>
        </div>
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Designation</label>
            <div class="col-sm-8">
            <InputText class="form-control" @bind-Value="typetravaux.Designation"/>
            </div>
        </div>
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Departement</label>
            <div class="col-sm-8">
            <InputSelect class="form-control" @bind-Value="typetravaux.IdDepartement">
                @foreach(DepartementDto departement in departements)
                {
                    <option value=@departement.IdDepartement>@departement.Designation</option>
                }
            </InputSelect>
            </div>
        </div>
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Tarif</label>
            <div class="col-sm-8">
            <InputNumber class="form-control" @bind-Value="typetravaux.Tarif" placeholder="0000.00" />
            </div>
        </div>
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Date de Changement de tarif</label>
            <div class="col-sm-8">
            <InputDate class="form-control" @bind-Value="typetravaux.DateCreation" />
            </div>
        </div>
        <br>
        <center>
            <button type="submit" class="btn btn-warning">Modifier</button>
        </center>
    </EditForm>
  </div>
</div>

@code
{
    private TypeTravauxDto? typetravaux;
    private string url = "http://localhost:5077/api/";
    [Parameter]
    public int Id { get; set; }
    private ICollection<DepartementDto> departements = new List<DepartementDto>();

    protected async override Task OnInitializedAsync()
    {
        await FetchDetails(Id);
        await LoadDepartement();
    }

    private async Task FetchDetails(int id)
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            ApiResponse? apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+$"type/travaux/{Id}", options);
            Console.WriteLine(url+$"/{Id}");
            if(apiResponse.Data != null){
                apiResponse.HandleResponse<TypeTravauxDto>();
                typetravaux = (TypeTravauxDto)apiResponse.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadDpt: {ex.Message}");
        }
    }
    private async Task HandleOnSubmit()
    {
        try
        {
            Console.WriteLine(JsonSerializer.Serialize(typetravaux));
            typetravaux.Departement = null;
            var response = await Http.PutAsJsonAsync(url+$"type/travaux/{Id}", typetravaux);
            // Optionally handle the response (e.g., show a success message)
            NavigationManager.NavigateTo("/type/travaux"); // Redirect to product list
        }
        catch(Exception ex)
        {
            Console.WriteLine("Exception : " +ex.Message);
        }
    }

    private async Task LoadDepartement()
    {
        try
        {
            ApiResponse? apiResponse;
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+"departement/all");
            apiResponse.HandleResponse<List<DepartementDto>>();
            departements = (List<DepartementDto>)apiResponse.Data;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadDepartement {ex.Message}");
        }

    }
}