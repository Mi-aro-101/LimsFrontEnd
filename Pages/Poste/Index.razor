@page "/poste"
@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsFrontEnd.Utils
@using System.Text.Json;


<h3>Postes</h3>
    <div class="row">
        <div class="col">
            @if (postes == null)
            {
                <p><em>No data on the row</em></p>
            }
            else
            {
                @if (apiResponse.ViewBag.ContainsKey("position") && apiResponse.ViewBag.ContainsKey("TotalCount") && apiResponse.ViewBag.ContainsKey("nbrPerPage"))
                {
                    <p>
                        Page @apiResponse.ViewBag["position"] of
                        @apiResponse.ViewBag["nbrLinks"]
                    </p>
                }
                else
                {
                    <p>Pagination information not available.</p>
                }
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Designation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var poste in postes)
                        {
                            <tr>
                                <td>@poste.IdPoste</td>
                                <td>@poste.Designation</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <div class="col"></div>
    </div>

@code {
    private List<PosteDto>? postes = new List<PosteDto>();
    private ApiResponse? apiResponse;
    private int currentPage = 0;
    private int pageSize = 3;
    string url = "http://localhost:5077/api/poste";


    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadPostes();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error on Initializing : {ex.Message}");
        }
    }

    private async Task LoadPostes()
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+$"?position={currentPage}&pageSize={pageSize}", options);
            Console.WriteLine(url+$"?position={currentPage}&pageSize={pageSize}");
            if(apiResponse.Data != null){
                Console.WriteLine(apiResponse.ViewBag["position"]);
                Console.WriteLine(apiResponse.ViewBag["nbrPerPage"]);
                Console.WriteLine(apiResponse.ViewBag["TotalCount"]);
                apiResponse.HandleResponse<List<PosteDto>>();
                postes = (List<PosteDto>)apiResponse.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadDpt: {ex.Message}");
        }
    }
}