@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json;
@inject NavigationManager NavigationManager
@using Microsoft.JSInterop;

<style>
    .bordered-cell-one{
        border-right: none;
        text-align: center;
    }
    .bordered-cell-two{
        border-left: none;
        text-align: center;
    }
</style>
<div class="col">
    <CreateComponent OnPosteCreated="@HandlePosteCreated" />
</div>

<div class="col">
    @if (postes == null)
    {
        <p><em>No data on the row</em></p>
    }
    else
    {
        @if (apiResponse.ViewBag.ContainsKey("position") && apiResponse.ViewBag.ContainsKey("TotalCount") && apiResponse.ViewBag.ContainsKey("nbrPerPage"))
        {

            var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
            var pageSize = int.Parse(apiResponse.ViewBag["nbrPerPage"].ToString());
            var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());

            <table class="table table-bordered" border="1">
                <thead>
                    <tr>
                        <th scope="col">Designation</th>
                        <th scope="col" colspan="2"><center>Actions</center></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var poste in postes)
                    {
                        <tr>
                            <td>@poste.Designation</td>
                            <td class="bordered-cell-one">
                                <MudButton Size="Size.Small" @onclick="@(() => HandleUpdate(@poste.IdPoste))" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" Color="Color.Warning"></MudButton>
                            </td>
                            <td class="bordered-cell-two">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" @onclick="@(() => HandleDelete(currentPage, @poste.IdPoste, @poste.Designation))" Color="Color.Error"></MudButton> 
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <nav aria-label="Page navigation">
                <ul class="pagination">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="/poste" @onclick="@(() => LoadPostes(currentPage - 1))">Précédent</a>
                    </li>

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="/poste" @onclick="@(() => LoadPostes(currentPage + 1))">Suivant</a>
                    </li>
                </ul>
            </nav>

            <center><p>
                Page @apiResponse.ViewBag["position"] sur
                @apiResponse.ViewBag["nbrLinks"]
            </p></center>
        }
        else
        {
            <p>Information sur la pagination indisponible</p>
        }
    }
</div>

@code {
    private List<PosteDto>? postes = new List<PosteDto>();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 2;
    string url = "http://localhost:5077/api/poste";
    [Inject] IJSRuntime JSRuntime { get; set; }

    private async Task HandlePosteCreated() // The callback handler
    {
        int pageLoaded = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
        int elementNumberOnLastPage = postes.Count;
        if(elementNumberOnLastPage == pageSize)
            pageLoaded = pageLoaded + 1;
        await LoadPostes(pageLoaded);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadPostes(currentPage);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error on Initializing : {ex.Message}");
        }
    }

    private async Task LoadPostes(int? activePage)
    {
        if(activePage.HasValue) currentPage = activePage.Value;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+$"?position={currentPage}&pageSize={pageSize}", options);
            if(currentPage <= int.Parse(apiResponse.ViewBag["nbrLinks"].ToString())){
                apiResponse.HandleResponse<List<PosteDto>>();
                postes = (List<PosteDto>)apiResponse.Data;
            }
            else{
                await LoadPostes(int.Parse(apiResponse.ViewBag["nbrLinks"].ToString()));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadDpt: {ex.Message}");
        }
    }

    private async Task DeletePoste(int position, int id)
    {
        try
        {

            var response = await Http.DeleteAsync(url+$"/{id}");
            response.EnsureSuccessStatusCode(); // Throw if not successful
            // Optionally handle the response (e.g., show a success message)
            await LoadPostes(position);
        }
        catch(Exception ex)
        {
            Console.WriteLine("Exception : " +ex.Message);
        }
    }

    private async Task HandleDelete(int? position, int id, string designation)
    {
        int currPage;
        if(position.HasValue) currPage = position.Value;
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Etes-vous sûr de supprimer {designation}");
        if (confirmed)
        {
            await DeletePoste(currentPage, id);
        }
    }

    private async Task HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/poste/{id}");
    }
}