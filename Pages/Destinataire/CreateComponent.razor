@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json;
@inject HttpClient Http
@inject NavigationManager NavigationManager

<MudCard Class="pa-3" MaxWidth="30rem">
    <MudCardHeader>
        <MudText Typo="Typo.h6" Class="text-center">Ajouter un destinataire</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudForm Model="@destinataire" @ref="form">
            <MudStack Spacing="2">
                <MudTextField T="string" Label="Nom" @bind-Value="destinataire.designation"
                Placeholder="Departement de l'entreprise" FullWidth="true" Required="true" Immediate="true" Dense="true" />                
            </MudStack>

            <MudDivider Class="my-3" />

            <MudCardActions Class="justify-center">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitForm" Size="Size.Small">
                    Ajouter
                </MudButton>
            </MudCardActions>
        </MudForm>
    </MudCardContent>
</MudCard>

@code {
    private MudForm form;
    private DestinataireDto destinataire = new();
    private string url = "http://localhost:5077/api/destinataire";

    [Parameter]
    public EventCallback OnDestinataireCreated { get; set; }

    private async Task SubmitForm()
    {
        try
        {
            if (destinataire == null)
            {
                Console.WriteLine("contrat est null");
                return;
            }

            var destinataires = new DestinataireDto
            {
               destignation = destinataire.destignation    
            };

            var response = await Http.PostAsJsonAsync(url + "/ajout", destinataires);

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine("Erreur de l'API: " + errorContent);
            }
            else
            {
                // Réinitialiser le formulaire après l'ajout
                destinataire = new DestinataireDto();
                await form.ResetAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception: " + ex.Message);
        }
    }
}
