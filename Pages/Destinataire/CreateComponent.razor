@using LimsUtils.Api
@using System.Text.Json;
@inject HttpClient Http
@using LimsFrontEnd.Models
@using System.Net.Http.Json
@using System.Threading.Tasks
@using System.Collections.Generic
@inject NavigationManager NavigationManager

<MudCard Elevation="3" Class="p-4 rounded-xl">
    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-3">➕ Ajouter un destinataire</MudText>

    <MudForm Model="@destinataire" @ref="form">
        <MudStack Spacing="3">
            <MudTextField T="string" Label="Nom de l'entreprise" @bind-Value="destinataire.designation"
                          Placeholder="Nom du destinataire" FullWidth="true" Required="true" />

            <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="SubmitForm" FullWidth="true">
                ✅ Ajouter
            </MudButton>
        </MudStack>
    </MudForm>
</MudCard>

@code {
    private MudForm form;
    private DestinataireDto destinataire = new();
    //private string url = "http://localhost:5077/api/destinataire";
    [Parameter]
    public EventCallback OnDestinataireCreated { get; set; }

    private async Task SubmitForm()
    {
        try
        {
            if (destinataire == null)
            {
                Console.WriteLine("contrat est null");
                return;
            }

            var destinataires = new DestinataireDto
            {
               designation = destinataire.designation    
            };

            var response = await Http.PostAsJsonAsync("destinataire/ajout", destinataires);

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine("Erreur de l'API: " + errorContent);
            }
            else
            {
                // Réinitialiser le formulaire après l'ajout
                destinataire = new DestinataireDto();
                await form.ResetAsync();

                // 🔔 Invoquer le callback pour signaler la création
                await OnDestinataireCreated.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception: " + ex.Message);
        }
    }
}