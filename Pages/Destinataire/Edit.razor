@page "/destinataire/{Id_destinataire:int}"

@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json;
@inject HttpClient Http
@inject NavigationManager NavigationManager

<MudCard Class="mb-3" Style="max-width: 39rem;">
    <MudCardHeader>
        <MudText Typo="Typo.h5">Mettre à jour le partenaire</MudText>
    </MudCardHeader>

    <MudCardContent>
        @if (!string.IsNullOrEmpty(exception))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@exception</MudAlert>
        }

        <MudForm Model="@destinataire" @ref="form">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField Label="Nom de l'entreprise" @bind-Value="destinataire.designation" Required="true" />
                </MudItem>
               
                <MudItem xs="12" Class="d-flex justify-center">
                    <MudButton Type="Submit" Variant="Variant.Filled" OnClick="HandleOnSubmit" Color="Color.Primary">
                        Modifier
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudCardContent>
</MudCard>

@code {
    private MudForm form;
    private DestinataireDto destinataire = new();
    private string url = "http://localhost:5077/api/destinataire";
    private string? exception;
    [Parameter]
    public int Id_destinataire { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await FetchDetails(Id_destinataire);
    }

    private async Task FetchDetails(int id)
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            ApiResponse? apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{url}/{Id_destinataire}", options);
            Console.WriteLine(url + $"/{Id_destinataire}");
            if (apiResponse.Data != null)
            {
                apiResponse.HandleResponse<DestinataireDto>();
                destinataire = (DestinataireDto)apiResponse.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadDpt: {ex.Message}");
        }
    }

    private async Task HandleOnSubmit()
    {
        try
        {
            Console.WriteLine("Formulaire soumis !");
            var response = await Http.PutAsJsonAsync($"{url}/{Id_destinataire}", destinataire);
            // Optionally handle the response (e.g., show a success message)
            NavigationManager.NavigateTo("/destinataire"); // Redirect to product list
        }
        catch (Exception ex)
        {
            exception = ex.Message;
            StateHasChanged();
        }
    }
}
