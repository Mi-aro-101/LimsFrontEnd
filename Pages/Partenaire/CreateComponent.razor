@* @code {
    private MudForm form;
    private ContratDto contrat = new();
    //private string url = "http://localhost:5077/api/contrat";

    [Parameter]
    public EventCallback OnContratCreated { get; set; }

    private async Task SubmitForm()
    {
        try
        {
            if (contrat == null)
            {
                Console.WriteLine("contrat est null");
                return;
            }

            var contrats = new ContratDto
            {
                nomEntreprise = contrat.nomEntreprise,
                etat = 200,
                referenceContrat = contrat.referenceContrat,
                datePaiement = contrat.datePaiement
            };                   

            var response = await Http.PostAsJsonAsync("contrat/ajout", contrats);            

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine("Erreur de l'API: " + errorContent);
            }  
            else
            {
                // Réinitialiser le formulaire après l'ajout
                contrat = new ContratDto();
                await form.ResetAsync();

                // 🔔 Invoquer le callback pour signaler la création
                await OnContratCreated.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception: " + ex.Message);
        }
    }
} *@