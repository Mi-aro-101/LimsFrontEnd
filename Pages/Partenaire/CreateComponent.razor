@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json;
@inject HttpClient Http
@inject NavigationManager NavigationManager

<MudCard Class="pa-4" MaxWidth="39rem">
    <MudCardHeader>
        <MudText Typo="Typo.h5">Ajout de nouvelle partenaire</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudForm Model="@contrat" @ref="form">
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudTextField T="string" Label="Nom" @bind-Value="contrat.nomEntreprise" Placeholder="Entreprise ou particulier" FullWidth="true" Required="true" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudTextField T="string" Label="Référence" @bind-Value="contrat.referenceContrat" Placeholder="Référence du contrat" FullWidth="true" Required="true" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudDatePicker Label="Date de paiement" @bind-Date="contrat.datePaiement" Margin="Margin.Dense" Required="true" />
                </MudItem>
            </MudGrid>
            <MudDivider Class="my-4" />
            <MudCardActions>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitForm">Créer</MudButton>
            </MudCardActions>
        </MudForm>
    </MudCardContent>
</MudCard>

@code {
    private MudForm form;
    private bool isValid;
    private ContratDto contrat = new();
    private string url = "http://localhost:5077/api/contrat";

