    private async Task SubmitForm()
    {
        try
        {
            if (contrat == null)
            {
                Console.WriteLine("contrat est null");
                return;
            }

            var contrats = new ContratDto
            {
                nomEntreprise = contrat.nomEntreprise,
                etat = 200,
                referenceContrat = contrat.referenceContrat,
                datePaiement = contrat.datePaiement
            };                   

            var response = await Http.PostAsJsonAsync(url + "/ajout", contrats);            

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine("Erreur de l'API: " + errorContent);
            }            
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception: " + ex.Message);
        }
    }
}