@page "/testpagination"

<MudContainer>
    <MudTable Items="@currentPageItems" Dense="true">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Nom</MudTh>
            <MudTh>Email</MudTh>
        </HeaderContent>
        <RowTemplate Context="user">
            <MudTd>@user.Id</MudTd>
            <MudTd>@user.Name</MudTd>
            <MudTd>@user.Email</MudTd>
        </RowTemplate>
    </MudTable>

    <MudPagination Page="@currentPage" PageSize="@pageSize" TotalItems="@totalItems" Variant="Variant.Filled" Count="4" SelectedChanged="LoadPage" />
</MudContainer>

@code {
    private List<User> allUsers = new()
    {
        new User { Id = 1, Name = "Alice Dupont", Email = "alice@example.com" },
        new User { Id = 2, Name = "Bob Martin", Email = "bob@example.com" },
        new User { Id = 3, Name = "Charlie Durand", Email = "charlie@example.com" },
        new User { Id = 4, Name = "David Lambert", Email = "david@example.com" },
        new User { Id = 5, Name = "Emma Robert", Email = "emma@example.com" },
        new User { Id = 6, Name = "Félix Bernard", Email = "felix@example.com" },
        new User { Id = 7, Name = "Gisèle Moreau", Email = "gisele@example.com" },
        new User { Id = 8, Name = "Hugo Laurent", Email = "hugo@example.com" },
        new User { Id = 9, Name = "Isabelle Dubois", Email = "isabelle@example.com" },
        new User { Id = 10, Name = "Jean Petit", Email = "jean@example.com" }
    };

    private List<User> currentPageItems = new();
    private int currentPage = 1;
    private int pageSize = 5;
    private int totalItems;

    protected override void OnInitialized()
    {
        totalItems = allUsers.Count;
        LoadPage(currentPage);
    }

    private void LoadPage(int page)
    {
        currentPage = page;
        currentPageItems = allUsers
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    public class User
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public string Email { get; set; }
    }
}