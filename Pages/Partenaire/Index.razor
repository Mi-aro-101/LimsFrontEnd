@page "/partenaire"

@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json;

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6 px-4">
    <MudGrid GutterSize="24px">
        <!-- Formulaire d'ajout -->
        <MudItem xs="12" md="4">
            <MudPaper Elevation="4" Class="pa-4 rounded-xl shadow-md">
                <CreateComponent OnContratCreated="@HandleContratCreated" />
            </MudPaper>
        </MudItem>

        <!-- Liste des contrats -->
        <MudItem xs="12" md="8">
            <MudPaper Elevation="4" Class="pa-4 rounded-xl shadow-md">
                <MudText Typo="Typo.h6" Class="mb-4">Liste des partenaires</MudText>

                @if (contrats == null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Aucun partenaire trouvé.</MudText>
                }
                else
                {
                    @if (apiResponse != null && apiResponse.ViewBag != null
                            && apiResponse.ViewBag.ContainsKey("position")
                            && apiResponse.ViewBag.ContainsKey("TotalCount")
                            && apiResponse.ViewBag.ContainsKey("nbrPerPage"))
                    {
                        var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
                        var pageSize = int.Parse(apiResponse.ViewBag["nbrPerPage"].ToString());
                        var totalPages = int.Parse(apiResponse.ViewBag["TotalCount"].ToString());
                        var pageLinks = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());

                        <!-- Table -->
                        <MudTable Items="contrats" Dense="true" Hover="true" Class="rounded-lg">
                            <HeaderContent>
                                <MudTh>Nom</MudTh>
                                <MudTh>État</MudTh>
                                <MudTh>Référence</MudTh>
                                <MudTh>Date paiement</MudTh>
                                <MudTh class="text-center">Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="contrat">
                                <MudTd>@contrat.nomEntreprise</MudTd>
                                <MudTd>@(contrat.etat == 200 ? "sous contrat" : (contrat.etat == 400 ? "rupture de contrat" : ""))</MudTd>
                                <MudTd>@contrat.referenceContrat</MudTd>
                                <MudTd>@contrat.datePaiement?.ToShortDateString()</MudTd>
                                <MudTd Align="Align.Center">
                                    <MudButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Color="Color.Warning"
                                            Size="Size.Small" OnClick="() => HandleUpdate(contrat.idContratPartenaire)" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>

                        <!-- Pagination -->
                        <MudStack Direction="Row" JustifyContent="Center" Class="mt-4">
                            <MudPagination Page="@currentPage"
                                        PageSize="@pageSize"
                                        TotalItems="@totalPages"
                                        Count="@pageLinks"
                                        Variant="Variant.Outlined"
                                        Size="Size.Medium"
                                        Color="Color.Primary"
                                        SelectedChanged="@(page => LoadPostes(page))" />
                        </MudStack>
                    }
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<ContratDto> contrats = new List<ContratDto>();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 5; 
    private string url = "http://localhost:5077/api/contrat";

    private async Task HandleContratCreated()
    {
        int pageLoaded = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
        int elementNumberOnLastPage = contrats.Count;
        if (elementNumberOnLastPage == pageSize)
            pageLoaded = pageLoaded + 1;
        await LoadPostes(pageLoaded);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadPostes(currentPage);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error on Initializing : {ex.Message}");
        }
    }

    private async Task LoadPostes(int? activePage)
    {        
        if (activePage.HasValue) currentPage = activePage.Value;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url + "?position=" + currentPage + "&pageSize=" + pageSize, options);

            if (apiResponse == null)
            {
                Console.WriteLine("⚠️ apiResponse est NULL !");
                apiResponse = new ApiResponse(); // Évite le null en créant une instance vide
            }

            if (apiResponse.Data == null)
            {
                Console.WriteLine("⚠️ apiResponse.Data est NULL !");
                apiResponse.Data = new List<ContratDto>(); // Évite le null en créant une liste vide
            }

            if (currentPage <= int.Parse(apiResponse.ViewBag["nbrLinks"].ToString()))
            {
                apiResponse.HandleResponse<List<ContratDto>>();
                contrats = apiResponse.Data as List<ContratDto> ?? new List<ContratDto>();
            }
            else
            {
                await LoadPostes(int.Parse(apiResponse.ViewBag["nbrLinks"].ToString()));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadDpt: {ex.Message}");
            apiResponse = new ApiResponse(); // Évite que apiResponse reste null en cas d'erreur
        }
    }

    private async Task HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/partenaire/{id}");
    }
}

