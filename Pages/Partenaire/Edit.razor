@page "/partenaire/{id_partenaire:int}"

@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json;
@inject HttpClient Http
@inject NavigationManager NavigationManager

<MudCard Class="mb-3" Style="max-width: 39rem;">
    <MudCardHeader>
        <MudText Typo="Typo.h5">Mettre à jour le partenaire</MudText>
    </MudCardHeader>
    
    <MudCardContent>
        @if (!string.IsNullOrEmpty(exception))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@exception</MudAlert>
        }

        <MudForm Model="@contrat">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField Label="Nom de l'entreprise" @bind-Value="contrat.nomEntreprise" Required="true" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Label="Référence contrat" @bind-Value="contrat.referenceContrat" Required="true" />
                </MudItem>

                <MudItem xs="12">
                    <MudDatePicker Label="Date du contrat" @bind-Date="contrat.datePaiement" Required="true" />
                </MudItem>

                <MudItem xs="12">
                    <MudSelect T="int" Label="Type de contrat" @bind-Value="contrat.etat" Required="true">
                        <MudSelectItem Value="200">sous contrat</MudSelectItem>
                        <MudSelectItem Value="400">rupture de contrat</MudSelectItem>                       
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" Class="d-flex justify-center">
                    <MudButton Type="Submit" Variant="Variant.Filled" OnClick="(() => HandleOnSubmit(contrat.idContratPartenaire))" Color="Color.Primary">
                        Modifier
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudCardContent>
</MudCard>

@code {
    private ContratDto contrat = new();
    private string url = "http://localhost:5077/api/contrat";
    private string? exception;
    [Parameter]
    public int Id_partenaire { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await FetchDetails(Id_partenaire);
    }

    private async Task FetchDetails(int id)
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var response = await Http.GetAsync($"{url}/{Id_partenaire}");

            string responseBody = await response.Content.ReadAsStringAsync();
            Console.WriteLine("API Response: " + responseBody); // Afficher la réponse JSON

            ApiResponse? apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{url}/{Id_partenaire}", options);
            Console.WriteLine(url + $"/{Id_partenaire}");
            if (apiResponse.Data != null)
            {
                apiResponse.HandleResponse<ContratDto>();
                contrat = (ContratDto)apiResponse.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadDpt: {ex.Message}");
        }
    }

    private async Task HandleOnSubmit(int id_contrat)
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"{url}/{Id_partenaire}/{id_contrat}", contrat);
            // Optionally handle the response (e.g., show a success message)
            NavigationManager.NavigateTo("/partenaire"); // Redirect to product list
        }
        catch (Exception ex)
        {
            exception = ex.Message;
            StateHasChanged();
        }
    }
}
