@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Reactif
@using LimsUtils.Api
@using System.Collections.Generic
@using System.Linq
@using MudBlazor
@using LimsFrontEnd.Components

<div class="row">
    <!-- Colonne de création -->
    <div class="col">
        <Create OnObjetSortieReactifCreated="HandleObjetSortieReactifCreated" />
    </div>

    <!-- Colonne de la liste -->
    <div class="col">
        @if (objetsSortieReactif == null || !objetsSortieReactif.Any())
        {
            <p><em>Aucun objet de sortie réactif disponible</em></p>
        }
        else
        {
            @if (apiResponse != null && apiResponse.ViewBag != null &&
                apiResponse.ViewBag.ContainsKey("position") &&
                apiResponse.ViewBag.ContainsKey("nbrPerPage") &&
                apiResponse.ViewBag.ContainsKey("nbrLinks"))
            {
                var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
                var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
                
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            @* <th scope="col">ID</th> *@
                            <th scope="col">Désignation</th>
                            <th scope="col"><center>Actions</center></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var osr in objetsSortieReactif.OrderByDescending(o => o.IdObjetSortieReactif))
                        {
                            <tr>
                                @* <td>@osr.IdObjetSortieReactif</td> *@
                                <td>@osr.Designation</td>
                                <td>
                                    <center>
                                        <MudButton Size="Size.Small"
                                                   @onclick="@(() => HandleUpdate(osr.IdObjetSortieReactif))"
                                                   Variant="Variant.Filled"
                                                   StartIcon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Warning">
                                        </MudButton>
                                    </center>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadObjetsSortieReactif(currentPage - 1))">Précédent</a>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadObjetsSortieReactif(currentPage + 1))">Suivant</a>
                        </li>
                    </ul>
                </nav>

                <center>
                    <p>Page @apiResponse.ViewBag["position"] sur @apiResponse.ViewBag["nbrLinks"]</p>
                </center>
            }
            else
            {
                <p>Informations de pagination indisponibles.</p>
            }
        }
    </div>
</div>

@code {
    private List<ObjetSortieReactifDto> objetsSortieReactif = new();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 10;
    private string url = "http://localhost:5077/api/objetSortieReactif";

    protected override async Task OnInitializedAsync()
    {
        await LoadObjetsSortieReactif(currentPage);
    }

    private async Task LoadObjetsSortieReactif(int page)
    {
        currentPage = page;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{url}?position={currentPage}&pageSize={pageSize}", options);
            
            if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Data != null)
            {
                objetsSortieReactif = apiResponse.Data != null
                    ? JsonSerializer.Deserialize<List<ObjetSortieReactifDto>>(
                        apiResponse.Data?.ToString() ?? string.Empty,
                        new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                    ) ?? new List<ObjetSortieReactifDto>()
                    : new List<ObjetSortieReactifDto>();

                // Tri par ID décroissant pour avoir les plus récents en premier
                objetsSortieReactif = objetsSortieReactif.OrderByDescending(o => o.IdObjetSortieReactif).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement : {ex.Message}");
        }
    }

    private async Task HandleObjetSortieReactifCreated()
    {
        // Recharger la première page pour voir le nouvel objet
        await LoadObjetsSortieReactif(1);
    }

    private void HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/objetSortieReactif/edit/{id}");
    }
}