@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using System.Text.Json
@using LimsFrontEnd.Models.Reactif
@using LimsUtils.Api
@using System.Linq

<div class="container">
    <div class="row">
        <!-- Colonne pour le formulaire -->
        <div class="col-md-6">
            <Create OnReportReactifCreated="HandleReportReactifCreated" />
        </div>
        <!-- Colonne pour la liste -->
        <div class="col-md-6">
            @if (reportReactifs == null || reportReactifs.Count == 0)
            {
                <p><em>Aucun report réactif disponible</em></p>
            }
            else
            {
                if (apiResponse != null && apiResponse.ViewBag != null &&
                    apiResponse.ViewBag.ContainsKey("position") &&
                    apiResponse.ViewBag.ContainsKey("nbrPerPage") &&
                    apiResponse.ViewBag.ContainsKey("nbrLinks"))
                {
                    var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
                    var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th scope="col">Date du Report</th>
                                <th scope="col">Quantité</th>
                                <th scope="col">Réactif</th>
                                <th scope="col">Unité</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in reportReactifs)
                            {
                                <tr>
                                    <td>@report.DateReport.ToShortDateString()</td>
                                    <td>@report.Quantite</td>
                                    <td>@(report.Reactif != null ? report.Reactif.Designation : "N/A")</td>
                                    <td>@(report.Reactif?.Unite != null ? report.Reactif.Unite.Designation : "N/A")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadReportReactifs(currentPage - 1))">Précédent</a>
                            </li>
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadReportReactifs(currentPage + 1))">Suivant</a>
                            </li>
                        </ul>
                    </nav>

                    <center>
                        <p>Page @apiResponse.ViewBag["position"] sur @apiResponse.ViewBag["nbrLinks"]</p>
                    </center>
                }
                else
                {
                    <p>Informations de pagination indisponibles.</p>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<ReportReactifDo> reportReactifs = new();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 5;
    private string reportReactifUrl = "http://localhost:5077/api/report-reactifs";

    protected override async Task OnInitializedAsync()
    {
        await LoadReportReactifs(currentPage);
    }

    private async Task LoadReportReactifs(int page)
    {
        if (page < 1) page = 1; // Empêcher les pages négatives
        currentPage = page;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{reportReactifUrl}?position={currentPage}&pageSize={pageSize}", options);
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                reportReactifs = JsonSerializer.Deserialize<List<ReportReactifDo>>(
                    apiResponse.Data.ToString(),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new List<ReportReactifDo>();
            }
            else
            {
                reportReactifs.Clear();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des reports réactifs : {ex.Message}");
            reportReactifs.Clear();
        }
        StateHasChanged();
    }

    private async Task HandleReportReactifCreated()
    {
        await LoadReportReactifs(currentPage);
    }
}