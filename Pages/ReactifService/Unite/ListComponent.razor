@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Reactif
@using LimsUtils.Api
@using System.Collections.Generic
@using System.Linq
@using MudBlazor
@using LimsFrontEnd.Components

<div class="row">
    <!-- Colonne de création -->
    <div class="col-md-6">
        <Create OnUniteCreated="HandleUniteCreated" />
    </div>

    <!-- Colonne de la liste -->
    <div class="col-md-6">
        @if (unites == null)
        {
            <p>Chargement...</p>
        }
        else if (unites.Count == 0)
        {
            <p><em>Aucune unité disponible</em></p>
        }
        else
        {
            @if (apiResponse != null && apiResponse.ViewBag != null &&
                apiResponse.ViewBag.ContainsKey("position") &&
                apiResponse.ViewBag.ContainsKey("nbrPerPage") &&
                apiResponse.ViewBag.ContainsKey("nbrLinks"))
            {
                var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
                var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
                
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            @* <th>ID</th> *@
                            <th>Désignation</th>
                            <th><center>Actions</center></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in unites.OrderByDescending(u => u.IdUnite))
                        {
                            <tr>
                                @* <td>@u.IdUnite</td> *@
                                <td>@u.Designation</td>
                                <td>
                                    <center>
                                        <MudButton Size="Size.Small"
                                                   @onclick="@(() => HandleUpdate(u.IdUnite))"
                                                   Variant="Variant.Filled"
                                                   StartIcon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Warning">
                                        </MudButton>
                                    </center>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadUnites(currentPage - 1))">Précédent</a>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadUnites(currentPage + 1))">Suivant</a>
                        </li>
                    </ul>
                </nav>

                <center>
                    <p>Page @apiResponse.ViewBag["position"] sur @apiResponse.ViewBag["nbrLinks"]</p>
                </center>
            }
            else
            {
                <p>Informations de pagination indisponibles.</p>
            }
        }
    </div>
</div>

@code {
    private List<UniteDto> unites = new();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 10;
    private string url = "http://localhost:5077/api/unites";

    protected override async Task OnInitializedAsync()
    {
        await LoadUnites(currentPage);
    }

    private async Task LoadUnites(int page)
    {
        currentPage = page;
        try
        {
            var response = await Http.GetAsync($"{url}?position={currentPage}&pageSize={pageSize}");
            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                apiResponse = JsonSerializer.Deserialize<ApiResponse>(jsonString,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                
                if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Data != null)
                {
                    if (apiResponse.Data is JsonElement element)
                    {
                        unites = JsonSerializer.Deserialize<List<UniteDto>>(element.GetRawText(),
                            new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<UniteDto>();
                    }
                    else
                    {
                        unites = JsonSerializer.Deserialize<List<UniteDto>>(apiResponse.Data.ToString(),
                            new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<UniteDto>();
                    }

                    // Tri par ID décroissant
                    unites = unites.OrderByDescending(u => u.IdUnite).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erreur lors du chargement des unités : " + ex.Message);
        }
    }

    private async Task HandleUniteCreated()
    {
        await LoadUnites(1); // Recharger la première page
    }

    private void HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/unites/edit/{id}");
    }
}