@* @inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using System.Text.Json
@using LimsFrontEnd.Models.Reactif
@using LimsUtils.Api
@using System.Linq
@using LimsFrontEnd.Pages.SortieReactif 

<style>
    .form-list-container {
        display: flex;
    }

    .form-column {
        width: 40%; /* Adjust width as needed */
        padding-right: 20px; /* Space between form and table */
    }

    .list-container {
        width: 60%; /* Adjust width as needed */
    }
</style>

<div class="form-list-container">
    <div class="form-column">
        <Create OnSortieReactifCreated="HandleSortieReactifCreated" />
    </div>
    <div class="list-container">
        <div class="mt-4">
            @if (sortieReactifs == null || sortieReactifs.Count == 0)
            {
                <p><em>Aucune sortie réactif disponible</em></p>
            }
            else
            {
                if (apiResponse != null && apiResponse.ViewBag != null &&
                apiResponse.ViewBag.ContainsKey("position") &&
                apiResponse.ViewBag.ContainsKey("nbrPerPage") &&
                apiResponse.ViewBag.ContainsKey("nbrLinks"))
                {
                    var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
                    var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th scope="col">Réactif</th>
                                <th scope="col">Quantité</th>
                                <th scope="col">Date de Sortie</th>
                                <th scope="col">Département</th>
                                <th scope="col">Objet Sortie</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sortie in sortieReactifs)
                            {
                                <tr>
                                    <td>@(sortie.Reactif != null ? sortie.Reactif.Designation : "N/A")</td>
                                    <td>@sortie.Quantite</td>
                                    <td>@sortie.DateSortie.ToShortDateString()</td>
                                    <td>@(sortie.Departement != null ? sortie.Departement.Designation : "N/A")</td>
                                    <td>@(sortie.ObjetSortieReactif != null ? sortie.ObjetSortieReactif.Designation : "N/A")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadSortieReactifs(currentPage - 1))">Précédent</a>
                            </li>
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadSortieReactifs(currentPage + 1))">Suivant</a>
                            </li>
                        </ul>
                    </nav>

                    <center>
                        <p>Page @apiResponse.ViewBag["position"] sur @apiResponse.ViewBag["nbrLinks"]</p>
                    </center>
                }
                else
                {
                    <p>Informations de pagination indisponibles.</p>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<SortieReactifDto> sortieReactifs = new();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 5;
    private string sortieReactifUrl = "http://localhost:5077/api/sortie-reactifs";

    protected override async Task OnInitializedAsync()
    {
        await LoadSortieReactifs(currentPage);
    }

    private async Task LoadSortieReactifs(int page)
    {
        currentPage = page;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{sortieReactifUrl}?position={currentPage}&pageSize={pageSize}", options);
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                sortieReactifs = JsonSerializer.Deserialize<List<SortieReactifDto>>(
                    apiResponse.Data.ToString(),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new List<SortieReactifDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des sorties réactifs : {ex.Message}");
        }
        StateHasChanged();
    }

    private async Task HandleSortieReactifCreated()
    {
        await LoadSortieReactifs(currentPage);
    }
} *@

