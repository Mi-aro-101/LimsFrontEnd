@code {
    private List<SortieReactifDto> sortieReactifs = new();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 5;
    private string sortieReactifUrl = "http://localhost:5077/api/sortie-reactifs";

    protected override async Task OnInitializedAsync()
    {
        await LoadSortieReactifs(currentPage);
    }

    private async Task LoadSortieReactifs(int page)
