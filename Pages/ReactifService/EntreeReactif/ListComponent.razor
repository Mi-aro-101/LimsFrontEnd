@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using System.Text.Json
@using LimsFrontEnd.Models.Reactif
@using LimsUtils.Api
@using System.Linq
<style>
    .bordered-cell-one {
        border-right: none;
        text-align: center;
    }

    .bordered-cell-two {
        border-left: none;
        text-align: center;
    }
</style>
<div class="container">
    <!-- Formulaire centré au-dessus -->
    <Create OnEntreeReactifCreated="HandleEntreeReactifCreated" />

    <!-- Liste des entrées en dessous -->
    <div class="mt-4">
        @if (entreeReactifs == null || entreeReactifs.Count == 0)
        {
            <p><em>Aucune entrée réactif disponible</em></p>
        }
        else
        {
            if (apiResponse != null && apiResponse.ViewBag != null &&
                apiResponse.ViewBag.ContainsKey("position") &&
                apiResponse.ViewBag.ContainsKey("nbrPerPage") &&
                apiResponse.ViewBag.ContainsKey("nbrLinks"))
            {
                var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
                var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">Réactif</th>
                            <th scope="col">Unité</th>
                            <th scope="col">Quantité</th>
                            <th scope="col">Prix d'achat</th>
                            <th scope="col">Bon de Réception</th>
                            <th scope="col">Bon de Commande</th>
                            <th scope="col">Numéro de Facture</th>
                            <th scope="col">Date d'Entrée</th>
                            <th scope="col">Date de Péremption</th>
                            <th scope="col">Fournisseur</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entree in entreeReactifs)
                        {
                            <tr>
                                <td>@(entree.Reactif != null ? entree.Reactif.Designation : "N/A")</td>
                                <td>@(entree.Reactif != null && entree.Reactif.Unite != null ? entree.Reactif.Unite.Designation : "N/A")</td>
                                <td>@entree.Quantite</td>
                                <td>@entree.PrixAchat</td>
                                <td>@entree.BonReception</td>
                                <td>@(entree.BonDeCommande ?? "N/A")</td>
                                <td>@(entree.NumeroFacture ?? "N/A")</td>
                                <td>@entree.DateEntree.ToShortDateString()</td>
                                <td>@(entree.DatePeremption.HasValue ? entree.DatePeremption.Value.ToShortDateString() : "N/A")</td>
                                 <td>@(entree.Fournisseur != null ? entree.Fournisseur.Designation : "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadEntreeReactifs(currentPage - 1))">Précédent</a>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadEntreeReactifs(currentPage + 1))">Suivant</a>
                        </li>
                    </ul>
                </nav>

                <center>
                    <p>Page @apiResponse.ViewBag["position"] sur @apiResponse.ViewBag["nbrLinks"]</p>
                </center>
            }
            else
            {
                <p>Informations de pagination indisponibles.</p>
            }
        }
    </div>
</div>

@code {
    private List<EntreeReactifDto> entreeReactifs = new();
    private List<FournisseurEntreeReactifDto> allFournisseurs = new();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 5; // Modifié à 5 ici
    private string entreeReactifUrl = "http://localhost:5077/api/entree-reactifs";
    private string fournisseurUrl = "http://localhost:5077/api/fournisseurs-entree";

    protected override async Task OnInitializedAsync()
    {
        await LoadAllFournisseurs();
        await LoadEntreeReactifs(currentPage);
    }

    private async Task LoadAllFournisseurs()
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>(fournisseurUrl, options);
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                allFournisseurs = JsonSerializer.Deserialize<List<FournisseurEntreeReactifDto>>(
                    apiResponse.Data.ToString(),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new List<FournisseurEntreeReactifDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des fournisseurs : {ex.Message}");
        }
    }

    private async Task LoadEntreeReactifs(int page)
    {
        currentPage = page;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{entreeReactifUrl}?position={currentPage}&pageSize={pageSize}", options);
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                entreeReactifs = JsonSerializer.Deserialize<List<EntreeReactifDto>>(
                    apiResponse.Data.ToString(),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new List<EntreeReactifDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des entrées réactifs : {ex.Message}");
        }
        StateHasChanged();
    }

    private async Task HandleEntreeReactifCreated()
    {
        await LoadEntreeReactifs(currentPage);
    }
}