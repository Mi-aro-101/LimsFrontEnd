@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Reactif
@using LimsUtils.Api

<div class="card border-dark mb-3" style="max-width: 39rem;">
    <div class="card-header">Créer un Type de Sortie</div>
    <div class="card-body text-dark">
        <EditForm Model="@typeSortie" OnValidSubmit="@HandleOnSubmit">
            <DataAnnotationsValidator />
            <div class="form-group row">
                <label class="col-sm-3 col-form-label">Désignation</label>
                <div class="col-sm-9">
                    <InputText class="form-control" @bind-Value="typeSortie.Designation" placeholder="Désignation" />
                    @if (!string.IsNullOrEmpty(designationError))
                    {
                        <div class="text-danger">@designationError</div>
                    }
                </div>
            </div>
            <br />
            <center>
                <button type="submit" class="btn btn-primary">Créer</button>
            </center>
        </EditForm>
    </div>
</div>

@code {
    private TypeSortieDto typeSortie = new();
    private string url = "http://localhost:5077/api/typesSortie";
    private string? designationError;

    [Parameter]
    public EventCallback OnTypeSortieCreated { get; set; }

    private async Task HandleOnSubmit()
    {
        designationError = null;

        if (string.IsNullOrWhiteSpace(typeSortie.Designation))
        {
            designationError = "Veuillez saisir une désignation.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync(url, typeSortie);
            response.EnsureSuccessStatusCode();

            if (OnTypeSortieCreated.HasDelegate)
                await OnTypeSortieCreated.InvokeAsync();

            typeSortie = new TypeSortieDto(); // Réinitialiser le formulaire
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception : " + ex.Message);
        }
    }
}