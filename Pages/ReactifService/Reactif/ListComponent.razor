@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using System.Text.Json
@using LimsFrontEnd.Models.Reactif
@using LimsUtils.Api
@using System.Linq

<style>
    .bordered-cell-one {
        border-right: none;
        text-align: center;
    }

    .bordered-cell-two {
        border-left: none;
        text-align: center;
    }
</style>

<div class="row">
    <!-- Colonne de création -->
    <div class="col">
        <Create OnReactifCreated="HandleReactifCreated" />
    </div>

    <!-- Colonne de la liste -->
    <div class="col">
        @if (reactifs == null || reactifs.Count == 0)
        {
            <p><em>Aucun reactif disponible</em></p>
        }
        else
        {
            if (apiResponse != null && apiResponse.ViewBag != null &&
            apiResponse.ViewBag.ContainsKey("position") &&
            apiResponse.ViewBag.ContainsKey("nbrPerPage") &&
            apiResponse.ViewBag.ContainsKey("nbrLinks"))
            {
                var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
                var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">Désignation</th>
                            <th scope="col">Type de Sortie</th>
                            <th scope="col">Unité</th>
                            <th scope="col"><center>Actions</center></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var react in reactifs)
                        {
                            <tr>
                                <td>@react.Designation</td>
                                <td>
                                    @{
                                        var typeSortie = allTypeSorties.FirstOrDefault(ts => ts.IdTypeSortie == react.IdTypeSortie);
                                    }
                                    @((typeSortie != null) ? typeSortie.Designation : "N/A")
                                </td>
                                <td>
                                    @{
                                        var unite = allUnites.FirstOrDefault(u => u.IdUnite == react.IdUnite);
                                    }
                                    @((unite != null) ? unite.Designation : "N/A")
                                </td>
                                <td>
                                    <center>
                                        <MudButton Size="Size.Small"
                                                   @onclick="@(() => HandleUpdate(react.IdReactif))"
                                                   Variant="Variant.Filled"
                                                   StartIcon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Warning">
                                        </MudButton>
                                    </center>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadReactifs(currentPage - 1))">Précédent</a>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadReactifs(currentPage + 1))">Suivant</a>
                        </li>
                    </ul>
                </nav>

                <center>
                    <p>Page @apiResponse.ViewBag["position"] sur @apiResponse.ViewBag["nbrLinks"]</p>
                </center>
            }
            else
            {
                <p>Informations de pagination indisponibles.</p>
            }
        }
    </div>
</div>

@code {
    private List<ReactifDto> reactifs = new List<ReactifDto>();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 10;
    private string url = "http://localhost:5077/api/reactifs";

    private List<TypeSortieDto> allTypeSorties = new List<TypeSortieDto>();
    private List<UniteDto> allUnites = new List<UniteDto>();

    protected override async Task OnInitializedAsync()
    {
        await LoadReactifs(currentPage);
        await LoadAllTypeSorties();
        await LoadAllUnites();
    }

    private async Task LoadReactifs(int page)
    {
        currentPage = page;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{url}?position={currentPage}&pageSize={pageSize}", options);
            if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Data != null)
            {
                reactifs = JsonSerializer.Deserialize<List<ReactifDto>>(
                    apiResponse.Data.ToString(),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new List<ReactifDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des reactifs : {ex.Message}");
        }
    }

    private async Task LoadAllTypeSorties()
    {
        try
        {
            var apiResponseTypeSorties = await Http.GetFromJsonAsync<ApiResponse>("http://localhost:5077/api/typesSortie");
            if (apiResponseTypeSorties != null && apiResponseTypeSorties.IsSuccess && apiResponseTypeSorties.Data != null)
            {
                var jsonData = apiResponseTypeSorties.Data.ToString();
                allTypeSorties = JsonSerializer.Deserialize<List<TypeSortieDto>>(jsonData, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    }) ?? new List<TypeSortieDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des types de sortie : {ex.Message}");
        }
    }

    private async Task LoadAllUnites()
    {
        try
        {
            var apiResponseUnites = await Http.GetFromJsonAsync<ApiResponse>("http://localhost:5077/api/unites");
            if (apiResponseUnites != null && apiResponseUnites.IsSuccess && apiResponseUnites.Data != null)
            {
                var jsonData = apiResponseUnites.Data.ToString();
                allUnites = JsonSerializer.Deserialize<List<UniteDto>>(jsonData, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    }) ?? new List<UniteDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des unités : {ex.Message}");
        }
    }

    private async Task HandleReactifCreated()
    {
        await LoadReactifs(currentPage);
    }

    private void HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/reactif/edit/{id}");
    }
}