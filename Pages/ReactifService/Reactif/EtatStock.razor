@page "/etat/stock/global"

@using System.Net.Http.Json
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using LimsUtils.Utility
@using System.Text.Json
@using System.Globalization;
@inject NavigationManager NavigationManager
@inject HttpClient Http

<style>
    .chiffre{
        text-align: right;
    }
    .low-quantity {
        background-color: rgba(255, 0, 0, 0.1); /* light red */
    }

    .ok-quantity {
        background-color: rgba(0, 255, 0, 0.1); /* light green */
    }
</style>

<center><h2>Etat de stock des réactifs</h2></center>
<hr />
<br />


<MudTable Items="@Elements" Dense="@dense" Hover="@hover" Bordered="@bordered" Striped="@striped" Filter="new Func<ResteStockDto,bool>(FilterFunc1)" @bind-SelectedItem="selectedItem1">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Etat de stock</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Reactif</MudTh>
        <MudTh>Dernière date de report</MudTh>
        <MudTh>Quantité restante</MudTh>
        <MudTh>Unité</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd Class="@ChangeColor(context.Quantite)"  DataLabel="Reactif">@context.Designation</MudTd>
        <MudTd DataLabel="Dernière date de report">@ViewUtils.RenderDateAsFrenchFormat(context.DateLastreport)</MudTd>
        <MudTd Class="chiffre"  DataLabel="Quantite restant">@context.Quantite</MudTd>
        <MudTd DataLabel="Unite">@context.Unite</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

<div class="d-flex flex-wrap mt-4">
    <MudSwitch @bind-Value="hover" Color="Color.Primary">Hover</MudSwitch>
    <MudSwitch @bind-Value="bordered" Color="Color.Warning">Bordures</MudSwitch>
    <MudSpacer />
    <div style="min-width:200px;">
        <MudText Class="align-self-center d-inline">Selectione: @selectedItem1?.Designation</MudText>
    </div>
</div>

@code {
    private bool dense = false;
    private bool hover = true;
    private bool striped = false;
    private bool bordered = true;
    private string searchString1 = "";
    private ResteStockDto selectedItem1 = null;
    private HashSet<ResteStockDto> selectedItems = new HashSet<ResteStockDto>();

    private IEnumerable<ResteStockDto> Elements = new List<ResteStockDto>();
    protected string exception = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEtatDeStock();
    }

    protected async Task LoadEtatDeStock()
    {
        DateTime date = DateTime.Now;
        ApiResponse? apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"reactifs/reste-stock-global?date={date}");
        
        if(apiResponse?.IsSuccess == true || apiResponse != null)
        {
            apiResponse.HandleResponse<IEnumerable<ResteStockDto>>();
            if(apiResponse.Data == null)
            {
                exception = "Il n'y a pas de données dans la base";
            }
            else
            {
                Elements = (IEnumerable<ResteStockDto>)apiResponse.Data;
            }
        }
        else{
            exception = apiResponse?.Message ?? "Une erreur s'est produite lors de la récupération des données.";
        }
        StateHasChanged();
    }

    private bool FilterFunc1(ResteStockDto element) => FilterFunc(element, searchString1);

    private bool FilterFunc(ResteStockDto element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.Designation.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private string ChangeColor(double quantite)
    {
        if (quantite < 10)
        {
            return "low-quantity";
        }
        else
        {
            return "ok-quantity";
        }
    }
}