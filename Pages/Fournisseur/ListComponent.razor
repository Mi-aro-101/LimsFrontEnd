@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Immobilisation
@using LimsUtils.Api
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks

<div class="row">
    <!-- Colonne de création -->
    <div class="col">
        <Create OnFournisseurCreated="HandleFournisseurCreated" />
    </div>

    <!-- Colonne de la liste -->
    <div class="col">
        @if (fournisseurs == null || fournisseurs.Count == 0)
        {
            <p><em>Aucun fournisseur disponible</em></p>
        }
        else
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Désignation</th>
                        <th scope="col"><center>Actions</center></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fournisseur in fournisseurs.OrderBy(f => f.IdFournisseur))
                    {
                        <tr>
                            <td>@fournisseur.IdFournisseur</td>
                            <td>@fournisseur.Designation</td>
                            <td>
                                <center>
                                    @* <button class="btn btn-warning btn-sm" @onclick="@(() => HandleUpdate(fournisseur.IdFournisseur))"> *@
                                    @*     <i class="fa fa-pencil"></i> *@
                                    @* </button> *@
                                    <MudButton Size="Size.Small"
                                               @onclick="@(() => HandleUpdate(fournisseur.IdFournisseur))"
                                               Variant="Variant.Filled"
                                               StartIcon="@Icons.Material.Filled.Edit"
                                               Color="Color.Warning">
                                    </MudButton>
                                </center>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<FournisseurDto> fournisseurs = new List<FournisseurDto>();
    private string url = "http://localhost:5077/api/fournisseurs";

    protected override async Task OnInitializedAsync()
    {
        await LoadFournisseurs();
    }

    private async Task LoadFournisseurs()
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url, options);
            if (apiResponse != null && apiResponse.IsSuccess && apiResponse.Data != null)
            {
                fournisseurs = JsonSerializer.Deserialize<List<FournisseurDto>>(
                    apiResponse.Data.ToString(),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new List<FournisseurDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des fournisseurs : {ex.Message}");
        }
    }

    private async Task HandleFournisseurCreated()
    {
        await LoadFournisseurs();
    }

    private void HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/fournisseur/edit/{id}");
    }
}