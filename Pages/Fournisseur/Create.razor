@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Immobilisation
@using LimsUtils.Api

<div class="card border-dark mb-3" style="max-width: 39rem;">
  <div class="card-header">Créer un Fournisseur</div>
  <div class="card-body text-dark">
    <EditForm Model="@fournisseur" OnValidSubmit="@HandleOnSubmit">
      <DataAnnotationsValidator />
      <div class="form-group row">
          <label class="col-sm-3 col-form-label">Désignation</label>
          <div class="col-sm-9">
              <InputText class="form-control" @bind-Value="fournisseur.Designation" placeholder="Désignation" />
          </div>
      </div>
      <br />
      <center>
          <button type="submit" class="btn btn-primary">Créer</button>
      </center>
    </EditForm>
  </div>
</div>

@code {
    private FournisseurDto fournisseur = new();
    private string url = "http://localhost:5077/api/fournisseurs";

    [Parameter]
    public EventCallback OnFournisseurCreated { get; set; }

    private async Task HandleOnSubmit()
    {
        try
        {
            var response = await Http.PostAsJsonAsync(url, fournisseur);
            response.EnsureSuccessStatusCode();
            if (OnFournisseurCreated.HasDelegate)
                await OnFournisseurCreated.InvokeAsync();
            else
                Console.WriteLine("Aucun delegate assigné à l'événement OnFournisseurCreated");
            // Réinitialiser le formulaire en recréant l'objet
            fournisseur = new FournisseurDto();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception : " + ex.Message);
        }
    }
}