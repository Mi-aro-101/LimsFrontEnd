@page "/login"
@layout EmptyLayout;

@using LimsFrontEnd.Utils
@using LimsUtils.Api
@using System.Text.Json
@inject HttpClient Http
@inject ISessionStorageService SessionStorage
@inject NavigationManager Navigation
@using LimsFrontEnd.Models

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AutheStateProvider



<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css">
</head>

<body>
    <center><div class="card border-dark mb-3" style="max-width: 39rem;">
        <div class="card-header"><h2 class="text-center">Login</h2></div>
        <div class="card-body text-dark">
        <EditForm Model="@logindto" OnValidSubmit="@HandleOnSubmit">
            <div class="form-group row">
                <label for="staticEmail" class="col-sm-4 col-form-label">Identifiant</label>
                <div class="col-sm-6">
                <InputText class="form-control" type="password" @bind-Value="logindto.Identifiant" placeholder="Identifiant" />
                </div>
            </div>
            <br>
            <div class="form-group row">
                <label for="inputPassword" class="col-sm-4 col-form-label">Mot de passe</label>
                <div class="col-sm-6">
                <InputText class="form-control" @bind-Value="logindto.Password" placeholder="Mot de passe" />
                </div>
            </div>
            <br>
            <center>
                <button type="submit" class="btn btn-primary">Se connecter</button>
            </center>
        </EditForm>
        <p> @errorMessage </p>
        </div>
    </div> </center>

</body>
</html>

@code
{
    private LoginDto logindto = new LoginDto{
        Identifiant = "",
        Password = ""
    };
    private string url = "http://localhost:5077/api/auth/login";
    [Parameter]
    public EventCallback OnLoginCreated { get; set; }
    private string? errorMessage;
    private async Task HandleOnSubmit()
    {
        try
        {
            var response = await Http.PostAsJsonAsync(url, logindto);
           
             if (response.IsSuccessStatusCode)
            {
                // Extract the token from the response
                ApiResponse? tokenResponse = await response.Content.ReadFromJsonAsync<ApiResponse>();
                tokenResponse.HandleResponse<String>();

                if (tokenResponse != null)
                {
                    String token = (String)tokenResponse.Data;
                    // Store the token in SessionStorage
                    var customProvider = (AuthStateProvider)AutheStateProvider;
                    await customProvider.MarkUserAsAuthenticated(token);

                    // Redirect the user to the home page or any protected page
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                errorMessage = "Echec de connexion. Verifiez vos identifiants";
            }
        }
        catch(Exception ex)
        {
            errorMessage = $"Une erreur s'est produite : {ex.Message}";
        }
    }
}
