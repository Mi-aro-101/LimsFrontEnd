@using LimsFrontEnd.Components

@inherits CUUtilisateurBaseComponent

@using LimsFrontEnd.Models

@if(Roles == null || Utilisateur == null || Departements == null)
    {
        <center><div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Veuillez patienter un moment</p><br/></center>
    }
    else
    {
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Identifiant</label>
            <div class="col-sm-8">
            <InputText class="form-control"  @bind-Value="Utilisateur.Identifiant" placeholder="front1" />
            </div>
        </div>
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Mot de passe</label>
            <div class="col-sm-8">
            <InputText class="form-control" @bind-Value="Utilisateur.Password" placeholder="front1@1234" />
            </div>
        </div>
        <br>
        
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Departement</label>
            <div class="col-sm-8">
                 <InputSelect class="form-control" @bind-Value="Utilisateur.IdDepartement">
                <option value=""></option>"
                @foreach(DepartementDto departement in Departements)
                {
                    <option value=@departement.IdDepartement>@departement.Designation</option>
                }
            </InputSelect>
            </div>
        </div>
    }

@code
{
    [Parameter]
    public UtilisateurDto? Utilisateur {get; set;}
    [Parameter]
    public ICollection<RoleDto>? Roles {get; set; }
    [Parameter]    
    public ICollection<DepartementDto>? Departements {get;set;}
    [Parameter]
    public IEnumerable<RoleDto>? RolesUtilisateur {get;set;}

}