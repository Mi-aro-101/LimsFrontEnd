@page "/demandenotedebit/nonpaye"

@using LimsUtils.Api
@using System.Text.Json
@inject HttpClient http
@using LimsFrontEnd.Models
@inject NavigationManager navigationManager

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5" Class="mb-4">Demande de note de débit oublié</MudText>

    <MudTextField @bind-Value="searchText" Label="Recherche" Placeholder="Etat de décompte" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" />

    <MudTable Items="FilteredData" Dense="true" RowsPerPage="10" Hover="true" FixedHeader="true" Height="300px">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Note de débit</MudText>
        </ToolBarContent>

        <HeaderContent>
            <MudTh> N°</MudTh>
            <MudTh> Réference de l'état de décompte </MudTh>
            <MudTh> Date d'état de décompte </MudTh>
            <MudTh> Montant (Ar) </MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd> @context.reference </MudTd>
            <MudTd> @context.referenceEtatDecompte </MudTd>
            <MudTd> 
                @if (context.dateEtatDecompte is DateTime date)
                {
                    Console.WriteLine(date.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("fr-FR")));
                }
                else
                {
                    Console.WriteLine("La valeur n'est pas un DateTime ou est null");
                }
                @(context.dateEtatDecompte.HasValue ? context.dateEtatDecompte.Value.ToString("dd MMM yyyy") : "N/A") 
            </MudTd>
            <MudTd> @context.montant </MudTd>
            <MudTd>
                @if (demandeNote == context)
                {
                    <MudButton Color="Color.Success" OnClick="() => SaveRow(context.idEtatDecompte)">Faire la demande</MudButton>
                    <MudButton Color="Color.Error" OnClick="CancelEdit">Cancel</MudButton>
                }
                else
                {
                    <MudButton Color="Color.Primary" OnClick="@(() => EditRow(context))">Action</MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudPaper Class="pa-3 mt-4" Elevation="4">
        <MudText Typo="Typo.h6">Arrêté à la somme de : <b>@FilteredData.Sum(x => x.montant).ToString("F2") Ar</b></MudText>
    </MudPaper>
</MudPaper>

@code {
    private string searchText = "";

    private DemandeDto? demandeNote;
    private List<DemandeDto> demandeNotes = new List<DemandeDto>();
    private ApiResponse? apiResponse;
    //string url = "http://localhost:5077/api/notedebit";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var option = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await http.GetFromJsonAsync<ApiResponse>("notedebit/demandeoublie", option);
            apiResponse.HandleResponse<List<DemandeDto>>();
            demandeNotes = apiResponse.Data as List<DemandeDto> ?? new List<DemandeDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception: " + ex.Message);
        }
    }

    private List<DemandeDto> FilteredData
    {
        get
        {
            var result = demandeNotes
             .Where(x => string.IsNullOrWhiteSpace(searchText)
                      || x.referenceEtatDecompte.Contains(searchText, StringComparison.OrdinalIgnoreCase))
             .ToList();
            return result;
        }
    }

    private void EditRow(DemandeDto demande)
    {
        demandeNote = demande;
    }

    private async Task SaveRow(int id)
    {
        navigationManager.NavigateTo($"/demandenotedebit/{id}");
    }

    private void CancelEdit()
    {
        demandeNote = null; // Annuler l'édition
    }
}