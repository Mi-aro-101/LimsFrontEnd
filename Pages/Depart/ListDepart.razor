@page "/depart/liste"

@using LimsUtils.Api
@using System.Text.Json
@inject HttpClient http
@using LimsFrontEnd.Models

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h2" Class="mb-4">Liste des départs</MudText>
    
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="searchText" Label="Recherche" Placeholder="Objet ou département ou référence de départ" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudStack Row="true" Spacing="2">
                <MudTextField @bind-Value="selectedYear" 
                            Label="Année" 
                            Variant="Variant.Outlined" 
                            Class="mb-4" />
                <MudButton OnClick="ApplyYearFilter" 
                          Variant="Variant.Filled" 
                          Color="Color.Primary" 
                          Class="mt-4">
                    Filtrer
                </MudButton>
                <MudButton OnClick="ResetYearFilter" 
                          Variant="Variant.Outlined" 
                          Color="Color.Secondary" 
                          Class="mt-4">
                    Réinitialiser
                </MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>

    <MudTable Items="FilteredData" Dense="true" Hover="true" FixedHeader="true" Height="300px">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Départ vers les autres départements</MudText>
        </ToolBarContent>

        <HeaderContent>
            <MudTh> Référence de départ </MudTh>
            <MudTh> Objet </MudTh>
            <MudTh> Date de la demande </MudTh>
            <MudTh> Destinataire </MudTh>               
        </HeaderContent>

        <RowTemplate>
            <MudTd> @context.reference </MudTd>
            <MudTd> @context.objet </MudTd>
            <MudTd> @(context.DateDepart.HasValue ? context.DateDepart.Value.ToString("dd MMM yyyy") : "N/A") </MudTd> 
            <MudTd> @context.designationDestinataire </MudTd>                
        </RowTemplate>
    </MudTable>

</MudPaper>

@code {
    private string searchText = "";
    private string selectedYear = "";

    private List<DepartDto> departs = new List<DepartDto>();
    private ApiResponse? apiResponse;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task ApplyYearFilter()
    {
        await LoadData();
    }

    private async Task ResetYearFilter()
    {
        selectedYear = "";
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var option = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var url = !string.IsNullOrEmpty(selectedYear) && int.TryParse(selectedYear, out int year)
                ? $"depart/ListeDepart?annee={year}"
                : "depart/ListeDepart";
                
            apiResponse = await http.GetFromJsonAsync<ApiResponse>(url, option);
            apiResponse.HandleResponse<List<DepartDto>>();
            departs = apiResponse.Data as List<DepartDto> ?? new List<DepartDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception: " + ex.Message);
        }
    }

    private List<DepartDto> FilteredData
    {
        get
        {
            return departs
            .Where(x => string.IsNullOrWhiteSpace(searchText) ||
                    x.objet.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    x.reference.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) || 
                    x.designationDestinataire.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();
        }
    }    
}