@page "/depart"

@using LimsFrontEnd.Models
@inject HttpClient http
@inject NavigationManager navigationManager

<MudPaper Class="pa-4 mx-auto" Style="max-width: 500px;">
    <MudForm @ref="departForm" Model="departModel" @onsubmit="SubmitDepart">
        <MudText Typo="Typo.h6">Nouveau Départ</MudText>

        <MudTextField Label="Objet" @bind-Value="departModel.objet" Required="true" />

        <MudDatePicker Label="Date de départ" @bind-Date="departModel.DateDepart" Required="true" />

        <MudSelect T="int" Label="Destinataire" @bind-Value="departModel.idDestinataire" Required="true">
            @if (destinataires != null)
            {
                @foreach (var d in destinataires)
                {
                    <MudSelectItem Value="@(d.idDestinataire)">@d.designation</MudSelectItem>
                }
            }
        </MudSelect>

        <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Ajouter</MudButton>
    </MudForm>
</MudPaper>

@code {
    private MudForm? departForm;
    private DepartDto departModel = new();
    private List<DestinataireDto>? destinataires;

    private string url = "http://localhost:5077/api/depart";

    protected override async Task OnInitializedAsync()
    {
        // Récupérer les destinataires depuis l'API
        destinataires = await http.GetFromJsonAsync<List<DestinataireDto>>($"{url}/destinataireListe");
    }

    private async Task SubmitDepart()
    {
        await departForm.Validate();

        if (departForm.IsValid)
        {
            var response = await http.PostAsJsonAsync(url, departModel);

            if (response.IsSuccessStatusCode)
            {
                // Redirection ou message de succès
                navigationManager.NavigateTo("/depart", forceLoad: true);
            }
            else
            {
                // Gestion d'erreur (ex: doublon)
                Console.WriteLine("Erreur lors de l'insertion.");
            }
        }
    }
}
