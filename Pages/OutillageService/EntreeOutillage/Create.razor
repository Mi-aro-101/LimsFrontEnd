@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models.Outillage
@using LimsUtils.Api
@using System.Text.Json

<div class="d-flex justify-content-center">
    <div class="card border-dark mb-3" style="max-width: 60rem;">
        <div class="card-header">Créer une Entrée Outillage</div>
        <div class="card-body text-dark">
            <EditForm Model="@entreeOutillage" OnValidSubmit="@HandleOnSubmit" FormName="entreeOutillageForm">
                <DataAnnotationsValidator />
                <div class="row">
                    <!-- Colonne 1 : Quantité, Prix d'achat, BMPO -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Quantité</label>
                            <InputNumber class="form-control" @bind-Value="entreeOutillage.Quantite" />
                            @if (isQuantiteInvalid)
                            {
                                <div class="text-danger">La quantité doit être supérieure à zéro.</div>
                            }
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Prix d'achat</label>
                            <InputNumber class="form-control" @bind-Value="entreeOutillage.PrixAchat" />
                            @if (isPrixAchatInvalid)
                            {
                                <div class="text-danger">Le prix d'achat doit être supérieur à zéro.</div>
                            }
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Bordereau de mouvement comptable petit outillage</label>
                            <InputText class="form-control" @bind-Value="entreeOutillage.BonReception" placeholder="Référence du bordereau" />
                        </div>
                    </div>
                    <!-- Colonne 2 : Date d'Entrée, Outillage, Fournisseur -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Date d'Entrée</label>
                            <InputDate class="form-control" @bind-Value="entreeOutillage.DateEntree" disabled />
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Outillage</label>
                            <InputText class="form-control"
                                       Value="@searchTerm"
                                       ValueChanged="@((string val) => OnSearchChanged(val))"
                                       ValueExpression="@(() => searchTerm)"
                                       placeholder="Rechercher un outillage"
                                       @oninput="@(async (ChangeEventArgs e) => await OnSearchChanged(e.Value.ToString()))" />
                            @if (!string.IsNullOrEmpty(searchTerm))
                            {
                                <ul class="list-group">
                                    @if (filteredOutillages.Any())
                                    {
                                        @foreach (var outillage in filteredOutillages)
                                        {
                                            <li class="list-group-item" @onclick="() => SelectOutillage(outillage)">
                                                @outillage.Designation
                                            </li>
                                        }
                                    }
                                    <li class="list-group-item">
                                        <button type="button" class="btn btn-secondary" @onclick="() => ShowAddOutillageForm(searchTerm)">Ajouter</button>
                                    </li>
                                </ul>
                            }
                            @if (isOutillageSelectionInvalid)
                            {
                                <div class="text-danger">Veuillez sélectionner un outillage.</div>
                            }
                        </div>
                        <br />
                        <div class="form-group">
                            <label>Fournisseur</label>
                            <InputSelect class="form-control" @bind-Value="entreeOutillage.IdFournisseur">
                                <option value="">-- Sélectionner --</option>
                                @foreach (var fournisseur in fournisseurs)
                                {
                                    <option value="@fournisseur.IdFournisseur">@fournisseur.Designation</option>
                                }
                            </InputSelect>
                            @if (isFournisseurInvalid)
                            {
                                <div class="text-danger">Veuillez sélectionner un fournisseur.</div>
                            }
                        </div>
                    </div>
                </div>
                <br />
                <center>
                    <button type="submit" class="btn btn-primary">Créer</button>
                </center>
            </EditForm>
        </div>
    </div>
</div>

@if (showAddOutillageForm)
{
    <div class="modal show" tabindex="-1" style="display:block; background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Créer un Outillage</h5>
                    <button type="button" class="btn-close" @onclick="() => showAddOutillageForm = false"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@newOutillage" OnValidSubmit="@HandleAddOutillage">
                        <DataAnnotationsValidator />
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Désignation</label>
                            <div class="col-sm-9">
                                <InputText class="form-control" @bind-Value="newOutillage.Designation" placeholder="Désignation" />
                            </div>
                        </div>
                        <br />
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Marque</label>
                            <div class="col-sm-9">
                                <InputSelect class="form-control" @bind-Value="newOutillage.IdMarque">
                                    <option value="">-- Sélectionner --</option>
                                    @foreach (var marque in Marques)
                                    {
                                        <option value="@marque.IdMarque">@marque.Designation</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <br />
                        <center>
                            <button type="submit" class="btn btn-primary">Créer</button>
                            <button type="button" class="btn btn-secondary" @onclick="() => showAddOutillageForm = false">Annuler</button>
                        </center>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private EntreeOutillageDto entreeOutillage = new()
    {
        DateEntree = DateTime.Now,
        Quantite = 0,
        PrixAchat = 0m
    };
    private List<OutillageDto> outillages = new();
    private List<FournisseurDto> fournisseurs = new();
    private string searchTerm = string.Empty;
    private bool showAddOutillageForm = false;
    private OutillageDto newOutillage = new();
    private ICollection<MarqueDto> Marques = new List<MarqueDto>();

    private string entreeOutillageUrl = "http://localhost:5077/api/entree-outillages";
    private string outillageUrl = "http://localhost:5077/api/outillages";
    private string fournisseurUrl = "http://localhost:5077/api/fournisseur";
    private string marqueUrl = "http://localhost:5077/api/marque-outillage";

    [Parameter]
    public EventCallback OnEntreeOutillageCreated { get; set; }

    private bool isQuantiteInvalid = false;
    private bool isPrixAchatInvalid = false;
    private bool isFournisseurInvalid = false;
    private bool isOutillageSelectionInvalid = false;

    private List<OutillageDto> filteredOutillages => outillages
        .Where(o => !string.IsNullOrEmpty(o.Designation) &&
                    o.Designation.StartsWith(searchTerm ?? string.Empty, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        entreeOutillage.DateEntree = DateTime.Now;
        outillages = await LoadOutillages();
        fournisseurs = await LoadFournisseurs();
        Marques = await LoadMarques();
    }

    private async Task<List<OutillageDto>> LoadOutillages(string searchTerm = "")
    {
        try
        {
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{outillageUrl}/search?searchTerm={searchTerm}");
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                var jsonData = JsonSerializer.Serialize(apiResponse.Data);
                return JsonSerializer.Deserialize<List<OutillageDto>>(jsonData,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                    ?? new List<OutillageDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des outillages : {ex.Message}");
        }
        return new List<OutillageDto>();
    }

    private async Task<List<FournisseurDto>> LoadFournisseurs()
    {
        try
        {
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>(fournisseurUrl);
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                var jsonData = JsonSerializer.Serialize(apiResponse.Data);
                return JsonSerializer.Deserialize<List<FournisseurDto>>(jsonData,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                    ?? new List<FournisseurDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des fournisseurs : {ex.Message}");
        }
        return new List<FournisseurDto>();
    }

    private async Task<ICollection<MarqueDto>> LoadMarques()
    {
        try
        {
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>(marqueUrl);
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                var jsonData = JsonSerializer.Serialize(apiResponse.Data);
                return JsonSerializer.Deserialize<ICollection<MarqueDto>>(jsonData,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
                    ?? new List<MarqueDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des marques : {ex.Message}");
        }
        return new List<MarqueDto>();
    }

    private void SelectOutillage(OutillageDto outillage)
    {
        entreeOutillage.IdOutillage = outillage.IdOutillage;
        searchTerm = outillage.Designation;
    }

    private void ShowAddOutillageForm(string outillageName)
    {
        newOutillage = new OutillageDto { Designation = outillageName };
        showAddOutillageForm = true;
    }

    private async Task HandleAddOutillage()
    {
        try
        {
            var response = await Http.PostAsJsonAsync(outillageUrl, newOutillage);
            response.EnsureSuccessStatusCode();
            outillages = await LoadOutillages(searchTerm);
            entreeOutillage.IdOutillage = outillages.FirstOrDefault(o => o.Designation == newOutillage.Designation)?.IdOutillage ?? 0;
            showAddOutillageForm = false;
            newOutillage = new OutillageDto();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la création de l'outillage : {ex.Message}");
        }
    }

    private async Task HandleOnSubmit()
{
    ResetValidationFlags();

    isQuantiteInvalid = entreeOutillage.Quantite <= 0;
    isPrixAchatInvalid = entreeOutillage.PrixAchat <= 0;
    isFournisseurInvalid = entreeOutillage.IdFournisseur == 0;
    isOutillageSelectionInvalid = entreeOutillage.IdOutillage == 0;

    if (!isQuantiteInvalid && !isPrixAchatInvalid && !isFournisseurInvalid && !isOutillageSelectionInvalid)
    {
        if (string.IsNullOrWhiteSpace(entreeOutillage.BonReception))
        {
            entreeOutillage.BonReception = "Aucun BMPO";
        }

        string outillageDesignation = outillages.FirstOrDefault(o => o.IdOutillage == entreeOutillage.IdOutillage)?.Designation ?? "Non sélectionné";
        string quantite = entreeOutillage.Quantite.ToString();
        string prixAchat = entreeOutillage.PrixAchat.ToString();
        string bonReception = entreeOutillage.BonReception;
        string fournisseurDesignation = fournisseurs.FirstOrDefault(f => f.IdFournisseur == entreeOutillage.IdFournisseur)?.Designation ?? "Non sélectionné";

        string message = $"Veuillez vérifier les informations suivantes avant de créer l'entrée d'outillage :\n\n" +
                         $"Outillage : {outillageDesignation}\n" +
                         $"Quantité : {quantite}\n" +
                         $"Prix d'achat : {prixAchat}\n" +
                         $"Bon de réception : {bonReception}\n" +
                         $"Fournisseur : {fournisseurDesignation}\n\n" +
                         "Êtes-vous vraiment sûr de la véracité de ces informations ? Une fois créée, l'entrée ne pourra plus être modifiée ou supprimée.";

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", message);
        if (!confirmed)
        {
            return;
        }

        try
        {
            entreeOutillage.DateEntree = DateTime.Now; // Assurer que l’heure est incluse
            var response = await Http.PostAsJsonAsync(entreeOutillageUrl, entreeOutillage);
            response.EnsureSuccessStatusCode();
            if (OnEntreeOutillageCreated.HasDelegate)
                await OnEntreeOutillageCreated.InvokeAsync();
            entreeOutillage = new EntreeOutillageDto() { DateEntree = DateTime.Now }; // Changé ici
            searchTerm = string.Empty;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la création de l'entrée d'outillage : {ex.Message}");
        }
    }
    else
    {
        StateHasChanged();
    }
}

    private void ResetValidationFlags()
    {
        isQuantiteInvalid = false;
        isPrixAchatInvalid = false;
        isFournisseurInvalid = false;
        isOutillageSelectionInvalid = false;
    }

    private async Task OnSearchChanged(string val)
    {
        searchTerm = val;
        outillages = await LoadOutillages(searchTerm);
        StateHasChanged();
    }
}