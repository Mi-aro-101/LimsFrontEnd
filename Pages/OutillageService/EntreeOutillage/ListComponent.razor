@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using System.Text.Json
@using LimsFrontEnd.Models.Outillage
@using LimsUtils.Api
@using System.Linq

<div class="container">
    <Create OnEntreeOutillageCreated="HandleEntreeOutillageCreated" />

    <div class="mt-4">
        @if (entreeOutillages == null || entreeOutillages.Count == 0)
        {
            <p><em>Aucune entrée outillage disponible</em></p>
        }
        else
        {
            if (apiResponse != null && apiResponse.ViewBag != null &&
                apiResponse.ViewBag.ContainsKey("position") &&
                apiResponse.ViewBag.ContainsKey("nbrPerPage") &&
                apiResponse.ViewBag.ContainsKey("nbrLinks"))
            {
                var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
                var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">Outillage</th>
                            <th scope="col">Quantité</th>
                            <th scope="col">Prix d'achat</th>
                            <th scope="col">BMPO</th>
                            <th scope="col">Date d'Entrée</th>
                            <th scope="col">Fournisseur</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entree in entreeOutillages)
                        {
                            <tr>
                                <td>@(entree.Outillage != null ? entree.Outillage.Designation : "N/A")</td>
                                <td>@entree.Quantite</td>
                                <td>@entree.PrixAchat</td>
                                <td>@entree.BonReception</td>
                                <td>@entree.DateEntree.ToShortDateString()</td>
                                <td>@(entree.Fournisseur != null ? entree.Fournisseur.Designation : "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadEntreeOutillages(currentPage - 1))">Précédent</a>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="#" @onclick:preventDefault="true" @onclick="@(() => LoadEntreeOutillages(currentPage + 1))">Suivant</a>
                        </li>
                    </ul>
                </nav>

                <center>
                    <p>Page @apiResponse.ViewBag["position"] sur @apiResponse.ViewBag["nbrLinks"]</p>
                </center>
            }
            else
            {
                <p>Informations de pagination indisponibles.</p>
            }
        }
    </div>
</div>

@code {
    private List<EntreeOutillageDto> entreeOutillages = new();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 5;
    private string entreeOutillageUrl = "http://localhost:5077/api/entree-outillages";

    protected override async Task OnInitializedAsync()
    {
        await LoadEntreeOutillages(currentPage);
    }

    private async Task LoadEntreeOutillages(int page)
    {
        currentPage = page;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{entreeOutillageUrl}?position={currentPage}&pageSize={pageSize}", options);
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                entreeOutillages = JsonSerializer.Deserialize<List<EntreeOutillageDto>>(
                    apiResponse.Data.ToString(),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new List<EntreeOutillageDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des entrées outillage : {ex.Message}");
        }
        StateHasChanged();
    }

    private async Task HandleEntreeOutillageCreated()
    {
        await LoadEntreeOutillages(currentPage);
    }
}