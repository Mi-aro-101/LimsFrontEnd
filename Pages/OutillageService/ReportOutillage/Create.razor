@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models.Outillage
@using LimsUtils.Api
@using System.Text.Json
@using System.Linq

<div class="card border-dark mb-3">
    <div class="card-header">Ajouter un inventaire d'Outillage</div>
    <div class="card-body text-dark">
        <EditForm Model="@reportOutillage" OnValidSubmit="@HandleOnSubmit" FormName="reportOutillageForm">
            <DataAnnotationsValidator />
            <div class="form-group">
                <label>Date d'inventaire</label>
                <InputDate class="form-control" @bind-Value="reportOutillage.DateReport" disabled />
            </div>
            <div class="form-group">
                <label>Quantité</label>
                <InputNumber class="form-control" @bind-Value="reportOutillage.Quantite" />
                @if (isQuantiteInvalid)
                {
                    <div class="text-danger">La quantité doit être supérieure à zéro.</div>
                }
            </div>
            <div class="form-group">
                <label>Outillage</label>
                <div class="position-relative">
                    <InputText class="form-control" @bind-Value="searchTerm" @oninput="HandleSearch" placeholder="Rechercher un outillage..." />
                    @if (suggestions.Any())
                    {
                        <ul class="list-group position-absolute" style="z-index: 1000; width: 100%; max-height: 200px; overflow-y: auto;">
                            @foreach (var suggestion in suggestions)
                            {
                                <li class="list-group-item list-group-item-action" @onclick="() => SelectSuggestion(suggestion)">
                                    @suggestion.Designation
                                </li>
                            }
                        </ul>
                    }
                </div>
                @if (isOutillageSelectionInvalid)
                {
                    <div class="text-danger">Veuillez sélectionner un outillage.</div>
                }
            </div>
            <br />
            <button type="submit" class="btn btn-primary">Créer</button>
        </EditForm>
    </div>
</div>

@code {
    private ReportOutillageDto reportOutillage = new() { DateReport = DateTime.Today };
    private string searchTerm = string.Empty;
    private List<OutillageDto> suggestions = new();
    private bool isQuantiteInvalid = false;
    private bool isOutillageSelectionInvalid = false;

    private string reportOutillageUrl = "http://localhost:5077/api/report-outillages";
    private string outillageSearchUrl = "http://localhost:5077/api/outillages/search";

    [Parameter]
    public EventCallback OnReportOutillageCreated { get; set; }

    private async Task HandleSearch(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            suggestions.Clear();
            StateHasChanged();
            return;
        }

        try
        {
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"{outillageSearchUrl}?searchTerm={Uri.EscapeDataString(searchTerm)}");
            if (apiResponse is { IsSuccess: true, Data: not null })
            {
                var allResults = JsonSerializer.Deserialize<List<OutillageDto>>(
                    apiResponse.Data.ToString(),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new List<OutillageDto>();

                suggestions = allResults
                    .Where(o => o.Designation.StartsWith(searchTerm, StringComparison.OrdinalIgnoreCase))
                    .OrderBy(o => o.Designation)
                    .ToList();
            }
            else
            {
                suggestions.Clear();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la recherche des outillages : {ex.Message}");
            suggestions.Clear();
        }
        StateHasChanged();
    }

    private void SelectSuggestion(OutillageDto suggestion)
    {
        reportOutillage.IdOutillage = suggestion.IdOutillage;
        searchTerm = suggestion.Designation;
        suggestions.Clear();
        StateHasChanged();
    }

    private async Task HandleOnSubmit()
    {
        isQuantiteInvalid = reportOutillage.Quantite <= 0;
        isOutillageSelectionInvalid = reportOutillage.IdOutillage == 0;

        if (isQuantiteInvalid || isOutillageSelectionInvalid)
        {
            StateHasChanged();
            return;
        }

        string outillageDesignation = suggestions.FirstOrDefault(o => o.IdOutillage == reportOutillage.IdOutillage)?.Designation ?? searchTerm;
        string message = $"Veuillez vérifier les informations suivantes avant de créer le report d'outillage :\n\n" +
                         $"Date du Report : {reportOutillage.DateReport.ToShortDateString()}\n" +
                         $"Quantité : {reportOutillage.Quantite}\n" +
                         $"Outillage : {outillageDesignation}\n\n" +
                         "Êtes-vous sûr de ces informations ? Une fois créé, le report ne pourra plus être modifié ou supprimé.";

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", message);
        if (!confirmed)
        {
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync(reportOutillageUrl, reportOutillage);
            response.EnsureSuccessStatusCode();
            if (OnReportOutillageCreated.HasDelegate)
                await OnReportOutillageCreated.InvokeAsync();
            reportOutillage = new ReportOutillageDto() { DateReport = DateTime.Today };
            searchTerm = string.Empty;
            suggestions.Clear();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la création du report : {ex.Message}");
        }
    }
}