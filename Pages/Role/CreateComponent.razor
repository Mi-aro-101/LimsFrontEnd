@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsFrontEnd.Utils
@using System.Text.Json;
@inject NavigationManager NavigationManager

<div class="card border-dark mb-3" style="max-width: 39rem;">
  <div class="card-header">Creer un role</div>
  <div class="card-body text-dark">
    <EditForm Model="@role" OnValidSubmit="@HandleOnSubmit">
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Designation</label>
            <div class="col-sm-8">
            <InputText class="form-control" @bind-Value="role.Designation" placeholder="Traitement" />
            </div>
        </div>
        <br>
        <center>
            <button type="submit" class="btn btn-primary">Creer</button>
        </center>
    </EditForm>
  </div>
</div>

@code
{
    private RoleDto role = new();
    private string url = "http://localhost:5077/api/role";
    [Parameter]
    public EventCallback OnRoleCreated { get; set; }
    private async Task HandleOnSubmit()
    {
        try
        {
            var response = await Http.PostAsJsonAsync(url, role);
            response.EnsureSuccessStatusCode(); // Throw if not successful
            // Optionally handle the response (e.g., show a success message)
            if(OnRoleCreated.HasDelegate)
                await OnRoleCreated.InvokeAsync();

            else
                Console.WriteLine("No delegate for the event");
        }
        catch(Exception ex)
        {
            Console.WriteLine("Exception : " +ex.Message);
        }
    }
}

