@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsFrontEnd.Utils
@using System.Text.Json;
@inject NavigationManager NavigationManager
@using Microsoft.JSInterop;

<style>
    .bordered-cell-one{
        border-right: none;
        text-align: center;
    }
    .bordered-cell-two{
        border-left: none;
        text-align: center;
    }
</style>
<div class="col">
    <CreateComponent OnRoleCreated="@HandleRoleCreated" />
</div>

<div class="col">
    @if (roles == null)
    {
        <p><em>No data on the row</em></p>
    }
    else
    {
        @if (apiResponse.ViewBag.ContainsKey("position") && apiResponse.ViewBag.ContainsKey("TotalCount") && apiResponse.ViewBag.ContainsKey("nbrPerPage"))
        {

            var currentPage = int.Parse(apiResponse.ViewBag["position"].ToString());
            var pageSize = int.Parse(apiResponse.ViewBag["nbrPerPage"].ToString());
            var totalPages = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());

            <table class="table table-bordered" border="1">
                <thead>
                    <tr>
                        <th scope="col">Designation</th>
                        <th scope="col" colspan="2"><center>Actions</center></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in roles)
                    {
                        <tr>
                            <td>@role.Designation</td>
                            <td class="bordered-cell-one">
                                <MudButton Size="Size.Small" @onclick="@(() => HandleUpdate(@role.IdRole))" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" Color="Color.Warning"></MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <nav aria-label="Page navigation">
                <ul class="pagination">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="/role" @onclick="@(() => LoadRoles(currentPage - 1))">Précédent</a>
                    </li>

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="/role" @onclick="@(() => LoadRoles(currentPage + 1))">Suivant</a>
                    </li>
                </ul>
            </nav>

            <center><p>
                Page @apiResponse.ViewBag["position"] sur
                @apiResponse.ViewBag["nbrLinks"]
            </p></center>
        }
        else
        {
            <p>Information sur la pagination indisponible</p>
        }
    }
</div>

@code {
    private List<RoleDto>? roles = new List<RoleDto>();
    private ApiResponse? apiResponse;
    private int currentPage = 1;
    private int pageSize = 2;
    string url = "http://localhost:5077/api/role";
    [Inject] IJSRuntime JSRuntime { get; set; }

    private async Task HandleRoleCreated() // The callback handler
    {
        int pageLoaded = int.Parse(apiResponse.ViewBag["nbrLinks"].ToString());
        int elementNumberOnLastPage = roles.Count;
        if(elementNumberOnLastPage == pageSize)
            pageLoaded = pageLoaded + 1;
        await LoadRoles(pageLoaded);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRoles(currentPage);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error on Initializing : {ex.Message}");
        }
    }

    private async Task LoadRoles(int? activePage)
    {
        if(activePage.HasValue) currentPage = activePage.Value;
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+$"?position={currentPage}&pageSize={pageSize}", options);
            if(currentPage <= int.Parse(apiResponse.ViewBag["nbrLinks"].ToString())){
                apiResponse.HandleResponse<List<RoleDto>>();
                roles = (List<RoleDto>)apiResponse.Data;
            }
            else{
                await LoadRoles(int.Parse(apiResponse.ViewBag["nbrLinks"].ToString()));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while calling LoadDpt: {ex.Message}");
        }
    }
  

    private async Task HandleUpdate(int id)
    {
        NavigationManager.NavigateTo($"/role/{id}");
    }
}