@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json;
@inject NavigationManager NavigationManager

<div class="card border-dark mb-3" style="max-width: 39rem;">
  <div class="card-header">Créer un poste</div>
  <div class="card-body text-dark">
    <EditForm Model="@poste" OnValidSubmit="@HandleOnSubmit">
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Désignation</label>
            <div class="col-sm-8">
            <InputText class="form-control" @bind-Value="poste.Designation" placeholder="Traitement" />
            </div>
        </div>
        <br>
        <center>
            <button type="submit" class="btn btn-primary">Créer</button>
        </center>
    </EditForm>
  </div>
</div>

@code
{
    private PosteDto poste = new();
    private string url = "http://localhost:5077/api/poste";
    [Parameter]
    public EventCallback OnPosteCreated { get; set; }
    private async Task HandleOnSubmit()
    {
        try
        {
            var response = await Http.PostAsJsonAsync(url, poste);
            response.EnsureSuccessStatusCode(); // Throw if not successful
            // Optionally handle the response (e.g., show a success message)
            if(OnPosteCreated.HasDelegate)
                await OnPosteCreated.InvokeAsync();

            else
                Console.WriteLine("No delegate for the event");
        }
        catch(Exception ex)
        {
            Console.WriteLine("Exception : " +ex.Message);
        }
    }
}

