@using LimsFrontEnd.Components

@inherits CUBaseComponent

@using LimsFrontEnd.Models

<style>
    hr{
            width: 80%;
            margin: 0 auto;
        }
</style>
@if(Postes == null || Departements == null || Employe == null)
    {
        <center><div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Veuillez patienter un moment</p><br/></center>
    }
    else
    {


            <div class="form-group row">
                <label for="staticEmail" class="col-sm-2 col-form-label">Matricule</label>
                <div class="col-sm-8">
                <InputText class="form-control" @bind-Value="Employe.Matricule" placeholder="EMPXXXX" />
                </div>
            </div>

            <br>
            <hr />
            <br>


            <div class="row">
                <div class="col">
                    <label for="inputPassword">Nom</label>
                    <InputText class="form-control" @bind-Value="Employe.Nom" placeholder="" />
                </div>
                <div class="col">
                    <label for="inputPassword">Prénom</label>
                    <InputText class="form-control" @bind-Value="Employe.Prenom" placeholder="" />
                </div>
            </div>
            <br>
            <div class="row">
                <div class="col">
                    <label>Poste</label>
                    <InputSelect class="form-control" @bind-Value="Employe.IdPoste">
                        @foreach(PosteDto poste in Postes)
                        {
                            <option value=@poste.IdPoste>@poste.Designation</option>
                        }
                    </InputSelect>
                </div>
                <div class="col">
                    <label>Département</label>
                    <InputSelect class="form-control" @bind-Value="Employe.IdDepartement">
                        <option value="">--Sélectionner un département--</option>"
                        @foreach(DepartementDto departement in Departements)
                        {
                            <option value=@departement.IdDepartement>@departement.Designation</option>
                        }
                    </InputSelect>
                </div>
            </div>
            <br>
            <div class="row">
                <div class="col">
                    <label for="inputPassword">Contact</label>
                    <InputText class="form-control" @bind-Value="Employe.Contact" placeholder="03X0000000" />
                </div>
                <div class="col">
                    <label for="inputPassword">Adresse</label>
                    <InputText class="form-control" @bind-Value="Employe.Adresse" placeholder="Lot ..." />
                </div>
            </div>
            <br>
    }

@code
{
    [Parameter]
    public EmployeDto? Employe {get; set;}
    [Parameter]
    public ICollection<DepartementDto>? Departements {get; set; }
    [Parameter]
    public ICollection<PosteDto>? Postes {get; set; }
}