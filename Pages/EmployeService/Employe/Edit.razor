@page "/employe/{Id:int}"

@inherits CUComponent

@inject HttpClient Http
@using System.Net.Http.Json
@using System.Collections.Generic
@using System.Threading.Tasks
@using LimsFrontEnd.Models
@using LimsUtils.Api
@using System.Text.Json
@inject NavigationManager NavigationManager

<div class="card border-dark mb-3" style="max-width: 60rem;">
  <div class="card-header">Mettre à jour</div>
  <div class="card-body text-dark">
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-success">@message</div>
        }
    <EditForm Model="@employe" OnValidSubmit="@HandleOnSubmit">
        <CUComponent Employe="@employe" Departements="@departements" Postes="@postes" />
        @* Date quitter ancien poste *@
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Date Changement poste</label>
            <div class="col-sm-8">
            <InputDate class="form-control" @bind-Value="employe.DateFinPoste" />
            </div>
        </div>
        <br>
        <div class="form-group row">
            <label for="inputPassword" class="col-sm-2 col-form-label">Date Nouveau Poste</label>
            <div class="col-sm-8">
            <InputDate class="form-control" @bind-Value="employe.DateNouveauPoste" />
            </div>
        </div>
        <br>

        <center>
            <button type="submit" class="btn btn-warning">Mettre à jour</button>
        </center>
    </EditForm>
  </div>
</div>

@code
{
    private EmployeDto? employe = new EmployeDto();
    string message = "";
    [Parameter]
    public int Id { get; set; }
    ICollection<DepartementDto> departements = new List<DepartementDto>(); 
    ICollection<PosteDto> postes = new List<PosteDto>();
    
    protected async override Task OnInitializedAsync()
    {
        departements = await LoadDepartement();
        postes = await LoadPoste();
        await FetchDetails(Id);
    }

    private async Task FetchDetails(int id)
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            ApiResponse? apiResponse = await Http.GetFromJsonAsync<ApiResponse>(url+$"employe/{Id}", options);
            if(apiResponse?.Data != null){
                apiResponse.HandleResponse<EmployeDto>();
                employe = (EmployeDto)apiResponse.Data;
                Console.WriteLine(JsonSerializer.Serialize(employe));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while fetching details of the emp: {ex.Message}");
        }
    }
    private async Task HandleOnSubmit()
    {
        try
        {
            var response = await Http.PutAsJsonAsync(url+$"employe/{Id}", employe);
            // Optionally handle the response (e.g., show a success message)
            NavigationManager.NavigateTo("/employe"); // Redirect to product list
        }
        catch(Exception ex)
        {
            Console.WriteLine("Exception : " +ex.Message);
        }
    }
}