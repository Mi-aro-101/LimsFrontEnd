
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Net.Http.Json
@using System.Text.Json
@using LimsFrontEnd.Models.Immobilisation
@using LimsUtils.Api

<div class="card border-dark mb-3" style="max-width: 39rem;">
  <div class="card-header">Créer une Marque</div>
  <div class="card-body text-dark">
    <EditForm Model="@marque" OnValidSubmit="@HandleOnSubmit">
      <DataAnnotationsValidator />

      <div class="form-group row">
          <label class="col-sm-3 col-form-label">Désignation</label>
          <div class="col-sm-9">
              <InputText class="form-control" @bind-Value="marque.Designation" placeholder="Désignation" />
              @if (!string.IsNullOrEmpty(designationError))
              {
                  <div class="text-danger">@designationError</div>
              }
          </div>
      </div>
      <br />

      <center>
          <button type="submit" class="btn btn-primary">Créer</button>
      </center>
    </EditForm>
  </div>
</div>

@code {
    private MarqueDto marque = new();
    private string url = "http://localhost:5077/api/marque";

    private string? designationError;

    [Parameter]
    public EventCallback OnMarqueCreated { get; set; }

    private async Task HandleOnSubmit()
    {
        designationError = null;

        if (string.IsNullOrWhiteSpace(marque.Designation))
        {
            designationError = "Veuillez saisir une désignation.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync(url, marque);
            response.EnsureSuccessStatusCode();

            if (OnMarqueCreated.HasDelegate)
                await OnMarqueCreated.InvokeAsync();
            else
                Console.WriteLine("Aucun delegate assigné à l'événement OnMarqueCreated");

            marque = new MarqueDto(); // Réinitialiser le formulaire
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception : " + ex.Message);
        }
    }
}
