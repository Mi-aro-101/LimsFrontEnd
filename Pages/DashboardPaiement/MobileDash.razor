@using LimsUtils.Api
@using System.Text.Json
@inject HttpClient http
@using LimsFrontEnd.Models
@inject IJSRuntime JSRuntime
@* @inject NavigationManager navigationManager *@

<link href="css/mobile-dash.css" rel="stylesheet" />

@if(IsVisible)
{
     <div class="popup-overlay">
        <div class="popup-content" style="width: 90%; max-width: 1800px; min-height: 800px; padding: 2rem;">
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">
                Montants par opérateur mobile
            </MudText>

            <div class="mud-input mud-input-outlined mud-input-text" style="width: 90%; max-width: 1500px;">
                @* <label class="mud-input-label mud-input-label-outlined">Filtrer par semaine</label> *@
                <select class="mud-select-native" @bind="selectedSemaineIndex" @bind:event="oninput">
                    <option value="-1">Toutes les semaines</option>
                    @for (int i = 0; i < semainesDisponibles.Count; i++)
                    {
                        var s = semainesDisponibles[i];
                        <option value="@i">
                            @($"{s.debutSemaine?.ToString("dd MMM")} - {s.finSemaine?.ToString("dd MMM")}")
                        </option>
                    }
                </select>
            </div>

            <MudButton Variant="Variant.Filled" 
                      Color="Color.Info" 
                      OnClick="FiltrerParSemaine" 
                      StartIcon="@Icons.Material.Filled.FilterList"
                      Class="mt-2">
                Filtrer par semaine
            </MudButton>

            <MudContainer Class="mt-16 px-8" MaxWidth="MaxWidth.False">
                <MudGrid>  
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Elevation="2" Class="pa-4" Style="min-height: 100px; display: flex; flex-direction: column; justify-content: center;">
                            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">
                                Montant par Yas
                            </MudText>
                            <MudText Typo="Typo.h6" Align="Align.Center" Style="color: green;">
                                @montantYas.ToString("N0", new System.Globalization.CultureInfo("fr-FR")) Ariary
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Elevation="2" Class="pa-4 montant-mobile-card" Style="min-height: 100px; display: flex; flex-direction: column; justify-content: center;">
                            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">
                                Montant par Airtel
                            </MudText>
                            <MudText Typo="Typo.h6" Align="Align.Center" Style="color: red;">
                                @montantAirtel.ToString("N0", new System.Globalization.CultureInfo("fr-FR")) Ariary
                            </MudText>                           
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="12" md="4">
                        <MudPaper Elevation="2" Class="pa-4" Style="min-height: 100px; display: flex; flex-direction: column; justify-content: center;">
                            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">
                                Montant par Orange
                            </MudText>
                            <MudText Typo="Typo.h6" Align="Align.Center" Style="color: orange;">
                                @montantOrange.ToString("N0", new System.Globalization.CultureInfo("fr-FR")) Ariary
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudGrid Class="mt-4" GutterSize="3">
                        <!-- Graphique Linéaire -->
                        <MudItem xs="12" md="6">
                            <div id="LineChartMobile" style="height: 400px;"></div>
                        </MudItem>
                        <!-- Donut Chart -->
                        <MudItem xs="12" md="6">
                            <div id="PieChartMobile" style="height: 400px;"></div>
                        </MudItem>
                    </MudGrid>
                </MudGrid>              
            </MudContainer>

            <div style="position: absolute; bottom: 20px; right: 20px;">
                <MudButton Color="Color.Error" 
                          Variant="Variant.Filled" 
                          OnClick="Close" 
                          Size="Size.Large"
                          StartIcon="@Icons.Material.Filled.Close">
                    Fermer
                </MudButton>
            </div>
        </div>
    </div> 
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    // Valeurs à passer depuis le parent
    private decimal montantYas { get; set; }
    private decimal montantAirtel { get; set; }
    private decimal montantOrange { get; set; }

    private int nombreYas { get; set; }
    private int nombreAirtel { get; set; }
    private int nombreOrange { get; set; }

    private IJSObjectReference? jsModule;
    private ApiResponse? response;
    private List<SemaineDto> semainesDisponibles = new();

    private List<DetailMobileDto> details = new();
    private List<DetailMobileDto> detailsFiltrés = new();
    private bool chartsReady = false;

    @* private SemaineDto? selectedSemaine = null; *@
    private int selectedSemaineIndex = -1;
    private SemaineDto? selectedSemaine => selectedSemaineIndex >= 0 && selectedSemaineIndex < semainesDisponibles.Count 
        ? semainesDisponibles[selectedSemaineIndex] 
        : null;

    private string[] semaine = ["Lun", "Mar", "Mer", "Jeu", "Ven"];
    private double[] DonutSeries { get; set; } = Array.Empty<double>();

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible)
        {
            await ChargerDonnees();
            chartsReady = true;
            StateHasChanged(); // Forcer le re-render si nécessaire
        }
    }

    protected override async Task OnInitializedAsync()
    { 
       await OnParametersSetAsync();
    }

    private async Task ChargerDonnees()
    {       
        var option = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
        response = await http.GetFromJsonAsync<ApiResponse>("receptionpaiementmobile/operateurmobile", option);
        Console.WriteLine($"Réponse API reçue: {response?.IsSuccess}");

        if (response?.IsSuccess == true)
        {
            var data = JsonSerializer.Deserialize<DashboardDelaiMobileDto>(response.Data.ToString(), option);
            Console.WriteLine($"Données désérialisées: {data != null}");

            semainesDisponibles = data?.Semaines ?? new List<SemaineDto>();
            Console.WriteLine($"Nombre de semaines disponibles: {semainesDisponibles.Count}");
            
            foreach (var semaine in semainesDisponibles)
            {
                Console.WriteLine($"Semaine - Début: {semaine.debutSemaine}, Fin: {semaine.finSemaine}");
            }

            details = data?.Details ?? new List<DetailMobileDto>();
            Console.WriteLine($"Nombre de détails: {details.Count}");

            await FiltrerParSemaine();
        }
        else
        {
            Console.WriteLine($"Erreur API: {response?.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible && chartsReady)
        {
            await UpdateChart();
        }
    }

    private async Task UpdateChart()
    {   
        try 
        {
            var Yas = detailsFiltrés.Where(d => d.Operateur == "Yas").Select(d => d.MontantTotal).ToArray();
            var Airtel = detailsFiltrés.Where(d => d.Operateur == "Airtel").Select(d => d.MontantTotal).ToArray();
            var Orange = detailsFiltrés.Where(d => d.Operateur == "Orange").Select(d => d.MontantTotal).ToArray();

            jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/my-dashboard.js");
            await jsModule.InvokeVoidAsync("MobilePaiementSubdivisionLine", semaine, Yas, Airtel, Orange);

            DonutSeries = new double[]
            {
                nombreYas,
                nombreAirtel,
                nombreOrange
            };

            await jsModule.InvokeVoidAsync("MobilePaiementSubdivisionPie", DonutSeries);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la mise à jour des graphiques: {ex.Message}");
        }
    }

    public async Task FiltrerParSemaine()
    {
        if (selectedSemaine == null)
        {
            // par défaut, on affiche les 4 dernières semaines
            var dateLimite = DateTime.Today.AddDays(-28);

            detailsFiltrés = details
                .Where(d => d.Date >= dateLimite)
                .ToList();
            
            montantYas = (decimal)detailsFiltrés
                .Where(d => d.Operateur == "Yas")
                .Sum(d => (double)d.MontantTotal);

            montantAirtel = (decimal)detailsFiltrés
                .Where(d => d.Operateur == "Airtel")
                .Sum(d => (double)d.MontantTotal);

            montantOrange = (decimal)detailsFiltrés
                .Where(d => d.Operateur == "Orange")
                .Sum(d => (double)d.MontantTotal);

            nombreYas = detailsFiltrés.Count(d => d.Operateur == "Yas");
            nombreAirtel = detailsFiltrés.Count(d => d.Operateur == "Airtel");
            nombreOrange = detailsFiltrés.Count(d => d.Operateur == "Orange");
        }
        else 
        {
            detailsFiltrés = details
                .Where(d => d.Date >= selectedSemaine.debutSemaine && d.Date <= selectedSemaine.finSemaine)
                .ToList();
            
            montantYas = (decimal)detailsFiltrés
                .Where(d => d.Operateur == "Yas")
                .Sum(d => (double)d.MontantTotal);
            
            montantAirtel = (decimal)detailsFiltrés
                .Where(d => d.Operateur == "Airtel")
                .Sum(d => (double)d.MontantTotal);

            montantOrange = (decimal)detailsFiltrés
                .Where(d => d.Operateur == "Orange")
                .Sum(d => (double)d.MontantTotal);

            nombreYas = detailsFiltrés.Count(d => d.Operateur == "Yas");
            nombreAirtel = detailsFiltrés.Count(d => d.Operateur == "Airtel"); 
            nombreOrange = detailsFiltrés.Count(d => d.Operateur == "Orange");
        }

        await UpdateChart();
    }

    private async Task Close()
    {
        Console.WriteLine("Fermeture du dialog");
        IsVisible = false;
        await OnClose.InvokeAsync();
    }
}