@using LimsUtils.Api
@using System.Text.Json;
@inject HttpClient Http
@using LimsFrontEnd.Models
@using System.Net.Http.Json
@using System.Threading.Tasks
@using System.Collections.Generic
@inject NavigationManager NavigationManager

<MudCard Elevation="3" Class="p-4 rounded-xl">
    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-3">➕ Ajouter une banque</MudText>

    <MudForm Model="@banque" @ref="form">
        <MudStack Spacing="3">
            <MudTextField T="string" Label="Nom de l'entreprise" @bind-Value="banque.designation"
                          Placeholder="Nom de la banque" FullWidth="true" Required="true" />

            <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="SubmitForm" FullWidth="true">
                ✅ Ajouter
            </MudButton>
        </MudStack>
    </MudForm>
</MudCard>

@code {
    private MudForm form;
    private BanqueDto banque = new();
    
    [Parameter]
    public EventCallback OnBanqueCreated { get; set; }

    private async Task SubmitForm()
    {
        try
        {
            if (banque == null)
            {
                Console.WriteLine("banque est null");
                return;
            }

            var banques = new BanqueDto
            {
               designation = banque.designation    
            };

            var response = await Http.PostAsJsonAsync("banque/ajout", banques);

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine("Erreur de l'API: " + errorContent);
            }
            else
            {
                // Réinitialiser le formulaire après l'ajout
                banque = new BanqueDto();
                await form.ResetAsync();

                // 🔔 Invoquer le callback pour signaler la création
                await OnBanqueCreated.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception: " + ex.Message);
        }
    }
}