@page "/banque/{id_banque:int}"

@using LimsUtils.Api
@inject HttpClient Http
@using System.Text.Json
@using LimsFrontEnd.Models
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-6">
    <MudPaper Elevation="4" Class="p-6 rounded-2xl">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">
            📝 Modifier une banque
        </MudText>

        @if (!string.IsNullOrEmpty(exception))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@exception</MudAlert>
        }

        <MudForm Model="@banque" @ref="form">
            <MudStack Spacing="3">
                <MudTextField Label="Nom de la banque" @bind-Value="banque.designation" Required="true" FullWidth="true" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleOnSubmit" FullWidth="true">
                    💾 Mettre à jour
                </MudButton>
            </MudStack>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm form;
    private BanqueDto banque = new();
    //private string url = "http://localhost:5077/api/destinataire";
    private string? exception;
    [Parameter] public int id_banque { get; set; }

    protected override async Task OnInitializedAsync() => await FetchDetails(id_banque);

    private async Task FetchDetails(int id)
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"banque/{id_banque}", options);
            if (apiResponse?.Data != null)
            {
                apiResponse.HandleResponse<BanqueDto>();
                banque = (BanqueDto)apiResponse.Data;
            }
        }
        catch (Exception ex)
        {
            exception = $"Erreur : {ex.Message}";
        }
    }

    private async Task HandleOnSubmit()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"banque/{id_banque}", banque);
            NavigationManager.NavigateTo("/banque");
        }
        catch (Exception ex)
        {
            exception = ex.Message;
        }
    }
}