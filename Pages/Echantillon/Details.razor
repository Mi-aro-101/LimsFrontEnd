@page "/echantillon/details"

@using Component.Echantillon
@using LimsFrontEnd.Models
@using LimsUtils.Utility
@using System.Net.Http.Json
@using System.Text.Json

<style>
    .mud-table tr th {
        font-weight: bold;
    }
</style>

<h2>Details échantillon</h2>
<hr>

    <MudGrid>
            <MudItem xs="12" sm="6">
                <MudPaper Class="pa-4">
                    <ScannerComponent Echantillon="echantillon" Reload="OnEchantillonUpdate"/>
                        <hr>
                        <h4>Ou</h4>
                        <hr>
                    <ReferenceDetails Echantillon="echantillon" Reload="OnEchantillonUpdate"/>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Class="pa-4">
                    <MudText Align="Align.Center">Echantillon</MudText>
                    @if(echantillon != null)
                    {
                        <MudForm ReadOnly="true" Spacing="2">
                            <MudTextField T="string" Label="Reference" @bind-Value="echantillon.Reference"/>
                            <MudTextField T="string" Label="Type" Value="@((echantillon.TypeEchantillon?.Designation ?? string.Empty))"/>
                            <MudTextField T="string" Label="Date de prélèvement" Value="@ViewUtils.RenderDateAsFrenchFormat(echantillon.DatePrelevement)" />
                            <MudTextField T="string" Label="Provenance" @bind-Value="echantillon.Provenance" />
                            <MudTextField T="string" Label="Note" @bind-Value="echantillon.Note" />
                            <br>
                        </MudForm>
                        <table class="table table-bordered">
                            <thead>
                                <th>Travail</th>
                                <th>Progression</th>
                            </thead>
                            <tbody>
                                @foreach(var details in echantillon.DetailsEchantillons)
                                {
                                    <tr>
                                        <td>@details.Travaux</td>
                                        <td>@details.Avancee</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </MudPaper>
            </MudItem>
    </MudGrid>

@code
{    
    EchantillonDto echantillon = new();

    private void OnEchantillonUpdate()
    {
        StateHasChanged();
    }
}