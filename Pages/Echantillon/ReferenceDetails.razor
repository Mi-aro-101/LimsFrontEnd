@inject HttpClient Http

@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@using LimsFrontEnd.Models
@using LimsUtils.Utility
@using LimsUtils.Api
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components;


@namespace Component.Echantillon

<MudGrid>
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">
            <MudForm>
                <MudTextField T="string" Label="Référence" Required="true" @bind-Value="reference"/>
            </MudForm>   
        </MudPaper>
        <MudPaper Class="pa-4 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" OnClick="@(()=>Valider())">Valider</MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

@code
{
    [Parameter]
    public EchantillonDto Echantillon { get; set; } = new();
    [Parameter]
    public EventCallback Reload { get; set; }

    private string reference = string.Empty;

    private async Task Valider()
    {
        ApiResponse? apiResponse = await Http.GetFromJsonAsync<ApiResponse>($"echantillon/{reference}");
        if(apiResponse != null){
            apiResponse.HandleResponse<EchantillonDto>();
            foreach (var prop in typeof(EchantillonDto).GetProperties())
            {
                if (prop.CanWrite)
                {
                    prop.SetValue(Echantillon, prop.GetValue((EchantillonDto)apiResponse.Data));
                }
            }
            await Reload.InvokeAsync();
            Console.WriteLine(JsonSerializer.Serialize((EchantillonDto)apiResponse.Data));
            Console.WriteLine(JsonSerializer.Serialize(Echantillon));
        }
        reference = string.Empty;
    }

}